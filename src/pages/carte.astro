---
import Base from '../layouts/Base.astro';
---
<Base title="Fiche carte">
  <div id="view">
    <div class="status" role="status"><div class="spinner"></div>Chargement de la carte…</div>
  </div>

  <template id="tpl">
    <article class="card-page">
      <div class="visual" data-slot="visual"></div>
      <div class="info">
        <p class="muted small" data-slot="set"></p>
        <h1 data-slot="name"></h1>
        <div class="badges" data-slot="badges"></div>

        <div class="panel price">
          <p class="muted small">Cote estimée (Near Mint, version normale)</p>
          <p class="price-value" data-slot="price"></p>
          <p class="price-age" data-slot="price-age"></p>
          <p class="muted small" data-slot="price-detail"></p>
          <p class="notice" data-slot="price-note"></p>
        </div>

        <div class="panel srcs" data-slot="srcs" hidden>
          <h2>Sources de la cote</h2>
          <p class="muted small" data-slot="srcs-lead"></p>
          <table class="src-t">
            <thead><tr><th scope="col">Source</th><th scope="col">Via</th><th scope="col" class="num">Cote</th><th scope="col" class="num">En euros</th></tr></thead>
            <tbody data-slot="srcs-body"></tbody>
          </table>
          <p class="src-links" data-slot="srcs-links"></p>
        </div>

        <div class="panel hist" data-slot="hist" hidden>
          <div class="hist-head">
            <h2>Historique de la cote</h2>
            <div class="hist-range" role="group" aria-label="Période">
              <button type="button" data-days="30" aria-pressed="false">1 mois</button>
              <button type="button" data-days="90" aria-pressed="false">3 mois</button>
              <button type="button" data-days="365" aria-pressed="false">1 an</button>
              <button type="button" data-days="0" aria-pressed="true">Tout</button>
            </div>
          </div>
          <p class="hist-chg" data-slot="hist-chg"></p>
          <div class="hist-chart" data-slot="hist-chart"></div>
          <p class="hist-legend muted small"><span class="lg-real"></span> relevés HoloCote <span class="lg-ref"></span> repères Cardmarket (moyennes 30 et 7 jours)</p>
          <p class="muted small" data-slot="hist-note"></p>
        </div>

        <div class="panel add">
          <h2>Tu as cette carte ?</h2>
          <p class="muted">Pour l'ajouter à ta collection, scanne-la : seules les cartes que tu as vraiment en main entrent dans ta collection.</p>
          <a class="btn btn-primary" data-slot="scan-link">Scanner ma carte</a>
        </div>

        <dl class="facts" data-slot="facts"></dl>
      </div>
    </article>
  </template>

  <script>
    import { getCard, priceFor, hasReverse, formatPrice, formatDate, priceAgeText, type Card, type Lang } from '../lib/tcgdex';
    import { rarityTier, tierLabel, valueBadge, USD_TO_EUR } from '../lib/rarity';
    import { holoCard, el, status, url, favInfo } from '../lib/ui';
    import { favButton } from '../lib/favorites';
    import { seriesFor, recordPrice, timeChart, dayOf, dateOf, type Point } from '../lib/history';
    import { multiPrice, marketLinks } from '../lib/sources';

    const view = document.getElementById('view')!;
    const params = new URLSearchParams(location.search);
    const id = params.get('id') ?? '';
    const lang: Lang = params.get('lang') === 'en' ? 'en' : 'fr';

    async function main() {
      if (!/^[\w.\-!%?]+$/.test(id)) {
        view.replaceChildren(status('Carte introuvable.', false));
        return;
      }
      let card;
      try {
        card = await getCard(id, lang);
      } catch {
        view.replaceChildren(status('Impossible de joindre la base de cartes. Réessaie dans un instant.', false));
        return;
      }
      if (!card) {
        view.replaceChildren(status("Cette carte n'existe pas dans cette langue.", false));
        return;
      }

      document.title = `${card.name} · HoloCote`;
      document.querySelector('meta[name="description"]')?.setAttribute('content', `${card.name} (${card.set.name}) : rareté, cote estimée et versions de la carte Pokémon sur HoloCote.`);
      const node = (document.getElementById('tpl') as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment;
      const slot = (name: string) => node.querySelector(`[data-slot="${name}"]`) as HTMLElement;

      slot('visual').append(holoCard(card.image, card.name, 'high'));
      slot('name').textContent = card.name;
      slot('name').after(favButton(card.id, lang, () => favInfo(card), { label: true, className: 'fav-big' }));
      const official = card.set.cardCount?.official;
      slot('set').textContent = `${card.set.name} · N° ${card.localId}${official ? `/${official}` : ''}`;

      const tier = rarityTier(card.rarity);
      const price = priceFor(card, 'normal');
      const reverse = hasReverse(card) ? priceFor(card, 'reverse') : null;
      const eur = price ? (price.unit === 'EUR' ? price.value : price.value * USD_TO_EUR) : null;
      const vb = valueBadge(eur);
      slot('badges').append(
        el('span', { class: `badge tier-${tier}`, title: 'Rareté officielle' }, [card.rarity ?? tierLabel[tier]]),
        el('span', { class: `badge value-${vb.level}`, title: 'Badge HoloCote basé sur la cote' }, [vb.label]),
      );

      if (price) {
        slot('price').textContent = formatPrice(price.value, price.unit);
        slot('price-detail').textContent = [
          price.low ? `Prix le plus bas constaté : ${formatPrice(price.low, price.unit)}` : '',
          reverse ? `Version reverse holo : ${formatPrice(reverse.value, reverse.unit)}` : '',
        ].filter(Boolean).join(' · ');
        const date = formatDate(price.updated);
        const age = priceAgeText(price.updated);
        slot('price-age').textContent = `${date ? `Cote du ${date}` : 'Cote'} · ${age.text}${age.stale ? ' : elle peut avoir changé depuis' : ''}`;
        slot('price-age').classList.toggle('stale', age.stale);
        slot('price-note').textContent = `${price.unsure ? 'Cote incertaine : les ventes récentes de cette carte varient beaucoup, compare plusieurs annonces. ' : ''}Cote indicative, source ${price.source}${price.unit === 'USD' ? ' (marché américain, en dollars)' : ''}. Cardmarket regroupe toutes les langues et tous les états : une carte française ou abîmée se vend souvent moins cher.`;
      } else {
        slot('price').textContent = 'Cote indisponible';
        slot('price').classList.add('none');
        slot('price-note').textContent = "Aucune vente récente connue pour cette carte : HoloCote préfère ne rien afficher plutôt qu'un prix inventé. Essaie la version dans l'autre langue.";
      }

      const facts = slot('facts');
      const addFact = (k: string, v?: string | number) => {
        if (v === undefined || v === '') return;
        facts.append(el('dt', {}, [k]), el('dd', {}, [String(v)]));
      };
      addFact('Illustrateur', card.illustrator);
      addFact('Catégorie', card.category);
      addFact('PV', card.hp);
      addFact('Type', card.types?.join(', '));
      addFact('Langue', lang === 'fr' ? 'Français' : 'Anglais');
      const other = lang === 'fr' ? 'en' : 'fr';
      facts.append(
        el('dt', {}, ['Autre langue']),
        el('dd', {}, [el('a', { href: url(`/carte/?id=${encodeURIComponent(card.id)}&lang=${other}`) }, [other === 'en' ? 'Voir la version anglaise' : 'Voir la version française'])]),
      );

      (slot('scan-link') as HTMLAnchorElement).href = url('/scanner/');
      if (eur !== null && eur >= 50) {
        slot('price-note').after(el('p', { class: 'notice' }, ["Carte de valeur : avant de la vendre ou de l'échanger, parles-en à un adulte."]));
      }

      view.replaceChildren(node);
      if (price && price.unit === 'EUR') renderHistory(card, price.value);
      renderSources(card);
    }

    async function renderSources(card: Card) {
      const box = view.querySelector('[data-slot="srcs"]') as HTMLElement;
      const slot = (n: string) => box.querySelector(`[data-slot="${n}"]`) as HTMLElement;
      const mp = await multiPrice(card);
      const links = marketLinks(card.name);
      slot('srcs-links').replaceChildren('Vérifier soi-même : ', ...links.flatMap((l, i) => [i ? ' · ' : '', el('a', { href: l.href, target: '_blank', rel: 'noopener' }, [l.label])]));
      if (!mp.sources.length) {
        slot('srcs-lead').textContent = 'Aucune des sources consultées ne publie de prix pour cette carte.';
        slot('srcs-body').replaceChildren();
        box.hidden = false;
        return;
      }
      slot('srcs-body').replaceChildren(...mp.sources.map((sp) => el('tr', {}, [
        el('td', {}, [sp.url ? el('a', { href: sp.url, target: '_blank', rel: 'noopener' }, [sp.name]) : sp.name]),
        el('td', { class: 'muted' }, [sp.via]),
        el('td', { class: 'num' }, [formatPrice(sp.value, sp.unit)]),
        el('td', { class: 'num' }, [formatPrice(sp.eur, 'EUR')]),
      ])));
      const n = mp.sources.length;
      if (mp.consensus && n >= 2) {
        // La cote affichée devient la médiane des sources.
        const main = view.querySelector('[data-slot="price"]') as HTMLElement;
        main.textContent = formatPrice(mp.consensus, 'EUR');
        main.classList.remove('none');
        main.after(el('p', { class: 'multi-tag' }, [`Cote multi-sources : médiane de ${n} sources`]));
        slot('srcs-lead').textContent = `HoloCote recoupe ${n} sources indépendantes et retient la médiane, convertie en euros (1 $ = ${mp.fx.toFixed(2).replace('.', ',')} €). Cardmarket reflète le marché européen, TCGplayer le marché américain.${mp.spread && mp.spread > 1.6 ? ' Attention : les sources sont très éloignées les unes des autres, la cote est incertaine.' : ''}`;
      } else {
        slot('srcs-lead').textContent = 'Une seule source publie un prix pour cette carte : la cote est à prendre avec prudence.';
      }
      box.hidden = false;
    }

    async function renderHistory(card: Card, now: number) {
      recordPrice(`${lang}:${card.id}`, now);
      const box = view.querySelector('[data-slot="hist"]') as HTMLElement;
      const { points, published } = await seriesFor(card.id, lang);
      const today = dayOf();
      if (!points.some((p) => p.day === today)) points.push({ day: today, price: now });
      const cm = card.pricing?.cardmarket;
      const refs: Point[] = [];
      if (cm?.avg30) refs.push({ day: today - 15, price: cm.avg30, ref: 'Moyenne 30 jours Cardmarket' });
      if (cm?.avg7) refs.push({ day: today - 3, price: cm.avg7, ref: 'Moyenne 7 jours Cardmarket' });
      const fmt = (v: number) => formatPrice(v, 'EUR');
      const draw = (days: number) => {
        const from = days ? today - days : -Infinity;
        const pts = points.filter((p) => p.day >= from);
        const rf = refs.filter((p) => p.day >= from && (!pts.length || p.day < pts[0].day));
        (box.querySelector('[data-slot="hist-chart"]') as HTMLElement).replaceChildren(timeChart(pts, rf, fmt));
        const first = pts.length > 1 ? pts[0] : rf[0];
        const last = pts.at(-1);
        const chg = box.querySelector('[data-slot="hist-chg"]') as HTMLElement;
        if (first && last && first !== last) {
          const pc = ((last.price - first.price) / first.price) * 100;
          chg.textContent = `${pc >= 0 ? '+' : '−'}${Math.abs(pc).toFixed(1).replace('.', ',')} % depuis le ${dateOf(first.day).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', timeZone: 'UTC' })}`;
          chg.className = `hist-chg ${pc > 0.5 ? 'up' : pc < -0.5 ? 'down' : ''}`;
        } else chg.textContent = '';
        box.querySelectorAll<HTMLButtonElement>('.hist-range button').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.days) === days)));
      };
      box.querySelectorAll<HTMLButtonElement>('.hist-range button').forEach((b) => b.addEventListener('click', () => draw(Number(b.dataset.days))));
      const real = points.length;
      (box.querySelector('[data-slot="hist-note"]') as HTMLElement).textContent = published
        ? `HoloCote relève la cote de cette carte chaque matin depuis le ${dateOf(points[0].day).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}. Passe la souris sur un point pour voir sa valeur.`
        : real > 1
          ? `Relevés faits par ton navigateur à chacune de tes visites (${real} jours). Les cartes du Marché sont en plus relevées chaque matin par HoloCote.`
          : 'Cette carte n’est pas encore dans le relevé quotidien HoloCote : ton navigateur note sa cote à chacune de tes visites pour construire sa courbe. En attendant, les repères Cardmarket montrent la tendance du mois.';
      draw(0);
      box.hidden = false;
    }
    main();
  </script>

  <style>
    .card-page { display: grid; gap: 32px; grid-template-columns: 1fr; padding-top: 12px; }
    @media (min-width: 820px) { .card-page { grid-template-columns: minmax(280px, 400px) 1fr; align-items: start; } }
    .visual { max-width: 400px; width: 100%; margin: 0 auto; }
    @media (min-width: 820px) { .visual { position: sticky; top: 90px; } }
    .info { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
    .info h1 { margin: 0; }
    .info :global(.fav-big) { align-self: flex-start; height: 42px; padding: 0 16px; }
    .badges { display: flex; gap: 8px; flex-wrap: wrap; }
    .price p { margin: 0; }
    .price .notice { margin-top: 10px; }
    .price-value { font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; }
    .price-value:global(.none) { font-size: 1.5rem; color: var(--muted); }
    .price-age { font-size: 0.85rem; font-weight: 700; color: var(--up); }
    .price-age:global(.stale) { color: var(--gold); }
    .srcs h2 { margin: 0 0 4px; font-size: 1.15rem; }
    .srcs p { margin: 0 0 10px; }
    .src-t { width: 100%; border-collapse: collapse; font-size: 0.92rem; margin-bottom: 10px; }
    .src-t th { text-align: left; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); padding: 6px 4px; border-bottom: 1px solid var(--line); }
    .src-t td { padding: 8px 4px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .src-t .num { text-align: right; font-variant-numeric: tabular-nums; }
    .src-links { font-size: 0.85rem; }
    .info :global(.multi-tag) { margin: 2px 0 0; font-size: 0.8rem; font-weight: 800; color: #3ef0ff; }
    .hist-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    .hist-head h2 { margin: 0; font-size: 1.15rem; }
    .hist-range { display: flex; gap: 4px; padding: 3px; border-radius: 12px; background: var(--surface-2); }
    .hist-range button { border: 0; background: none; color: var(--muted); font: inherit; font-size: 0.82rem; font-weight: 700; padding: 6px 10px; border-radius: 9px; cursor: pointer; }
    .hist-range button[aria-pressed='true'] { background: var(--bg); color: var(--text); }
    .hist-chg { margin: 10px 0 4px; font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; }
    .hist-chg:global(.up) { color: var(--up); }
    .hist-chg:global(.down) { color: var(--down); }
    .hist-chart :global(svg) { width: 100%; height: auto; display: block; }
    .hist p { margin: 0; }
    .hist-legend { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 6px !important; }
    .lg-real, .lg-ref { display: inline-block; width: 18px; height: 0; border-top: 3px solid #3ef0ff; }
    .lg-ref { border-top: 2px dashed #8a7bff; margin-left: 8px; }
    .add { display: flex; flex-direction: column; gap: 14px; }
    .add h2 { margin: 0; }
    .add p { margin: 0; }
    .row { display: flex; gap: 12px; flex-wrap: wrap; }
    .row .field { flex: 1 1 220px; }
    .row .qty { flex: 0 1 120px; }
    .facts { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; margin: 0; font-size: 0.95rem; }
    .facts dt { color: var(--muted); }
    .facts dd { margin: 0; }
  </style>
</Base>
