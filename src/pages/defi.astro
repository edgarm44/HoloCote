---
import Base from '../layouts/Base.astro';
import { mascotSvg } from '../lib/mascot';
---
<Base title="Défi du jour" active="mystery" description="Chaque jour : une carte mystère à deviner, un booster à ouvrir et des duels de cotes. Gagne des cartes pour ton classeur.">
  <section class="mx-hero">
    <div class="hero-txt">
      <p class="mx-eyebrow"><span class="pulse" aria-hidden="true"></span><span id="mx-tag">Défi du jour</span></p>
      <h1>Défi <span class="holo-text">du jour.</span></h1>
      <p class="mx-slogan">Une carte mystère, un booster, des duels. Chaque jour, de quoi remplir ton classeur.</p>
    </div>
    <div class="hero-coti" id="hero-coti" set:html={mascotSvg('wink', 150)} />
  </section>

  <nav class="modes" id="modes" aria-label="Jeux du défi">
    <a href="#mystere" class="mode" data-mode="mystery" aria-current="page"><span class="m-name">Carte mystère</span><span class="m-st" id="st-mystery">à jouer</span></a>
    <a href="#booster" class="mode" data-mode="booster"><span class="m-name">Booster du jour</span><span class="m-st" id="st-booster">à ouvrir</span></a>
    <a href="#duel" class="mode" data-mode="duel"><span class="m-name">Duel du jour</span><span class="m-st" id="st-duel">à jouer</span></a>
    <a href="#entrainement" class="mode mode-train" data-mode="train"><span class="m-name">Entraînement</span><span class="m-st">illimité, sans gain</span></a>
  </nav>

  <div class="train-bar" id="train-bar" hidden>
    <span class="tb-txt"><strong>Entraînement</strong> · <span id="tb-game"></span> : joue autant que tu veux, rien n'est gagné ni compté.</span>
    <span class="tb-links"><a href="#entrainement">Changer de jeu</a><a href="#mystere" id="tb-back">Revenir au défi du jour</a></span>
  </div>

  <div class="mode-panel" id="mode-train" hidden>
    <section class="tr-hub">
      <h2>Entraînement</h2>
      <p class="muted">Choisis un jeu et entraîne-toi sans limite. En entraînement, on ne gagne aucune carte et rien ne compte dans tes stats du jour.</p>
      <div class="tr-grid">
        <a class="tr-choice" href="#entrainement-mystere"><span class="tr-coti" set:html={mascotSvg('think', 72)} /><strong>Carte mystère</strong><span class="muted small">Devine des cartes cachées, une nouvelle à chaque partie.</span></a>
        <a class="tr-choice" href="#entrainement-booster"><span class="tr-coti" set:html={mascotSvg('wow', 72)} /><strong>Booster</strong><span class="muted small">Ouvre autant de boosters que tu veux, de toutes les extensions.</span></a>
        <a class="tr-choice" href="#entrainement-duel"><span class="tr-coti" set:html={mascotSvg('happy', 72)} /><strong>Duel</strong><span class="muted small">Enchaîne les duels et bats ton record de bonnes réponses.</span></a>
      </div>
    </section>
  </div>

  <div class="mode-panel" id="mode-mystery">

  <div id="mx-state" aria-live="polite">
    <div class="status" role="status"><div class="spinner"></div>On mélange le paquet…</div>
  </div>

  <section class="arena" id="arena" hidden>
    <div class="stage-col">
      <div class="stage" id="stage">
        <div class="stage-inner">
          <div class="mx-card" id="mx-card">
            <img id="mx-img" alt="Carte à deviner" referrerpolicy="no-referrer" decoding="async" />
            <div class="mx-mask" id="mx-mask" aria-hidden="true"><span>? ? ?</span></div>
          </div>
          <div class="scanline" aria-hidden="true"></div>
        </div>
        <span class="stage-corner tl" aria-hidden="true"></span><span class="stage-corner tr" aria-hidden="true"></span>
        <span class="stage-corner bl" aria-hidden="true"></span><span class="stage-corner br" aria-hidden="true"></span>
      </div>
      <div class="pips" id="pips" aria-hidden="true"></div>
      <p class="tries" id="tries"></p>
    </div>

    <div class="console">

      <form class="guess" id="guess-form" autocomplete="off">
        <label for="guess" class="guess-label">Quel est ce Pokémon ?</label>
        <div class="guess-row">
          <div class="guess-field">
            <input id="guess" type="text" placeholder="Tape un nom : Dracaufeu, Évoli…" role="combobox" aria-expanded="false" aria-controls="guess-list" aria-autocomplete="list" spellcheck="false" />
            <ul class="guess-list" id="guess-list" role="listbox" hidden></ul>
          </div>
          <button class="btn btn-primary go" type="submit">Valider</button>
        </div>
        <button type="button" class="link-btn skip" id="skip">Je passe (indice suivant, coûte un essai)</button>
      </form>

      <ol class="guesses" id="guesses"></ol>

      <div class="clues" id="clues"></div>

      <section class="result" id="result" hidden>
        <div class="confetti" id="confetti" aria-hidden="true"></div>
        <p class="r-kicker" id="r-kicker"></p>
        <h2 class="r-title" id="r-title"></h2>
        <div class="r-body">
          <div class="r-card" id="r-card"></div>
          <div class="r-info">
            <p class="r-name" id="r-name"></p>
            <p class="muted small" id="r-set"></p>
            <p class="r-price" id="r-price"></p>
            <div class="r-actions">
              <button type="button" class="btn btn-primary" id="share">Partager mon résultat</button>
              <a class="btn" id="r-link" href="#">Voir la fiche</a>
              <span id="r-fav"></span>
            </div>
            <div class="claim" id="claim-box" hidden>
              <button type="button" class="btn claim-btn" id="claim">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="12" height="17" rx="2" /><path d="M10 8v6M7 11h6M19 6v13a2 2 0 0 1-2 2H9" /></svg>
                <span id="claim-lbl">Ajouter à mon classeur</span>
              </button>
              <p class="claim-note muted small" id="claim-note"></p>
            </div>
          </div>
        </div>
        <div class="r-foot">
          <p class="countdown" id="countdown-wrap">Prochaine carte dans <strong id="countdown">--:--:--</strong></p>
          <button type="button" class="btn" id="train">S'entraîner</button>
        </div>
      </section>
    </div>
  </section>

  <section class="mx-stats" id="mx-stats" hidden>
    <div class="st-head">
      <h2>Tes stats</h2>
      <p class="muted small">Gardées dans ton navigateur, sur cet appareil.</p>
    </div>
    <div class="st-tiles">
      <div class="st-tile"><span class="st-v" id="s-played">0</span><span class="st-l">Parties</span></div>
      <div class="st-tile"><span class="st-v" id="s-rate">0 %</span><span class="st-l">Victoires</span></div>
      <div class="st-tile hot"><span class="st-v" id="s-streak">0</span><span class="st-l">Série en cours</span></div>
      <div class="st-tile"><span class="st-v" id="s-best">0</span><span class="st-l">Record</span></div>
    </div>
    <div class="dist" id="dist"></div>
  </section>

  <section class="how">
    <div class="how-step"><b>01</b><h3>Observe</h3><p class="muted small">La carte est floutée, zoomée et sans couleurs. Son nom est caché.</p></div>
    <div class="how-step"><b>02</b><h3>Devine</h3><p class="muted small">Propose un nom de Pokémon. Les petites fautes sont pardonnées.</p></div>
    <div class="how-step"><b>03</b><h3>Débloque</h3><p class="muted small">Chaque raté dézoome la carte et révèle un indice : type, PV, extension, illustrateur…</p></div>
    <div class="how-step"><b>04</b><h3>Gagne-la</h3><p class="muted small">Trouvée pendant le défi du jour, la carte rejoint ton classeur (pas en entraînement). Nouvelle carte chaque jour à minuit.</p></div>
  </section>
  </div>

  <div class="mode-panel" id="mode-booster" hidden>
    <section class="bx">
      <div class="bx-head">
        <h2 id="bx-title">Booster du jour</h2>
        <p class="muted" id="bx-lead">Aujourd'hui : <strong id="bx-set">…</strong>. Un booster gratuit par jour, dix cartes. La dixième est pour ton classeur.</p>
        <p class="muted" id="bx-lead-train" hidden>Une extension tirée au hasard à chaque ouverture. Entraînement : aucune carte n'est gagnée.</p>
      </div>
      <div id="bx-state" aria-live="polite"></div>
      <div class="bx-stage" id="bx-stage" hidden>
        <button type="button" class="pack" id="bx-pack" aria-label="Ouvrir le booster du jour">
          <span class="pack-foil" aria-hidden="true"></span>
          <span class="pack-top" aria-hidden="true"></span>
          <span class="pack-coti" aria-hidden="true" set:html={mascotSvg('wow', 70)} />
          <span class="pack-brand">HoloCote</span>
          <span class="pack-set" id="bx-pack-set"></span>
          <span class="pack-n">10 cartes</span>
          <span class="pack-cta">Touche pour ouvrir</span>
        </button>
        <div class="bx-cards" id="bx-cards" hidden></div>
        <div class="bx-hit" id="bx-hit" hidden>
          <div class="hit-card" id="hit-card"></div>
          <div class="hit-info">
            <p class="hit-k" id="hit-k">Ta carte à gagner</p>
            <h3 class="hit-name" id="hit-name"></h3>
            <p class="muted small" id="hit-meta"></p>
            <p class="hit-price" id="hit-price"></p>
            <button type="button" class="btn claim-btn" id="bx-claim">Ajouter à mon classeur</button>
            <p class="muted small" id="bx-claim-note">La dixième carte du booster rejoint ta collection (état Near Mint), une fois par jour.</p>
          </div>
        </div>
        <p class="bx-rates muted small">Chances pour la dixième carte : 3 % carte exceptionnelle (hyper rare, dorée…), 12 % carte « chasse » (numéro au-delà de la série), 30 % rare de la série, 55 % carte ordinaire. Simulation : ce ne sont pas les taux officiels.</p>
        <button type="button" class="btn btn-primary bx-again" id="bx-again" hidden>Ouvrir un autre booster</button>
        <div class="bx-sum" id="bx-sum" hidden>
          <div><span class="muted small">Valeur du booster</span><strong id="bx-total">—</strong></div>
          <div><span class="muted small">Meilleure carte</span><strong id="bx-best">—</strong></div>
          <div><span class="muted small">Prochain booster dans</span><strong id="bx-next">--:--:--</strong></div>
        </div>
      </div>
    </section>
  </div>

  <div class="mode-panel" id="mode-duel" hidden>
    <section class="duel">
      <div class="duel-head">
        <div>
          <h2>Duel</h2>
          <p class="muted" id="du-lead">Deux cartes, une seule question : laquelle a la plus grosse cote aujourd'hui ?</p>
        </div>
        <div class="duel-score" id="du-score" hidden>
          <div><strong id="du-streak">0</strong><span class="muted small">série</span></div>
          <div><strong id="du-best">0</strong><span class="muted small">record</span></div>
        </div>
      </div>
      <div id="du-state" aria-live="polite"></div>
      <div class="duel-arena" id="du-arena" hidden>
        <button type="button" class="du-card" id="du-a"></button>
        <div class="du-vs" aria-hidden="true">VS</div>
        <button type="button" class="du-card" id="du-b"></button>
      </div>
      <div class="du-result" id="du-result" hidden>
        <div class="du-coti" id="du-coti"></div>
        <p class="du-msg" id="du-msg"></p>
        <button type="button" class="btn btn-primary" id="du-next">Duel suivant</button>
      </div>
      <div class="du-reward" id="du-reward" hidden>
        <div class="du-reward-card" id="du-reward-card"></div>
        <div>
          <p class="du-reward-k" id="du-reward-k">Ta récompense</p>
          <p class="du-reward-t" id="du-reward-t"></p>
          <button type="button" class="btn claim-btn" id="du-claim">Ajouter à mon classeur</button>
          <p class="muted small" id="du-reward-note"></p>
        </div>
      </div>
    </section>
  </div>

  <p class="notice">
    Jeux gratuits, sans achat, sans compte et sans classement en ligne : rien n'est vendu ni gagné en vrai, les cartes gagnées rejoignent seulement ta collection, qui reste dans ton navigateur. Images et données de cartes : TCGdex.
    Pokémon et les noms associés sont des marques de leurs détenteurs respectifs.
  </p>

  <script>
    import { POOL_NAMES, MAX_TRIES, todayNumber, msToMidnight, dayCandidates, cardById, randomCard, species, isRight, typeFr, getDay, saveDay, stats, type MysteryCard, type DayRecord } from '../lib/mystery';
    import { suggestNames } from '../lib/smartsearch';
    import { normalize } from '../lib/cardindex';
    import { getCard, priceFor, formatPrice, type Card } from '../lib/tcgdex';
    import { favButton } from '../lib/favorites';
    import { addItem, hasCard } from '../lib/collection';
    import { el, url, holoCard, toast, favInfo } from '../lib/ui';

    const $ = (id: string) => document.getElementById(id)!;
    const today = todayNumber();

    // Zoom (s), flou (b) et noir et blanc (g) selon le nombre d'essais déjà utilisés.
    const STAGES = [
      { s: 3.3, b: 16, g: 1 }, { s: 2.7, b: 11, g: 0.85 }, { s: 2.2, b: 7.5, g: 0.6 },
      { s: 1.75, b: 4.5, g: 0.35 }, { s: 1.35, b: 2.5, g: 0.1 }, { s: 1.08, b: 1.2, g: 0 },
    ];

    let mode: 'daily' | 'train' = 'daily';
    let mc: MysteryCard;
    let card: Card | null = null;
    let rec: DayRecord = { guesses: [], won: false, done: false };

    const hash = (s: string) => [...s].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);

    function clueList(c: Card): { label: string; value: string }[] {
      const name = species(c.name);
      return [
        { label: 'Type', value: c.types?.map(typeFr).join(' / ') || (c.category ?? '—') },
        { label: 'Points de vie', value: c.hp ? `${c.hp} PV` : '—' },
        { label: 'Extension', value: c.set?.name ?? '—' },
        { label: 'Illustrateur', value: c.illustrator ?? 'Inconnu' },
        { label: 'Première lettre', value: `${name[0].toUpperCase()}… (${name.replace(/[^\p{L}]/gu, '').length} lettres)` },
      ];
    }

    function render() {
      const used = rec.guesses.length;
      const over = rec.done;
      const st = STAGES[Math.min(used, STAGES.length - 1)];
      const box = $('mx-card');
      box.style.setProperty('--s', over ? '1' : String(st.s));
      box.style.setProperty('--b', over ? '0px' : `${st.b}px`);
      box.style.setProperty('--g', over ? '0' : String(st.g));
      box.classList.toggle('revealed', over);
      $('stage').classList.toggle('won', over && rec.won);
      $('stage').classList.toggle('lost', over && !rec.won);

      $('pips').replaceChildren(...Array.from({ length: MAX_TRIES }, (_, i) => {
        const g = rec.guesses[i];
        const cls = g === undefined ? (i === used && !over ? 'now' : '') : isRight(g, mc.answer) ? 'ok' : 'ko';
        return el('span', { class: `pip ${cls}` });
      }));
      $('tries').textContent = over
        ? rec.won ? `Trouvé en ${used} essai${used > 1 ? 's' : ''}` : 'Six essais, pas de chance'
        : `Essai ${used + 1} sur ${MAX_TRIES}`;

      $('guesses').replaceChildren(...rec.guesses.map((g, i) => {
        const ok = isRight(g, mc.answer);
        return el('li', { class: ok ? 'ok' : 'ko' }, [
          el('span', { class: 'g-n' }, [String(i + 1)]),
          el('span', { class: 'g-t' }, [g || 'Passé']),
          el('span', { class: 'g-i', 'aria-label': ok ? 'Bonne réponse' : 'Raté' }, [ok ? '✓' : '✕']),
        ]);
      }));

      const clues = card ? clueList(card) : [];
      $('clues').replaceChildren(...clues.map((c, i) => {
        const open = over || used > i;
        return el('div', { class: `clue ${open ? 'open' : ''}`, style: `--d:${i * 60}ms` }, [
          el('div', { class: 'clue-inner' }, [
            el('div', { class: 'clue-face back' }, [el('span', { class: 'cl-l' }, [`Indice ${i + 1}`]), el('span', { class: 'cl-v muted' }, [`après l'essai ${i + 1}`])]),
            el('div', { class: 'clue-face front' }, [el('span', { class: 'cl-l' }, [c.label]), el('span', { class: 'cl-v' }, [open ? c.value : ''])]),
          ]),
        ]);
      }));

      ($('guess-form') as HTMLElement).hidden = over;
      $('result').hidden = !over;
      $('mx-tag').textContent = mode === 'daily' ? `Défi du jour · n° ${today}` : 'Entraînement';
      if (over) showResult();
      renderStats();
    }

    function showResult() {
      if (!card) return;
      const used = rec.guesses.length;
      $('r-kicker').textContent = rec.won ? (used === 1 ? 'Du premier coup !' : used <= 3 ? 'Œil de lynx' : 'Bien joué') : 'Raté pour cette fois';
      $('r-title').textContent = rec.won ? `C'était bien ${mc.answer} !` : `C'était ${mc.answer}.`;
      $('r-name').textContent = card.name;
      $('r-set').textContent = [card.set?.name, card.rarity, card.illustrator ? `Illustration : ${card.illustrator}` : ''].filter(Boolean).join(' · ');
      const p = priceFor(card, 'normal');
      $('r-price').replaceChildren(...(p ? [el('span', { class: 'muted small' }, ['Cote du jour ']), el('strong', {}, [formatPrice(p.value, p.unit)])] : [el('span', { class: 'muted small' }, ['Cote indisponible'])]));
      $('r-card').replaceChildren(holoCard(card.image, card.name, cardImg.endsWith('low.webp') ? 'low' : 'high'));
      ($('r-link') as HTMLAnchorElement).href = url(`/carte/?id=${encodeURIComponent(card.id)}&lang=fr`);
      const c = card;
      $('r-fav').replaceChildren(favButton(c.id, 'fr', async () => favInfo(c), { label: true }));
      // Récompense : la carte trouvée lors du défi du jour peut rejoindre le classeur (une seule fois, jamais en entraînement).
      const canClaim = mode === 'daily' && rec.won;
      $('claim-box').hidden = false;
      const cb = $('claim') as HTMLButtonElement;
      cb.hidden = !canClaim;
      const owned = canClaim && !rec.claimed && hasCard(card.id, 'fr');
      cb.disabled = !!rec.claimed || owned;
      cb.classList.toggle('done', !!rec.claimed || owned);
      $('claim-lbl').textContent = rec.claimed ? 'Dans ton classeur' : owned ? 'Déjà dans ton classeur' : 'Ajouter à mon classeur';
      $('claim-note').textContent = owned ? "Tu as déjà cette carte dans ton classeur : chaque carte n'y est rangée qu'une fois." : mode === 'train'
        ? "En entraînement, la carte ne peut pas être ajoutée au classeur : seule la carte du défi du jour se gagne."
        : !rec.won ? "Perdu : la carte ne rejoint pas ton classeur cette fois. Reviens demain pour une nouvelle chance !"
        : rec.claimed ? 'Ta récompense du jour est rangée dans ta collection (état Near Mint).' : 'Ta récompense : la carte rejoint ta collection, une seule fois par défi.';
      $('share').hidden = mode !== 'daily';
      $('countdown-wrap').hidden = mode !== 'daily';
      $('train').textContent = mode === 'daily' ? "S'entraîner" : 'Nouvelle carte';
    }

    function renderStats() {
      const s = stats(today);
      $('s-played').textContent = String(s.played);
      $('s-rate').textContent = `${s.played ? Math.round((s.wins / s.played) * 100) : 0} %`;
      $('s-streak').textContent = String(s.streak);
      $('s-best').textContent = String(s.best);
      const max = Math.max(1, ...s.dist);
      const mine = mode === 'daily' && rec.done && rec.won ? rec.guesses.length : 0;
      $('dist').replaceChildren(...s.dist.map((v, i) => el('div', { class: `d-row ${mine === i + 1 ? 'mine' : ''}` }, [
        el('span', { class: 'd-n' }, [String(i + 1)]),
        el('span', { class: 'd-bar', style: `--w:${Math.max(6, (v / max) * 100)}%` }, [String(v)]),
      ])));
      $('mx-stats').hidden = false;
    }

    function confetti() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const colors = ['#3ef0ff', '#ff4fd8', '#ffd25a', '#c6ff4a', '#8a7bff'];
      $('confetti').replaceChildren(...Array.from({ length: 46 }, (_, i) => {
        const s = el('span');
        s.style.setProperty('--x', `${(Math.random() - 0.5) * 520}px`);
        s.style.setProperty('--y', `${-120 - Math.random() * 260}px`);
        s.style.setProperty('--r', `${Math.random() * 720 - 360}deg`);
        s.style.background = colors[i % colors.length];
        s.style.animationDelay = `${Math.random() * 120}ms`;
        return s;
      }));
    }

    function submit(raw: string) {
      if (rec.done) return;
      const g = raw.trim();
      if (g && rec.guesses.some((x) => x && normalize(x) === normalize(g))) { toast('Tu as déjà proposé ce nom.'); return; }
      rec.guesses.push(g);
      rec.cardId = mc.id;
      const ok = !!g && isRight(g, mc.answer);
      if (ok) rec.won = true;
      if (ok || rec.guesses.length >= MAX_TRIES) rec.done = true;
      if (mode === 'daily') saveDay(today, rec);
      ($('guess') as HTMLInputElement).value = '';
      closeList();
      if (!ok && g) { $('stage').classList.remove('shake'); void $('stage').offsetWidth; $('stage').classList.add('shake'); }
      render();
      if (ok) confetti();
      if (rec.done) $('result').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    /* ---------- Autocomplétion ---------- */
    let options: string[] = [];
    let active = -1;
    let seq = 0;
    const input = $('guess') as HTMLInputElement;
    function closeList() { seq++; options = []; $('guess-list').hidden = true; input.setAttribute('aria-expanded', 'false'); active = -1; }
    function drawList() {
      const list = $('guess-list');
      list.replaceChildren(...options.map((o, i) => {
        const li = el('li', { role: 'option', id: `opt-${i}`, 'aria-selected': String(i === active) }, [o]);
        li.addEventListener('mousedown', (e) => { e.preventDefault(); submit(o); });
        return li;
      }));
      list.hidden = options.length === 0;
      input.setAttribute('aria-expanded', String(!list.hidden));
      if (active >= 0) input.setAttribute('aria-activedescendant', `opt-${active}`); else input.removeAttribute('aria-activedescendant');
    }
    input.addEventListener('input', async () => {
      const q = input.value.trim();
      const my = ++seq;
      active = -1;
      if (q.length < 2) { options = []; drawList(); return; }
      const nq = normalize(q);
      const local = POOL_NAMES.filter((n) => normalize(n).startsWith(nq));
      let names: string[] = [];
      try { names = (await suggestNames(q, 'fr', 10)).map((n) => species(n.label)); } catch { names = []; }
      if (my !== seq) return;
      options = [...new Set([...names, ...local].filter(Boolean))].slice(0, 7);
      drawList();
    });
    input.addEventListener('keydown', (e) => {
      if ($('guess-list').hidden || !options.length) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); active = (active + 1) % options.length; drawList(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); active = (active - 1 + options.length) % options.length; drawList(); }
      else if (e.key === 'Escape') closeList();
    });
    input.addEventListener('blur', () => setTimeout(closeList, 120));
    $('guess-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const v = active >= 0 ? options[active] : input.value;
      if (!v.trim()) { input.focus(); return; }
      submit(v);
    });
    $('skip').addEventListener('click', () => submit(''));
    $('claim').addEventListener('click', () => {
      if (mode !== 'daily' || !rec.won || rec.claimed || !card) return;
      const fresh = getDay(today);
      if (fresh.claimed) { rec = fresh; showResult(); return; } // déjà ajoutée (autre onglet)
      if (!addItem({ cardId: card.id, lang: 'fr', name: card.name, image: card.image, setName: card.set?.name, rarity: card.rarity, condition: 'NM', finish: 'normal', quantity: 1 })) { toast('Cette carte est déjà dans ton classeur.'); showResult(); return; }
      rec.claimed = true;
      saveDay(today, rec);
      showResult();
      toast(`${card.name} rejoint ton classeur !`);
    });

    /* ---------- Partage, entraînement, compte à rebours ---------- */
    $('share').addEventListener('click', async () => {
      const used = rec.guesses.length;
      const line = rec.guesses.map((g) => (g && isRight(g, mc.answer) ? '■' : '□')).join('');
      const text = `HoloCote · Défi du jour n° ${today}\n${rec.won ? used : 'X'}/${MAX_TRIES}  ${line}\n${location.origin}${url('/defi/')}`;
      try {
        if (navigator.share) { await navigator.share({ text }); return; }
        await navigator.clipboard.writeText(text);
        toast('Résultat copié : colle-le où tu veux.');
      } catch { /* partage annulé */ }
    });
    // Entraînement : piloté par l'onglet « Entraînement » de la page (événement defi:mystery).
    const trainNext = () => start([randomCard(mc?.id), randomCard(mc?.id), randomCard(mc?.id)]);
    $('train').addEventListener('click', () => {
      if (mode === 'train') { trainNext(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
      else location.hash = '#entrainement-mystere';
    });
    window.addEventListener('defi:mystery', (e) => {
      const train = (e as CustomEvent<{ train: boolean }>).detail.train;
      if (train && mode !== 'train') { mode = 'train'; trainNext(); }
      else if (!train && mode === 'train') { mode = 'daily'; start(dayCandidates(today)); }
    });
    const tick = () => {
      const ms = msToMidnight();
      const h = Math.floor(ms / 3.6e6), m = Math.floor((ms % 3.6e6) / 6e4), s = Math.floor((ms % 6e4) / 1000);
      $('countdown').textContent = [h, m, s].map((v) => String(v).padStart(2, '0')).join(':');
      if (ms < 1500 && mode === 'daily') setTimeout(() => location.reload(), 2000);
    };
    tick();
    setInterval(tick, 1000);

    let cardImg = '';
    const coarse = window.matchMedia('(pointer: coarse)').matches;

    /** Vérifie qu'une image se charge vraiment (TCGdex n'a pas toutes les images en français). */
    function probeImg(src: string): Promise<boolean> {
      return new Promise((res) => {
        const i = new Image();
        i.referrerPolicy = 'no-referrer';
        const t = setTimeout(() => res(false), 9000);
        i.onload = () => { clearTimeout(t); res(i.naturalWidth > 0); };
        i.onerror = () => { clearTimeout(t); res(false); };
        i.src = src;
      });
    }

    /** Charge une carte et trouve une image utilisable (français, sinon anglais). */
    async function loadMystery(c: MysteryCard): Promise<{ card: Card; img: string } | null> {
      const [fr, en] = await Promise.all([getCard(c.id, 'fr').catch(() => null), getCard(c.id, 'en').catch(() => null)]);
      const info = fr ?? en;
      if (!info) return null;
      const bases = [fr?.image, en?.image, fr?.image?.replace('/fr/', '/en/')].filter((x, i, a): x is string => !!x && a.indexOf(x) === i);
      for (const b of bases) {
        for (const q of ['high', 'low']) {
          const src = `${b}/${q}.webp`;
          if (await probeImg(src)) return { card: { ...info, image: b }, img: src };
        }
      }
      return null;
    }

    let startSeq = 0;
    async function start(candidates: MysteryCard[]) {
      const my = ++startSeq;
      rec = mode === 'daily' ? getDay(today) : { guesses: [], won: false, done: false };
      $('arena').hidden = true;
      $('mx-state').replaceChildren(el('div', { class: 'status', role: 'status' }, [el('div', { class: 'spinner' }), 'On mélange le paquet…']));
      // Partie déjà commencée aujourd'hui : on reprend la même carte.
      const saved = mode === 'daily' ? cardById(rec.cardId) : undefined;
      const list = saved ? [saved, ...candidates.filter((c) => c !== saved)] : candidates;
      let found: { card: Card; img: string } | null = null;
      let pickedCard: MysteryCard | null = null;
      for (const c of list) {
        found = await loadMystery(c);
        if (my !== startSeq) return; // une autre partie a démarré entre-temps
        if (found) { pickedCard = c; break; }
      }
      if (pickedCard) mc = pickedCard;
      if (!found) {
        const retry = el('button', { type: 'button', class: 'btn' }, ['Réessayer']);
        retry.addEventListener('click', () => start(candidates));
        $('mx-state').replaceChildren(el('div', { class: 'status' }, ["Impossible de charger la carte du défi : vérifie ta connexion. ", retry]));
        return;
      }
      if (mode === 'daily' && rec.cardId && rec.cardId !== mc.id) rec = { guesses: [], won: false, done: false };
      card = found.card;
      cardImg = found.img;
      const h = hash(mc.id);
      const box = $('mx-card');
      box.style.setProperty('--ox', `${32 + (h % 37)}%`);
      box.style.setProperty('--oy', `${24 + ((h >> 5) % 20)}%`);
      ($('mx-img') as HTMLImageElement).src = cardImg;
      $('mx-state').replaceChildren();
      $('arena').hidden = false;
      $('confetti').replaceChildren();
      render();
      // Sur téléphone, pas de clavier qui surgit à l'ouverture de la page.
      if (!rec.done && !coarse) setTimeout(() => input.focus({ preventScroll: true }), 50);
    }

    start(dayCandidates(today));
  </script>

  <script>
    import { getBooster, saveBooster, drawBooster, loadPulled, hitLevel, setOfDay, BOOSTER_SETS, type BoosterState, type Pulled } from '../lib/booster';
    import { todayNumber, msToMidnight, getDay } from '../lib/mystery';
    import { loadMarket, type Quote } from '../lib/market';
    import { addItem, hasCard } from '../lib/collection';
    import { formatPrice } from '../lib/tcgdex';
    import { mascotSvg } from '../lib/mascot';
    import { el, url, holoCard, toast, status } from '../lib/ui';

    const $ = (id: string) => document.getElementById(id)!;
    const fmt = (v?: number, u: 'EUR' | 'USD' = 'EUR') => (v === undefined ? '—' : formatPrice(v, u));

    /* ---------- Onglets internes ---------- */
    // Vues : les trois jeux du jour, le choix d'entraînement, et chaque jeu en entraînement (sans gain).
    type Panel = 'mystery' | 'booster' | 'duel' | 'train';
    type View = Panel | 'train-mystery' | 'train-booster' | 'train-duel';
    const PANELS: Panel[] = ['mystery', 'booster', 'duel', 'train'];
    const HASH: Record<string, View> = {
      '#mystere': 'mystery', '#booster': 'booster', '#duel': 'duel', '#entrainement': 'train',
      '#entrainement-mystere': 'train-mystery', '#entrainement-booster': 'train-booster', '#entrainement-duel': 'train-duel',
    };
    const GAME: Record<string, string> = { mystery: 'Carte mystère', booster: 'Booster', duel: 'Duel' };
    const fromHash = (): View => HASH[location.hash] ?? 'mystery';
    const booted: Record<string, boolean> = {};
    function show(v: View) {
      const training = v.startsWith('train-');
      const panel: Panel = training ? (v.slice(6) as Panel) : (v as Panel);
      PANELS.forEach((x) => { $(`mode-${x}`).hidden = x !== panel; });
      const tab = v.startsWith('train') ? 'train' : panel;
      document.querySelectorAll<HTMLElement>('.mode').forEach((a) => a.setAttribute('aria-current', a.dataset.mode === tab ? 'page' : 'false'));
      $('train-bar').hidden = !training;
      if (training) {
        $('tb-game').textContent = GAME[panel];
        ($('tb-back') as HTMLAnchorElement).href = panel === 'mystery' ? '#mystere' : `#${panel}`;
      }
      $('hero-coti').innerHTML = mascotSvg(panel === 'booster' ? 'wow' : panel === 'duel' ? 'think' : panel === 'train' ? 'happy' : 'wink', 150);
      if (panel === 'mystery') window.dispatchEvent(new CustomEvent('defi:mystery', { detail: { train: training } }));
      if (panel === 'booster') boosterView(training);
      if (panel === 'duel') duelView(training ? 'train' : 'daily');
      refreshStatus();
    }
    window.addEventListener('hashchange', () => { show(fromHash()); window.scrollTo({ top: $('modes').offsetTop - 80, behavior: 'smooth' }); });

    function refreshStatus() {
      const d = getDay(todayNumber());
      $('st-mystery').textContent = d.done ? (d.won ? 'gagnée' : 'perdue') : d.guesses.length ? 'en cours' : 'à jouer';
      const b = getBooster();
      $('st-booster').textContent = !b ? 'à ouvrir' : b.claimed ? 'carte gagnée' : 'ouvert';
      const dd = getDaily();
      $('st-duel').textContent = !dd?.answered ? 'à jouer' : dd.ok ? (dd.claimed ? 'carte gagnée' : 'gagné') : 'perdu';
    }

    /* ---------- Booster du jour ---------- */
    let bState: BoosterState | null = null;
    let pulled: Pulled[] = [];
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function mini(p: Pulled, i: number, faceUp: boolean) {
      const c = p.card;
      const box = el('div', { class: `bx-c ${faceUp ? 'up' : ''}`, style: `--i:${i}` }, [
        el('div', { class: 'bx-inner' }, [
          el('div', { class: 'bx-back' }, [el('span', {}, ['HC'])]),
          el('a', { class: 'bx-front', href: c ? url(`/carte/?id=${encodeURIComponent(p.id)}&lang=fr`) : '#', title: c?.name ?? '' }, [
            c?.image ? el('img', { src: `${c.image}/low.webp`, alt: c.name, loading: 'lazy', referrerpolicy: 'no-referrer' }) : el('span', { class: 'bx-ph' }, [c?.name ?? 'Carte']),
            el('span', { class: 'bx-v' }, [fmt(p.value, p.unit)]),
          ]),
        ]),
      ]);
      return box;
    }

    function renderHit(reveal: boolean) {
      const p = pulled[pulled.length - 1];
      const c = p?.card;
      $('bx-hit').hidden = false;
      const box = $('hit-card');
      if (!reveal) {
        box.className = 'hit-card hidden-card';
        box.replaceChildren(el('button', { type: 'button', class: 'hit-back', id: 'hit-reveal' }, [el('span', {}, ['?']), el('small', {}, ['Touche pour révéler'])]));
        $('hit-reveal').addEventListener('click', () => revealHit());
        $('hit-k').textContent = 'Ta carte à gagner';
        $('hit-name').textContent = 'Mystère…';
        $('hit-meta').textContent = 'La dernière carte du booster, celle que tu peux garder.';
        $('hit-price').textContent = '';
        ($('bx-claim') as HTMLButtonElement).hidden = true;
        $('bx-claim-note').hidden = true;
        return;
      }
      const lvl = hitLevel(c ?? null);
      box.className = `hit-card lvl-${lvl}`;
      box.replaceChildren(holoCard(c?.image, c?.name ?? 'Carte', 'high'));
      $('hit-k').textContent = ['Ta carte à gagner', 'Belle prise !', 'Superbe carte !', 'Carte exceptionnelle !'][lvl];
      $('hit-name').textContent = c?.name ?? 'Carte inconnue';
      $('hit-meta').textContent = [c?.set?.name, c?.rarity].filter(Boolean).join(' · ');
      $('hit-price').replaceChildren(...(p?.value !== undefined ? [el('span', { class: 'muted small' }, ['Cote du jour ']), el('strong', {}, [fmt(p.value, p.unit)])] : []));
      const btn = $('bx-claim') as HTMLButtonElement;
      if (bxTrain) {
        btn.hidden = true;
        $('bx-claim-note').hidden = false;
        $('bx-claim-note').textContent = 'Entraînement : cette carte ne rejoint pas ton classeur.';
        $('bx-again').hidden = false;
        return;
      }
      btn.hidden = false;
      $('bx-claim-note').hidden = false;
      const owned = !bState?.claimed && !!c && hasCard(c.id, 'fr');
      btn.disabled = !!bState?.claimed || !c || owned;
      btn.textContent = bState?.claimed ? 'Dans ton classeur' : owned ? 'Déjà dans ton classeur' : 'Ajouter à mon classeur';
      btn.classList.toggle('done', !!bState?.claimed || owned);
      $('bx-claim-note').textContent = bState?.claimed ? 'Rangée dans ta collection. Reviens demain pour un nouveau booster.' : owned ? "Tu as déjà cette carte dans ton classeur : chaque carte n'y est rangée qu'une fois." : 'La dixième carte du booster rejoint ta collection (état Near Mint), une fois par jour.';
    }

    function renderSummary() {
      const eur = pulled.filter((p) => p.unit === 'EUR' && p.value !== undefined);
      const total = eur.reduce((s, p) => s + (p.value ?? 0), 0);
      const best = [...eur].sort((a, b) => (b.value ?? 0) - (a.value ?? 0))[0];
      $('bx-total').textContent = eur.length ? fmt(total) : '—';
      $('bx-best').textContent = best?.card ? `${best.card.name} · ${fmt(best.value)}` : '—';
      $('bx-sum').hidden = false;
    }

    async function revealHit() {
      const box = $('hit-card');
      box.classList.add('flipping');
      if (!reduced) await sleep(450);
      renderHit(true);
      if (hitLevel(pulled[pulled.length - 1]?.card ?? null) >= 2) navigator.vibrate?.([30, 40, 60]);
      if (bState && !bState.opened && !bxTrain) { bState.opened = true; saveBooster(bState); }
      refreshStatus();
    }

    let bxTrain = false;
    async function openPack() {
      const pack = $('bx-pack') as HTMLButtonElement;
      if (pack.disabled) return;
      pack.disabled = true;
      pack.classList.add('tearing');
      try {
        if (bxTrain) bState = await drawBooster({ save: false, setId: BOOSTER_SETS[Math.floor(Math.random() * BOOSTER_SETS.length)] });
        else if (!bState) bState = await drawBooster();
        if (!bState) throw new Error('booster');
        pulled = await loadPulled(bState.cards);
      } catch {
        pack.disabled = false;
        pack.classList.remove('tearing');
        $('bx-state').replaceChildren(el('p', { class: 'muted' }, ["Le booster n'a pas pu être préparé : vérifie ta connexion et réessaie."]));
        return;
      }
      if (!reduced) await sleep(500);
      pack.hidden = true;
      const grid = $('bx-cards');
      grid.hidden = false;
      const nine = pulled.slice(0, 9);
      grid.replaceChildren(...nine.map((p, i) => mini(p, i, false)));
      for (let i = 0; i < nine.length; i++) {
        await sleep(reduced ? 0 : 170);
        grid.children[i]?.classList.add('up');
      }
      renderSummary();
      renderHit(false);
      refreshStatus();
      if (bxTrain && bState) { $('bx-set').textContent = bState.setName; }
    }

    /** Remet le booster fermé (nouvelle ouverture). */
    function resetPack(label: string) {
      const pack = $('bx-pack') as HTMLButtonElement;
      pack.hidden = false;
      pack.disabled = false;
      pack.classList.remove('tearing');
      $('bx-pack-set').textContent = label;
      $('bx-cards').hidden = true;
      $('bx-hit').hidden = true;
      $('bx-sum').hidden = true;
      $('bx-state').replaceChildren();
    }

    /** Bascule entre booster du jour et booster d'entraînement. */
    async function boosterView(train: boolean) {
      if (!booted.booster) { booted.booster = true; await initBooster(); }
      if (train === bxTrain && booted.boosterView) return;
      booted.boosterView = true;
      bxTrain = train;
      $('bx-title').textContent = train ? 'Booster d’entraînement' : 'Booster du jour';
      $('bx-lead').hidden = train;
      $('bx-lead-train').hidden = !train;
      $('bx-again').hidden = true;
      if (train) { bState = null; pulled = []; resetPack('Extension surprise'); return; }
      bState = getBooster();
      if (bState) await showSavedBooster();
      else resetPack($('bx-set').textContent || setOfDay());
    }

    async function showSavedBooster() {
      if (!bState) return;
      $('bx-pack').hidden = true;
      $('bx-state').replaceChildren(status('On ressort ton booster du jour…'));
      pulled = await loadPulled(bState.cards);
      $('bx-state').replaceChildren();
      $('bx-cards').hidden = false;
      $('bx-cards').replaceChildren(...pulled.slice(0, 9).map((p, i) => mini(p, i, true)));
      renderSummary();
      renderHit(bState.opened);
    }

    async function initBooster() {
      const setId = setOfDay();
      $('bx-set').textContent = setId;
      $('bx-pack-set').textContent = setId;
      $('bx-stage').hidden = false;
      // Nom lisible de l'extension du jour
      fetch(`https://api.tcgdex.net/v2/fr/sets/${encodeURIComponent(setId)}`).then((r) => (r.ok ? r.json() : null)).then((d) => {
        if (d?.name) { $('bx-set').textContent = d.name; $('bx-pack-set').textContent = d.name; }
      }).catch(() => {});
      $('bx-pack').addEventListener('click', openPack);
      $('bx-again').addEventListener('click', () => { bState = null; pulled = []; $('bx-again').hidden = true; resetPack('Extension surprise'); window.scrollTo({ top: $('bx-stage').offsetTop - 90, behavior: 'smooth' }); });
      $('bx-claim').addEventListener('click', () => {
        if (bxTrain) return; // rien à gagner en entraînement
        const fresh = getBooster();
        const c = pulled[pulled.length - 1]?.card;
        if (!bState || !c || fresh?.claimed) { if (fresh) bState = fresh; renderHit(true); return; }
        if (!addItem({ cardId: c.id, lang: 'fr', name: c.name, image: c.image, setName: c.set?.name, rarity: c.rarity, condition: 'NM', finish: 'normal', quantity: 1 })) { toast('Cette carte est déjà dans ton classeur.'); renderHit(true); return; }
        bState.claimed = true;
        bState.opened = true;
        saveBooster(bState);
        renderHit(true);
        refreshStatus();
        toast(`${c.name} rejoint ton classeur !`);
      });
      const tick = () => {
        const ms = msToMidnight();
        const h = Math.floor(ms / 3.6e6), m = Math.floor((ms % 3.6e6) / 6e4), s = Math.floor((ms % 6e4) / 1000);
        $('bx-next').textContent = [h, m, s].map((v) => String(v).padStart(2, '0')).join(':');
      };
      tick();
      setInterval(tick, 1000);
    }

    /* ---------- Duel ---------- */
    // Duel du jour : un seul par jour, la même paire pour tous ; bonne réponse = la carte la moins chère des deux en récompense.
    // Entraînement : duels illimités avec série et record, sans rien à gagner.
    const DKEY = 'holocote.duel.v1';
    const DAYKEY = 'holocote.duel.day.v1';
    interface Daily { day: number; a: string; b: string; answered: boolean; side?: 'a' | 'b'; ok?: boolean; claimed?: boolean }
    function getDaily(): Daily | null {
      try { const d = JSON.parse(localStorage.getItem(DAYKEY) || 'null'); return d && d.day === todayNumber() ? d : null; } catch { return null; }
    }
    const saveDaily = (d: Daily) => { try { localStorage.setItem(DAYKEY, JSON.stringify(d)); } catch { /* rien */ } };

    let pool: Quote[] = [];
    let pair: [Quote, Quote] | null = null;
    let duMode: 'daily' | 'train' = 'daily';
    let streak = 0;
    let best = 0;
    let answered = false;
    try { best = JSON.parse(localStorage.getItem(DKEY) || '{}').best || 0; } catch { /* rien */ }
    const saveBest = () => { try { localStorage.setItem(DKEY, JSON.stringify({ best })); } catch { /* rien */ } };
    // Paire jouable : deux cartes de noms différents, cotes fiables, et un écart net (1,2 à 5 fois) pour qu'il y ait une vraie bonne réponse.
    const fair = (a: Quote, b: Quote) => { const r = Math.max(a.price, b.price) / Math.min(a.price, b.price); return a.id !== b.id && a.name !== b.name && r >= 1.2 && r <= 5; };

    function duelCard(q: Quote, side: 'a' | 'b') {
      const b = $(`du-${side}`) as HTMLButtonElement;
      b.className = 'du-card';
      b.disabled = false;
      b.replaceChildren(
        holoCard(q.image, q.name),
        el('span', { class: 'du-name' }, [q.name]),
        el('span', { class: 'du-set muted small' }, [q.setName ?? '']),
        el('span', { class: 'du-price' }, ['? €']),
      );
      b.setAttribute('aria-label', `${q.name}, choisir cette carte`);
    }

    /** Paire du jour : tirage fixe (même graine pour tous) parmi les cartes suivies en permanence. */
    function dailyPair(): [Quote, Quote] | null {
      const legends = pool.filter((q) => q.group === 'legend').sort((x, y) => x.id.localeCompare(y.id));
      const list = legends.length >= 4 ? legends : [...pool].sort((x, y) => x.id.localeCompare(y.id));
      let seed = todayNumber() * 7919 + 17;
      const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
      for (let k = 0; k < 400; k++) {
        const a = list[Math.floor(rnd() * list.length)], b = list[Math.floor(rnd() * list.length)];
        if (fair(a, b)) return [a, b];
      }
      return null;
    }

    function hideResult() { $('du-result').hidden = true; $('du-reward').hidden = true; }

    function setDuMode(m: 'daily' | 'train') {
      duMode = m;
      $('du-score').hidden = m !== 'train';
      $('du-lead').textContent = m === 'daily'
        ? 'Un duel par jour : trouve la carte qui a la plus grosse cote et gagne la moins chère des deux pour ton classeur.'
        : 'Entraîne-toi sans limite et bats ton record de bonnes réponses d’affilée. Rien à gagner ici.';
      answered = false;
      hideResult();
      if (m === 'train') { nextTrain(); return; }
      // Duel du jour : reprendre la paire déjà vue aujourd'hui, sinon la paire fixe du jour.
      const d = getDaily();
      const byId = (id: string) => pool.find((q) => q.id === id);
      let p: [Quote, Quote] | null = d && byId(d.a) && byId(d.b) ? [byId(d.a)!, byId(d.b)!] : dailyPair();
      if (!p) { $('du-state').replaceChildren(el('p', { class: 'muted' }, ['Pas assez de cotes aujourd’hui pour le duel. Essaie l’entraînement.'])); return; }
      pair = p;
      if (!d) saveDaily({ day: todayNumber(), a: p[0].id, b: p[1].id, answered: false });
      duelCard(p[0], 'a');
      duelCard(p[1], 'b');
      $('du-arena').hidden = false;
      const dd = getDaily();
      if (dd?.answered && dd.side) reveal(dd.side, false);
    }

    function nextTrain() {
      answered = false;
      hideResult();
      pair = null;
      for (let k = 0; k < 200 && !pair; k++) {
        const a = pool[Math.floor(Math.random() * pool.length)], b = pool[Math.floor(Math.random() * pool.length)];
        if (fair(a, b)) pair = [a, b];
      }
      if (!pair) return;
      duelCard(pair[0], 'a');
      duelCard(pair[1], 'b');
      $('du-arena').hidden = false;
    }

    function renderReward(d: Daily) {
      if (!pair || !d.ok) { $('du-reward').hidden = true; return; }
      const cheap = pair[0].price <= pair[1].price ? pair[0] : pair[1];
      $('du-reward-card').replaceChildren(holoCard(cheap.image, cheap.name));
      $('du-reward-k').textContent = d.claimed ? 'Récompense récupérée' : 'Ta récompense';
      $('du-reward-t').textContent = `${cheap.name} (${fmt(cheap.price)}), la moins chère des deux.`;
      const btn = $('du-claim') as HTMLButtonElement;
      const owned = !d.claimed && hasCard(cheap.id, cheap.lang);
      btn.disabled = !!d.claimed || owned;
      btn.textContent = d.claimed ? 'Dans ton classeur' : owned ? 'Déjà dans ton classeur' : 'Ajouter à mon classeur';
      btn.classList.toggle('done', !!d.claimed || owned);
      $('du-reward-note').textContent = d.claimed ? 'Rangée dans ta collection. Nouveau duel demain.' : owned ? "Tu as déjà cette carte dans ton classeur : chaque carte n'y est rangée qu'une fois." : 'Elle rejoint ta collection (état Near Mint). Un seul duel du jour : reviens demain.';
      $('du-reward').hidden = false;
    }

    /** Affiche la réponse (après un choix, ou en revenant sur un duel du jour déjà joué). */
    function reveal(side: 'a' | 'b', fresh: boolean) {
      if (!pair) return;
      answered = true;
      const [a, b] = pair;
      const pick = side === 'a' ? a : b;
      const other = side === 'a' ? b : a;
      const ok = pick.price >= other.price;
      (['a', 'b'] as const).forEach((s) => {
        const q = s === 'a' ? a : b;
        const btn = $(`du-${s}`) as HTMLButtonElement;
        btn.disabled = true;
        btn.querySelector('.du-price')!.textContent = fmt(q.price);
        btn.classList.add(q.price >= (s === 'a' ? b : a).price ? 'win' : 'lose');
        if (s === side) btn.classList.add('picked');
      });
      const ratio = Math.max(a.price, b.price) / Math.min(a.price, b.price);
      if (duMode === 'train') {
        if (fresh) { if (ok) { streak++; if (streak > best) { best = streak; saveBest(); } } else streak = 0; }
        $('du-streak').textContent = String(streak);
        $('du-best').textContent = String(best);
      }
      $('du-coti').innerHTML = mascotSvg(ok ? (duMode === 'train' && streak >= 5 ? 'wow' : 'happy') : 'sad', 64);
      $('du-msg').textContent = ok
        ? `Bien vu ! ${pick.name} vaut ${ratio.toFixed(1).replace('.', ',')} fois plus.${duMode === 'train' && streak >= 3 ? ` Série de ${streak} !` : ''}`
        : `Raté : ${other.name} vaut ${fmt(other.price)}, contre ${fmt(pick.price)}.`;
      const next = $('du-next') as HTMLButtonElement;
      next.textContent = duMode === 'train' ? 'Duel suivant' : 'S’entraîner';
      $('du-result').hidden = false;
      if (duMode === 'daily') {
        let d = getDaily() ?? { day: todayNumber(), a: a.id, b: b.id, answered: false };
        if (fresh) { d = { ...d, answered: true, side, ok }; saveDaily(d); }
        renderReward(d);
        if (!ok) $('du-msg').textContent += ' Pas de récompense aujourd’hui, nouveau duel demain.';
      }
      refreshStatus();
      if (fresh) next.focus({ preventScroll: true });
    }

    function choose(side: 'a' | 'b') {
      if (!pair || answered) return;
      if (duMode === 'daily' && getDaily()?.answered) return;
      reveal(side, true);
    }

    let duelReady = false;
    let duelWanted: 'daily' | 'train' = 'daily';
    function duelView(m: 'daily' | 'train') {
      duelWanted = m;
      if (!booted.duel) { booted.duel = true; initDuel(); return; }
      if (duelReady) setDuMode(m);
    }
    async function initDuel() {
      $('du-best').textContent = String(best);
      $('du-state').replaceChildren(status('On prépare les cartes…'));
      try {
        const m = await loadMarket();
        // Seules les cotes fiables entrent dans le duel (repères cohérents, moyenne du mois connue).
        pool = m.quotes.filter((q) => q.image && q.price >= 0.5 && !q.unsure && q.avg30);
      } catch { pool = []; }
      if (pool.length < 4) {
        $('du-state').replaceChildren(el('p', { class: 'muted' }, ['Les cotes sont indisponibles pour le moment. Réessaie dans un instant.']));
        return;
      }
      $('du-state').replaceChildren();
      $('du-a').addEventListener('click', () => choose('a'));
      $('du-b').addEventListener('click', () => choose('b'));
      $('du-next').addEventListener('click', () => (duMode === 'train' ? nextTrain() : (location.hash = '#entrainement-duel')));
      $('du-claim').addEventListener('click', () => {
        const d = getDaily();
        if (!d?.ok || d.claimed || !pair) return;
        const cheap = pair[0].price <= pair[1].price ? pair[0] : pair[1];
        if (!addItem({ cardId: cheap.id, lang: cheap.lang, name: cheap.name, image: cheap.image, setName: cheap.setName, rarity: cheap.rarity, condition: 'NM', finish: 'normal', quantity: 1 })) { toast('Cette carte est déjà dans ton classeur.'); renderReward(d); return; }
        const nd = { ...d, claimed: true };
        saveDaily(nd);
        renderReward(nd);
        refreshStatus();
        toast(`${cheap.name} rejoint ton classeur !`);
      });
      document.addEventListener('keydown', (e) => {
        if ($('mode-duel').hidden) return;
        const tag = (e.target as HTMLElement)?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA') return;
        if (e.key === 'ArrowLeft') choose('a');
        else if (e.key === 'ArrowRight') choose('b');
        else if ((e.key === 'Enter' || e.key === ' ') && answered && duMode === 'train' && document.activeElement?.id !== 'du-next') { e.preventDefault(); nextTrain(); }
      });
      duelReady = true;
      setDuMode(duelWanted);
    }

    show(fromHash());
  </script>

