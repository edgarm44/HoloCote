    .focus-ring { position: absolute; z-index: 4; width: 70px; height: 70px; margin: -35px 0 0 -35px; border: 2px solid var(--gold); border-radius: 12px; pointer-events: none; }
    .focus-ring.go { animation: focus 0.8s ease-out forwards; }
    @keyframes focus { 0% { transform: scale(1.5); opacity: 0; } 25% { transform: scale(1); opacity: 1; } 80% { opacity: 1; } 100% { opacity: 0; } }
    .flash { position: absolute; inset: 0; z-index: 5; background: #fff; opacity: 0; pointer-events: none; }
