    .h-strip :global(.h-item img), .h-strip :global(.h-ph) { width: 96px; aspect-ratio: 245 / 342; border-radius: 6px; object-fit: cover; background: var(--surface-2); display: block; transition: transform 0.2s; }
    .h-strip :global(.h-item:hover img) { transform: translateY(-3px); }
