---
import Base from '../layouts/Base.astro';
import { CONDITIONS } from '../lib/condition';
---
<Base title="Scanner" active="scanner" description="Scanne ta carte pour retrouver sa cote et l'ajouter à ta collection.">
  <section class="sc-hero">
    <h1>Pose ta carte.<br />On lit tout.</h1>
    <p class="sc-lead">Nom, PV, numéro, illustration : en quelques secondes, le scanner reconnaît ta carte parmi des milliers et affiche sa cote du jour. Rien n'est envoyé, tout se passe dans ton téléphone.</p>
    <ol class="steps" id="steps" aria-label="Étapes du scan">
      <li data-step="1" class="on"><span class="st-n">1</span><span>Vise</span></li>
      <li data-step="2"><span class="st-n">2</span><span>Lecture</span></li>
      <li data-step="3"><span class="st-n">3</span><span>Vérifie</span></li>
      <li data-step="4"><span class="st-n">4</span><span>Range</span></li>
    </ol>
  </section>

  <div class="layout">
    <div class="panel capture">
      <div class="viewer" id="viewer">
        <video id="video" playsinline muted hidden></video>
        <img id="preview" alt="Ta photo" hidden />
        <div class="guide" id="guide" hidden><span></span><i class="g-prog" id="g-prog"></i></div>
        <span class="focus-ring" id="focus-ring" hidden></span>
        <div class="flash" id="flash" aria-hidden="true"></div>
        <button type="button" class="tap-play" id="tap-play" hidden>Touche ici pour lancer la caméra</button>
        <div class="cam-loading" id="cam-loading" hidden><div class="spinner"></div><span>Ouverture de la caméra…</span></div>
        <div class="cam-tools" id="cam-tools" hidden>
          <button type="button" id="torch-btn" hidden aria-pressed="false" aria-label="Lampe">
            <svg viewBox="0 0 24 24"><path d="M7 2h10l-2 6H9L7 2zM9 8h6v12a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2V8zM12 12v3" /></svg>
          </button>
          <button type="button" id="zoom-btn" hidden aria-label="Zoom">×1</button>
          <button type="button" id="switch-btn" hidden aria-label="Changer d'objectif">
            <svg viewBox="0 0 24 24"><path d="M4 7h3l2-2h6l2 2h3v12H4zM9 13a3 3 0 0 0 5.2 2M15 13a3 3 0 0 0-5.2-2M14 15h1v1M10 11H9v-1" /></svg>
          </button>
        </div>
        <div class="idle" id="idle">
          <p><strong>Vise ta carte</strong></p>
          <p class="muted small">Elle doit remplir le cadre</p>
        </div>
      </div>
      <div class="cam-hint" id="cam-hint" hidden></div>
      <div class="cam-error" id="cam-error" hidden role="alert">
        <p class="ce-title">La caméra ne s'est pas ouverte</p>
        <p class="muted small" id="cam-error-text"></p>
        <div class="ce-actions">
          <button type="button" class="btn btn-primary" id="cam-retry">Réessayer</button>
          <label class="btn" for="snap">Prendre une photo avec l'appareil</label>
        </div>
      </div>
      <div class="actions">
        <button class="btn btn-primary" id="cam-btn" type="button">Ouvrir la caméra</button>
        <button class="btn btn-primary" id="shoot-btn" type="button" hidden>Scanner</button>
        <label class="btn snap-btn" for="snap">Prendre une photo</label>
        <label class="btn" for="photo">Choisir une photo</label>
        <input id="snap" type="file" accept="image/*" capture="environment" class="sr-only" />
        <input id="photo" type="file" accept="image/*" class="sr-only" />
      </div>
      <label class="auto" id="auto-wrap" hidden>
        <input type="checkbox" id="auto-scan" checked />
        <span>Scan automatique quand l'image est nette et stable</span>
      </label>
      <p class="muted small">L'image est analysée sur ton appareil : elle n'est jamais envoyée ni enregistrée. Touche l'image pour faire la mise au point.</p>
      <div id="progress" hidden>
        <div class="bar"><span id="progress-fill"></span></div>
        <p id="progress-label" class="muted small"></p>
      </div>
    </div>

    <div class="panel reading">
      <h2>Lecture</h2>
      <form id="manual" class="manual">
        <div class="field">
          <label for="name">Nom lu</label>
          <input id="name" type="text" placeholder="Nom de la carte" autocomplete="off" />
        </div>
        <div class="field num">
          <label for="number">Numéro</label>
          <input id="number" type="text" placeholder="136/198" inputmode="numeric" autocomplete="off" />
        </div>
        <button class="btn" type="submit">Relancer la recherche</button>
      </form>
      <p class="muted small" id="hp-line"></p>
      <p class="muted small">Le numéro est imprimé en bas de la carte. S'il est bien lu, la bonne carte sort presque toujours en premier. Corrige-le si besoin.</p>
    </div>
  </div>

  <section id="confirm" class="panel confirm" hidden aria-live="polite">
    <div class="confirm-visual" data-slot="visual"></div>
    <div class="confirm-info">
      <p class="muted small" data-slot="set"></p>
      <h2 data-slot="name"></h2>
      <div class="badges" data-slot="badges"></div>
      <p class="confirm-price" data-slot="price"></p>
      <p class="muted small" data-slot="price-note"></p>

      <form data-slot="form" class="confirm-form">
        <p class="ask">C'est bien ta carte ? Ajoute-la à ta collection.</p>
        <div class="row">
          <div class="field" data-slot="finish-field">
            <label for="finish">Finition</label>
            <select id="finish">
              <option value="normal">Normale</option>
              <option value="reverse">Reverse holo</option>
            </select>
          </div>
          <div class="field">
            <label for="condition">État</label>
            <select id="condition">
              {CONDITIONS.map((c) => <option value={c.code} selected={c.code === 'NM'}>{c.label} — {c.hint}</option>)}
            </select>
          </div>
          <div class="field qty">
            <label for="qty">Quantité</label>
            <input id="qty" type="number" min="1" max="999" value="1" inputmode="numeric" />
          </div>
        </div>
        <p class="muted small" data-slot="estimate"></p>
        <div class="confirm-actions">
          <button class="btn btn-primary" type="submit">Ajouter à ma collection</button>
          <button class="btn" type="button" data-slot="not-mine">Ce n'est pas ma carte</button>
          <a class="btn" data-slot="details">Voir la fiche</a>
        </div>
      </form>
      <div data-slot="done" class="done" hidden>
        <p><strong>Ajoutée à ta collection.</strong></p>
        <div class="confirm-actions">
          <button class="btn btn-primary" type="button" data-slot="again">Scanner une autre carte</button>
          <a class="btn" data-slot="to-collection">Voir ma collection</a>
        </div>
      </div>
    </div>
  </section>

  <section class="history" id="history" hidden>
    <div class="h-head">
      <h2>Tes derniers scans</h2>
      <button type="button" class="link-btn" id="history-clear">Effacer</button>
    </div>
    <div class="h-strip" id="history-list"></div>
  </section>

  <section aria-live="polite" class="candidates">
    <h2 id="cand-title" hidden>Est-ce une de ces cartes ?</h2>
    <p id="cand-note" class="notice" hidden>Touche ta carte pour la vérifier et l'ajouter à ta collection.</p>
    <div id="cand" class="grid"></div>
    <div id="cand-state"></div>
  </section>

  <section class="tips">
    <h2 class="tips-title">4 réflexes pour un scan parfait</h2>
    <div class="tips-grid">
      <div class="tip"><span class="tip-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg></span><h3>De la lumière</h3><p>Près d'une fenêtre ou avec la lampe du téléphone. Le numéro en bas de la carte doit être lisible.</p></div>
      <div class="tip"><span class="tip-ic"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M5 17h14" /></svg></span><h3>Bien à plat</h3><p>Pose la carte sur une table et tiens le téléphone parallèle, juste au-dessus.</p></div>
      <div class="tip"><span class="tip-ic"><svg viewBox="0 0 24 24"><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3" /></svg></span><h3>Remplis le cadre</h3><p>La carte doit toucher les bords du cadre. Trop loin, le texte devient illisible.</p></div>
      <div class="tip"><span class="tip-ic"><svg viewBox="0 0 24 24"><path d="M3 3l18 18M10.6 5.1A8 8 0 0 1 20 12a8 8 0 0 1-1.3 4.4M6.3 6.3A8 8 0 0 0 12 20a8 8 0 0 0 4.4-1.3" /></svg></span><h3>Zéro reflet</h3><p>Les cartes holo brillent : incline-les légèrement jusqu'à ce que le reflet disparaisse.</p></div>
    </div>
  </section>

  <script>
    import { readCard, findCandidates, parseNumber, loadImage, warmUp, preloadIndexes, detectCard, type Rect, type Candidate, type ScanReading } from '../lib/scan';
    import { getCard, priceFor, hasReverse, formatPrice, formatDate, type Card, type Finish } from '../lib/tcgdex';
    import { rarityTier, tierLabel, valueBadge, USD_TO_EUR } from '../lib/rarity';
    import { conditionFactor, type Condition } from '../lib/condition';
    import { addItem } from '../lib/collection';
    import { holoCard, status, el, toast, url } from '../lib/ui';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const video = $<HTMLVideoElement>('video');
    const viewer = $('viewer');
    const guide = $('guide');
    const idle = $('idle');
    const preview = $<HTMLImageElement>('preview');
    const camBtn = $<HTMLButtonElement>('cam-btn');
    const shootBtn = $<HTMLButtonElement>('shoot-btn');
    const photo = $<HTMLInputElement>('photo');
    const progress = $('progress');
    const fill = $('progress-fill');
    const plabel = $('progress-label');
    const nameIn = $<HTMLInputElement>('name');
    const numIn = $<HTMLInputElement>('number');
    const hpLine = $('hp-line');
    const manual = $<HTMLFormElement>('manual');
    const cand = $('cand');
    const candState = $('cand-state');
    const candTitle = $('cand-title');
    const candNote = $('cand-note');
    const confirmBox = $('confirm');
    const slot = (n: string) => confirmBox.querySelector(`[data-slot="${n}"]`) as HTMLElement;

    let stream: MediaStream | null = null;
    let busy = false;
    let previewUrl: string | null = null;
    let lastReading: Pick<ScanReading, 'hp' | 'art'> = {};

    warmUp();
    preloadIndexes();

    const onProgress = (p: number, label: string) => {
      progress.hidden = false;
      fill.style.width = `${Math.round(p * 100)}%`;
      plabel.textContent = label;
    };

    const quality = (s: number) => (s >= 0.85 ? 'Correspondance forte' : s >= 0.6 ? 'Correspondance probable' : 'Correspondance faible');

    /* ---------- Confirmation et ajout ---------- */

    let current: { card: Card; lang: 'fr' | 'en' } | null = null;
    const finishSel = $<HTMLSelectElement>('finish');
    const condSel = $<HTMLSelectElement>('condition');
    const qtyIn = $<HTMLInputElement>('qty');

    function refreshPrice() {
      if (!current) return;
      const finish = finishSel.value as Finish;
      const p = priceFor(current.card, finish);
      const eur = p ? (p.unit === 'EUR' ? p.value : p.value * USD_TO_EUR) : null;
      const vb = valueBadge(eur);
      const tier = rarityTier(current.card.rarity);
      slot('badges').replaceChildren(
        el('span', { class: `badge tier-${tier}` }, [current.card.rarity ?? tierLabel[tier]]),
        el('span', { class: `badge value-${vb.level}` }, [vb.label]),
      );
      if (p) {
        slot('price').textContent = formatPrice(p.value, p.unit);
        const d = formatDate(p.updated);
        slot('price-note').textContent = `Cote ${finish === 'reverse' ? 'reverse holo ' : ''}indicative${d ? ` du ${d}` : ''}, source ${p.source}${p.unit === 'USD' ? ' (marché américain)' : ''}.`;
        const q = Math.max(1, Math.min(999, Number(qtyIn.value) || 1));
        slot('estimate').textContent = `Valeur estimée : ${formatPrice(p.value * conditionFactor(condSel.value as Condition) * q, p.unit)}`;
      } else {
        slot('price').textContent = 'Pas de cote';
        slot('price-note').textContent = "Aucune vente récente connue pour cette carte.";
        slot('estimate').textContent = '';
      }
    }

    async function openConfirm(c: Candidate) {
      autoScan.checked = false; // une carte est proposée : on arrête le déclenchement automatique
      let card = c.card ?? null;
      if (!card) {
        confirmBox.hidden = false;
        slot('visual').replaceChildren(status('Chargement…'));
        card = await getCard(c.id, c.lang).catch(() => null);
      }
      if (!card) { toast('Impossible de charger cette carte'); confirmBox.hidden = true; return; }
      current = { card, lang: c.lang };
      setStep(3);
      pushHist({ id: card.id, lang: c.lang, name: card.name, image: card.image, at: Date.now() });
      slot('visual').replaceChildren(holoCard(card.image, card.name, 'high'));
      slot('name').textContent = card.name;
      const off = card.set?.cardCount?.official;
      slot('set').textContent = `${quality(c.score)} · ${card.set?.name ?? ''} · N° ${card.localId}${off ? `/${off}` : ''} · ${c.lang.toUpperCase()}`;
      const rev = hasReverse(card);
      slot('finish-field').hidden = !rev;
      finishSel.value = 'normal';
      condSel.value = 'NM';
      qtyIn.value = '1';
      (slot('details') as HTMLAnchorElement).href = url(`/carte/?id=${encodeURIComponent(card.id)}&lang=${c.lang}`);
      slot('form').hidden = false;
      slot('done').hidden = true;
      refreshPrice();
      confirmBox.hidden = false;
      confirmBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    [finishSel, condSel].forEach((s) => s.addEventListener('change', refreshPrice));
    qtyIn.addEventListener('input', refreshPrice);

    slot('form').addEventListener('submit', (e) => {
      e.preventDefault();
      if (!current) return;
      const { card, lang } = current;
      addItem({
        cardId: card.id,
        lang,
        name: card.name,
        image: card.image,
        setName: card.set?.name,
        rarity: card.rarity,
        condition: condSel.value as Condition,
        finish: finishSel.value as Finish,
        quantity: Number(qtyIn.value) || 1,
      });
      slot('form').hidden = true;
      slot('done').hidden = false;
      setStep(4);
      toast(`${card.name} ajoutée à ta collection`);
    });
    slot('not-mine').addEventListener('click', () => {
      confirmBox.hidden = true;
      cand.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    slot('again').addEventListener('click', () => {
      confirmBox.hidden = true;
      cand.replaceChildren();
      candTitle.hidden = candNote.hidden = true;
      window.scrollTo({ top: 0, behavior: 'smooth' });
      autoScan.checked = true;
      setStep(1);
      if (!stream) openCamera();
    });
    (slot('to-collection') as HTMLAnchorElement).href = url('/collection/');

    /* ---------- Recherche des candidats ---------- */

    function candidateTile(c: Candidate): HTMLElement {
      const btn = el('button', { type: 'button', class: 'tile tile-btn' }, [
        holoCard(c.image, c.name),
        el('span', { class: 'tile-name' }, [c.name]),
        el('span', { class: 'tile-meta' }, [`${quality(c.score)} · ${c.lang.toUpperCase()} · N° ${c.localId}${c.setName ? ` · ${c.setName}` : ''}`]),
      ]);
      btn.addEventListener('click', () => openConfirm(c));
      return btn;
    }

    async function search(name: string, numberText: string) {
      const { number, total } = parseNumber(numberText);
      cand.replaceChildren();
      confirmBox.hidden = true;
      candTitle.hidden = candNote.hidden = true;
      candState.replaceChildren(status('Recherche des cartes correspondantes…'));
      try {
        const list = await findCandidates({ name, number, total, ...lastReading });
        candState.replaceChildren();
        if (!list.length) {
          candState.replaceChildren(
            el('div', { class: 'panel' }, [
              el('p', {}, ['Aucune carte trouvée.']),
              el('p', { class: 'muted small' }, ['Corrige le nom ou le numéro ci-dessus, ou recommence avec plus de lumière.']),
            ]),
          );
          return;
        }
        if (list[0].score >= 0.85) {
          nameIn.value = list[0].name;
          if (!numIn.value && number) numIn.value = number;
        }
        candTitle.hidden = candNote.hidden = false;
        cand.replaceChildren(...list.map(candidateTile));
        // Correspondance nette : on propose directement l'ajout de la meilleure carte.
        if (list[0].score >= 0.85 && (list.length === 1 || list[0].score - list[1].score >= 0.08)) openConfirm(list[0]);
      } catch {
        candState.replaceChildren(status('Impossible de joindre la base de cartes. Réessaie dans un instant.', false));
      }
    }

    async function analyse(src: ImageBitmap | HTMLImageElement | HTMLCanvasElement | HTMLCanvasElement[], rect?: Rect | Rect[][]) {
      if (busy) return;
      busy = true;
      shootBtn.disabled = true;
      cand.replaceChildren();
      candState.replaceChildren();
      confirmBox.hidden = true;
      candTitle.hidden = candNote.hidden = true;
      try {
        setStep(2);
        onProgress(0, 'Lecture de la carte…');
        const r = await readCard(src, onProgress, rect);
        progress.hidden = true;
        lastReading = { hp: r.hp, art: r.art };
        nameIn.value = r.name;
        numIn.value = r.number ? `${r.number}${r.total ? `/${r.total}` : ''}` : '';
        hpLine.textContent = r.hp ? `PV lus : ${r.hp}` : '';
        if (!r.name && !r.number) {
          candState.replaceChildren(
            el('div', { class: 'panel' }, [
              el('p', {}, ["Je n'arrive pas à lire la carte."]),
              el('p', { class: 'muted small' }, ['Rapproche-toi pour que la carte remplisse le cadre, évite les reflets, ou tape le nom ci-dessus.']),
            ]),
          );
          return;
        }
        await search(r.name, numIn.value);
      } catch {
        progress.hidden = true;
        candState.replaceChildren(status("Le scanner n'a pas pu démarrer. Tape le nom à la place.", false));
      } finally {
        busy = false;
        shootBtn.disabled = false;
      }
    }


    /* ---------- Étapes et historique ---------- */
    const stepEls = [...document.querySelectorAll<HTMLElement>('#steps li')];
    function setStep(n: number) {
      stepEls.forEach((li) => {
        const k = Number(li.dataset.step);
        li.classList.toggle('on', k === n);
        li.classList.toggle('done', k < n);
      });
    }
    const HIST_KEY = 'holocote.scans.v1';
    type Scan = { id: string; lang: 'fr' | 'en'; name: string; image?: string; at: number };
    const readHist = (): Scan[] => { try { const v = JSON.parse(localStorage.getItem(HIST_KEY) ?? '[]'); return Array.isArray(v) ? v.slice(0, 12) : []; } catch { return []; } };
    function pushHist(x: Scan) {
      const list = [x, ...readHist().filter((h) => !(h.id === x.id && h.lang === x.lang))].slice(0, 12);
      try { localStorage.setItem(HIST_KEY, JSON.stringify(list)); } catch { /* rien */ }
      renderHist();
    }
    function renderHist() {
      const list = readHist();
      $('history').hidden = !list.length;
      $('history-list').replaceChildren(...list.map((h) => {
        const b = el('button', { type: 'button', class: 'h-item', title: h.name }, [
          h.image ? el('img', { src: `${h.image}/low.webp`, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' }) : el('span', { class: 'h-ph' }),
          el('span', { class: 'h-name' }, [h.name]),
        ]);
        b.addEventListener('click', () => openConfirm({ id: h.id, localId: '', name: h.name, image: h.image, lang: h.lang, score: 1 }));
        return b;
      }));
    }
    $('history-clear').addEventListener('click', () => { try { localStorage.removeItem(HIST_KEY); } catch { /* rien */ } renderHist(); });
    renderHist();

    /* ---------- Caméra ---------- */
    // Ouverture robuste : plusieurs essais de réglages, messages d'erreur précis, reprise automatique,
    // mise au point au toucher, lampe, zoom, rafale recadrée sur la carte (légère en mémoire).

    const camHint = $('cam-hint');
    const camTools = $('cam-tools');
    const camError = $('cam-error');
    const camLoading = $('cam-loading');
    const tapPlay = $<HTMLButtonElement>('tap-play');
    const focusRing = $('focus-ring');
    const flash = $('flash');
    const gProg = $('g-prog');
    const torchBtn = $<HTMLButtonElement>('torch-btn');
    const zoomBtn = $<HTMLButtonElement>('zoom-btn');
    const switchBtn = $<HTMLButtonElement>('switch-btn');
    const autoWrap = $('auto-wrap');
    const autoScan = $<HTMLInputElement>('auto-scan');
    let deviceIds: string[] = [];
    let deviceIdx = 0;
    let loopTimer = 0;
    let stableSince = 0;
    let blurSince = 0;
    let lastSig: Float32Array | null = null;
    let sharpMax = 0;
    let opening = false;
    let resumeOnShow = false;
    let lastShot = 0;

    type Caps = MediaTrackCapabilities & { torch?: boolean; zoom?: { min: number; max: number; step?: number }; focusMode?: string[] };
    const track = () => stream?.getVideoTracks()[0];
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    try { autoScan.checked = localStorage.getItem('holocote.autoscan') !== '0'; } catch { /* rien */ }
    autoScan.addEventListener('change', () => { try { localStorage.setItem('holocote.autoscan', autoScan.checked ? '1' : '0'); } catch { /* rien */ } });

    /** Message clair selon la cause de l'échec. */
    function cameraMessage(e: unknown): string {
      const name = (e as { name?: string })?.name ?? '';
      const ua = navigator.userAgent;
      if (!window.isSecureContext) return "La caméra n'est disponible que sur une adresse sécurisée (https).";
      if (!navigator.mediaDevices?.getUserMedia) {
        if (/Instagram|FBAN|FBAV|Snapchat|TikTok|musical_ly|Line\/|Discord|wv\)/i.test(ua))
          return "Le navigateur intégré de cette appli bloque la caméra. Ouvre le site dans Safari ou Chrome (menu ⋯ puis « Ouvrir dans le navigateur »), ou prends une photo avec l'appareil.";
        return "Ce navigateur ne donne pas accès à la caméra. Mets-le à jour ou essaie Chrome, Safari ou Firefox, ou prends une photo avec l'appareil.";
      }
      if (name === 'NotAllowedError' || name === 'PermissionDeniedError' || name === 'SecurityError') {
        return /iPhone|iPad|iPod/i.test(ua)
          ? "L'accès à la caméra a été refusé. Touche « aA » dans la barre d'adresse, puis Réglages du site web > Appareil photo > Autoriser, et réessaie."
          : "L'accès à la caméra a été refusé. Touche le cadenas à gauche de l'adresse, autorise la caméra pour ce site, puis réessaie.";
      }
      if (name === 'NotFoundError' || name === 'DevicesNotFoundError' || name === 'OverconstrainedError') return 'Aucune caméra utilisable n\'a été trouvée sur cet appareil.';
      if (name === 'NotReadableError' || name === 'TrackStartError' || name === 'AbortError')
        return "La caméra est déjà utilisée par une autre appli (appareil photo, appel vidéo…). Ferme-la, puis réessaie.";
      return `La caméra n'a pas pu démarrer${name ? ` (${name})` : ''}. Réessaie, ou prends une photo avec l'appareil.`;
    }
    function showCamError(e: unknown) {
      $('cam-error-text').textContent = cameraMessage(e);
      camError.hidden = false;
    }

    /** Caméras arrière, la principale d'abord (on évite ultra grand-angle, téléobjectif et caméras de profondeur). */
    async function backCameras(): Promise<string[]> {
      const devs = (await navigator.mediaDevices.enumerateDevices()).filter((d) => d.kind === 'videoinput' && d.deviceId);
      const back = devs.filter((d) => /back|rear|arri|environment|trás|posterior|world/i.test(d.label));
      const list = back.length ? back : devs;
      const score = (l: string) => (/triple|dual(?! wide)/i.test(l) ? -1 : /ultra|wide|0[.,]5|tele|zoom|macro|depth|profondeur|infrared|ir\b/i.test(l) ? 1 : 0);
      return list.sort((a, b) => score(a.label) - score(b.label)).map((d) => d.deviceId);
    }

    /** Demande un flux vidéo en assouplissant les exigences à chaque échec. */
    async function getStream(deviceId?: string): Promise<MediaStream> {
      const base = deviceId ? { deviceId: { exact: deviceId } } : { facingMode: { ideal: 'environment' } };
      const tries: (MediaTrackConstraints | true)[] = [
        { ...base, width: { ideal: 2560 }, height: { ideal: 1440 }, frameRate: { ideal: 30, max: 30 } },
        { ...base, width: { ideal: 1920 }, height: { ideal: 1080 } },
        { ...base },
        ...(deviceId ? [] : [true as const]),
      ];
      let last: unknown;
      for (const video_ of tries) {
        try {
          return await navigator.mediaDevices.getUserMedia({ video: video_, audio: false });
        } catch (e) {
          last = e;
          const n = (e as { name?: string }).name;
          if (n === 'NotAllowedError' || n === 'PermissionDeniedError' || n === 'SecurityError') throw e;
          await wait(120);
        }
      }
      throw last;
    }

    async function start(deviceId?: string) {
      stopStream();
      await wait(80); // certains Android refusent un nouveau flux tant que l'ancien n'est pas libéré
      stream = await getStream(deviceId);
      const t = track();
      t?.addEventListener('ended', () => {
        if (!stream) return;
        closeCamera();
        showCamError({ name: 'NotReadableError' });
      });
      video.muted = true;
      video.setAttribute('playsinline', '');
      video.setAttribute('autoplay', '');
      video.srcObject = stream;
      video.hidden = false;
      await new Promise<void>((res) => {
        if (video.readyState >= 1) return res();
        video.addEventListener('loadedmetadata', () => res(), { once: true });
        setTimeout(res, 4000);
      });
      try {
        await video.play();
        tapPlay.hidden = true;
      } catch {
        // Lecture bloquée (mode économie d'énergie, réglage du navigateur) : un toucher suffit.
        tapPlay.hidden = false;
      }
      for (let i = 0; i < 40 && !video.videoWidth; i++) await wait(50);
      await tuneTrack();
    }
    tapPlay.addEventListener('click', async () => { try { await video.play(); tapPlay.hidden = true; } catch { /* rien */ } });

    function stopStream() {
      stream?.getTracks().forEach((t) => t.stop());
      stream = null;
    }

    /** Mise au point, exposition et balance des blancs automatiques ; lampe et zoom si disponibles. */
    async function tuneTrack() {
      const t = track();
      if (!t) return;
      const caps = (t.getCapabilities?.() ?? {}) as Caps & { exposureMode?: string[]; whiteBalanceMode?: string[] };
      const advanced: Record<string, unknown>[] = [];
      if (caps.focusMode?.includes('continuous')) advanced.push({ focusMode: 'continuous' });
      if (caps.exposureMode?.includes('continuous')) advanced.push({ exposureMode: 'continuous' });
      if (caps.whiteBalanceMode?.includes('continuous')) advanced.push({ whiteBalanceMode: 'continuous' });
      for (const a of advanced) await t.applyConstraints({ advanced: [a] } as MediaTrackConstraints).catch(() => {});
      torchBtn.hidden = !caps.torch;
      torchBtn.setAttribute('aria-pressed', 'false');
      zoomBtn.hidden = !(caps.zoom && caps.zoom.max >= 1.5);
      zoomBtn.textContent = '×1';
      switchBtn.hidden = deviceIds.length < 2;
      camTools.hidden = torchBtn.hidden && zoomBtn.hidden && switchBtn.hidden;
    }

    async function openCamera() {
      if (opening) return;
      opening = true;
      camError.hidden = true;
      preview.hidden = idle.hidden = true;
      camLoading.hidden = false;
      camBtn.disabled = true;
      try {
        if (!navigator.mediaDevices?.getUserMedia) throw new Error('unsupported');
        await start();
        // Les noms des caméras ne sont lisibles qu'après autorisation : on bascule alors sur la principale.
        deviceIds = await backCameras().catch(() => []);
        const cur = track()?.getSettings().deviceId;
        const facing = track()?.getSettings().facingMode;
        if (deviceIds.length > 1 && cur && deviceIds[0] !== cur && facing !== 'user') {
          const ok = await start(deviceIds[0]).then(() => true).catch(() => false);
          if (!ok) await start();
        }
        deviceIdx = Math.max(0, deviceIds.indexOf(track()?.getSettings().deviceId ?? ''));
        switchBtn.hidden = deviceIds.length < 2;
        camTools.hidden = torchBtn.hidden && zoomBtn.hidden && switchBtn.hidden;
      } catch (e) {
        stopStream();
        video.hidden = true;
        camLoading.hidden = true;
        idle.hidden = !preview.hidden;
        camBtn.disabled = false;
        opening = false;
        showCamError(e);
        return;
      }
      camLoading.hidden = true;
      camBtn.disabled = false;
      opening = false;
      guide.hidden = shootBtn.hidden = camHint.hidden = false;
      autoWrap.hidden = false;
      camBtn.textContent = 'Fermer la caméra';
      sharpMax = 0;
      setHint('Place ta carte dans le cadre', 'info');
      startLoop();
    }

    function closeCamera() {
      window.clearInterval(loopTimer);
      stopStream();
      video.srcObject = null;
      video.hidden = guide.hidden = shootBtn.hidden = camHint.hidden = camTools.hidden = tapPlay.hidden = focusRing.hidden = true;
      autoWrap.hidden = true;
      camLoading.hidden = true;
      if (preview.hidden) idle.hidden = false;
      camBtn.textContent = 'Ouvrir la caméra';
    }

    torchBtn.addEventListener('click', async () => {
      const on = torchBtn.getAttribute('aria-pressed') !== 'true';
      const t = track();
      if (!t) return;
      const ok = await t.applyConstraints({ advanced: [{ torch: on }] } as unknown as MediaTrackConstraints).then(() => true).catch(() => false);
      if (ok) torchBtn.setAttribute('aria-pressed', String(on));
      else toast("La lampe n'a pas pu s'allumer sur cet appareil.");
    });
    async function setZoom(next: number) {
      await track()?.applyConstraints({ advanced: [{ zoom: next }] } as unknown as MediaTrackConstraints).catch(() => {});
      zoomBtn.textContent = next > 1 ? `×${Math.round(next * 10) / 10}` : '×1';
      sharpMax = 0;
    }
    zoomBtn.addEventListener('click', async () => {
      const caps = (track()?.getCapabilities?.() ?? {}) as Caps;
      if (!caps.zoom) return;
      await setZoom(zoomBtn.textContent === '×1' ? Math.min(2, caps.zoom.max) : Math.max(1, caps.zoom.min));
    });
    switchBtn.addEventListener('click', async () => {
      if (deviceIds.length < 2) return;
      deviceIdx = (deviceIdx + 1) % deviceIds.length;
      camLoading.hidden = false;
      await start(deviceIds[deviceIdx]).catch(async () => { await start().catch((e) => { closeCamera(); showCamError(e); }); });
      camLoading.hidden = true;
      sharpMax = 0;
    });

    /** Mise au point au toucher (Chrome Android) ; ailleurs, relance l'autofocus. */
    viewer.addEventListener('pointerdown', async (e) => {
      if (!stream || (e.target as HTMLElement).closest('button')) return;
      const vb = viewer.getBoundingClientRect();
      const px = e.clientX - vb.left, py = e.clientY - vb.top;
      focusRing.style.left = `${px}px`;
      focusRing.style.top = `${py}px`;
      focusRing.hidden = false;
      focusRing.classList.remove('go'); void focusRing.offsetWidth; focusRing.classList.add('go');
      setTimeout(() => { focusRing.hidden = true; }, 900);
      const t = track();
      if (!t || !video.videoWidth) return;
      const vw = video.videoWidth, vh = video.videoHeight;
      const scale = Math.max(vb.width / vw, vb.height / vh);
      const x = (px - (vb.width - vw * scale) / 2) / scale / vw, y = (py - (vb.height - vh * scale) / 2) / scale / vh;
      const caps = (t.getCapabilities?.() ?? {}) as Caps;
      const pt = { x: Math.min(1, Math.max(0, x)), y: Math.min(1, Math.max(0, y)) };
      const single = caps.focusMode?.includes('single-shot') ? 'single-shot' : caps.focusMode?.includes('continuous') ? 'continuous' : null;
      await t.applyConstraints({ advanced: [{ pointsOfInterest: [pt], ...(single ? { focusMode: single } : {}) }] } as unknown as MediaTrackConstraints).catch(() => {});
      sharpMax = 0;
      if (single === 'single-shot') setTimeout(() => { t.applyConstraints({ advanced: [{ focusMode: 'continuous' }] } as unknown as MediaTrackConstraints).catch(() => {}); }, 2500);
    });

    function guideRect(): Rect {
      const vb = viewer.getBoundingClientRect();
      const gb = guide.getBoundingClientRect();
      const vw = video.videoWidth, vh = video.videoHeight;
      const scale = Math.max(vb.width / vw, vb.height / vh);
      const ox = (vb.width - vw * scale) / 2, oy = (vb.height - vh * scale) / 2;
      return { x: (gb.left - vb.left - ox) / scale, y: (gb.top - vb.top - oy) / scale, w: gb.width / scale, h: gb.height / scale };
    }

    /** Image recadrée autour du cadre (+ marge), limitée en taille : rapide et léger en mémoire. */
    function grabCrop(r: Rect, margin = 0.12) {
      const vw = video.videoWidth, vh = video.videoHeight;
      const x0 = Math.max(0, r.x - r.w * margin), y0 = Math.max(0, r.y - r.h * margin);
      const x1 = Math.min(vw, r.x + r.w * (1 + margin)), y1 = Math.min(vh, r.y + r.h * (1 + margin));
      const sw = x1 - x0, sh = y1 - y0;
      if (!(sw >= 16 && sh >= 16)) return null;
      const k = Math.min(1, 1800 / Math.max(sw, sh));
      const f = document.createElement('canvas');
      f.width = Math.round(sw * k); f.height = Math.round(sh * k);
      const ctx = f.getContext('2d')!;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(video, x0, y0, sw, sh, 0, 0, f.width, f.height);
      const inner: Rect = { x: (r.x - x0) * k, y: (r.y - y0) * k, w: r.w * k, h: r.h * k };
      return { f, inner };
    }

    /** Netteté (variance du laplacien), luminosité, reflets et petite signature de la zone du cadre. */
    const probe = document.createElement('canvas');
    function measure(src: CanvasImageSource, r: Rect) {
      const W = 160, H = Math.max(8, Math.round(160 * (r.h / r.w)));
      probe.width = W; probe.height = H;
      const ctx = probe.getContext('2d', { willReadFrequently: true })!;
      ctx.drawImage(src, r.x, r.y, r.w, r.h, 0, 0, W, H);
      const d = ctx.getImageData(0, 0, W, H).data;
      const g = new Float32Array(W * H);
      let sum = 0, hot = 0;
      for (let i = 0; i < W * H; i++) { g[i] = 0.299 * d[i * 4] + 0.587 * d[i * 4 + 1] + 0.114 * d[i * 4 + 2]; sum += g[i]; if (g[i] > 248) hot++; }
      let lapSum = 0, lapSq = 0, n = 0;
      for (let y = 1; y < H - 1; y++) for (let x = 1; x < W - 1; x++) {
        const i = y * W + x;
        const l = 4 * g[i] - g[i - 1] - g[i + 1] - g[i - W] - g[i + W];
        lapSum += l; lapSq += l * l; n++;
      }
      const sharp = lapSq / n - (lapSum / n) ** 2;
      const sig = new Float32Array(64);
      for (let by = 0; by < 8; by++) for (let bx = 0; bx < 8; bx++) {
        let s = 0, c = 0;
        for (let y = Math.floor((by * H) / 8); y < Math.floor(((by + 1) * H) / 8); y += 2)
          for (let x = Math.floor((bx * W) / 8); x < Math.floor(((bx + 1) * W) / 8); x += 2) { s += g[y * W + x]; c++; }
        sig[by * 8 + bx] = c ? s / c : 0;
      }
      // Contraste entre blocs : une table vide ou un mur donnent une image uniforme (pas de carte).
      let mean = 0; for (const v of sig) mean += v; mean /= 64;
      let dev = 0; for (const v of sig) dev += Math.abs(v - mean); dev /= 64;
      return { sharp, light: sum / (W * H), glare: hot / (W * H), detail: dev, sig };
    }

    function setHint(text: string, kind: 'warn' | 'ok' | 'info') {
      if (camHint.textContent !== text) camHint.textContent = text;
      camHint.dataset.kind = kind;
      guide.dataset.kind = kind;
    }

    /** Guidage en direct : présence de la carte, lumière, reflets, netteté, stabilité ; scan automatique. */
    function startLoop() {
      window.clearInterval(loopTimer);
      stableSince = 0;
      blurSince = 0;
      lastSig = null;
      loopTimer = window.setInterval(() => {
        gProg.style.setProperty('--p', '0');
        if (!stream || busy || !video.videoWidth || video.paused || guide.hidden) return;
        const gr = guideRect();
        if (!(gr.w > 16 && gr.h > 16)) return;
        const m = measure(video, gr);
        sharpMax = Math.max(sharpMax * 0.99, m.sharp);
        let moved = 1e9;
        if (lastSig) { moved = 0; for (let i = 0; i < 64; i++) moved += Math.abs(m.sig[i] - lastSig[i]); moved /= 64; }
        lastSig = m.sig;
        const stable = moved < 7;
        const sharpOk = m.sharp > 22 && m.sharp >= sharpMax * 0.55;
        const reset = () => { stableSince = 0; };
        if (m.light < 38) { setHint(torchBtn.hidden ? "Trop sombre : rapproche-toi d'une lampe ou d'une fenêtre" : 'Trop sombre : allume la lampe (en haut à droite)', 'warn'); return reset(); }
        if (m.glare > 0.04 || m.light > 228) { setHint('Reflet sur la carte : incline-la un peu', 'warn'); return reset(); }
        if (m.detail < 6) { setHint('Place ta carte dans le cadre', 'info'); return reset(); }
        if (!stable) { setHint('Ne bouge plus…', 'info'); return reset(); }
        if (!sharpOk) {
          if (!blurSince) blurSince = performance.now();
          const long = performance.now() - blurSince > 2500;
          setHint(long && !zoomBtn.hidden && zoomBtn.textContent === '×1' ? 'Toujours flou : recule le téléphone et touche ×2' : long ? "Toujours flou : recule un peu et touche l'image pour la mise au point" : 'Mise au point…', 'warn');
          return reset();
        }
        blurSince = 0;
        if (!stableSince) stableSince = performance.now();
        const held = performance.now() - stableSince;
        if (autoScan.checked) {
          gProg.style.setProperty('--p', String(Math.min(1, held / 650)));
          setHint('Parfait, ne bouge plus…', 'ok');
          if (held > 650 && performance.now() - lastShot > 2500) { stableSince = 0; shoot(); }
        } else setHint('Image nette : appuie sur Scanner', 'ok');
      }, 200);
    }

    /** Rafale de 6 images recadrées ; on garde les 3 plus nettes. La vidéo se fige pendant la lecture. */
    async function shoot() {
      if (!stream || busy || !video.videoWidth) return;
      const rect = guideRect();
      if (!(rect.w > 16 && rect.h > 16)) return;
      lastShot = performance.now();
      const shots: { f: HTMLCanvasElement; inner: Rect; s: number }[] = [];
      for (let i = 0; i < 6; i++) {
        const c = grabCrop(rect);
        if (c) shots.push({ ...c, s: measure(c.f, c.inner).sharp });
        await wait(90);
      }
      if (!shots.length) { lastShot = 0; return; }
      navigator.vibrate?.(30);
      flash.classList.remove('go'); void flash.offsetWidth; flash.classList.add('go');
      video.pause();
      shots.sort((a, b) => b.s - a.s);
      const best = shots.slice(0, 3);
      // Deux cadrages par image : la carte détectée dans la photo (si elle est nette) et le cadre de visée.
      const jobs = best.map((x) => {
        const d = detectCard(x.f);
        const okD = d && d.w > x.inner.w * 0.7 && d.w < x.inner.w * 1.25;
        return { f: x.f, rects: okD ? [d!, x.inner] : [x.inner] };
      });
      setHint('Lecture en cours…', 'info');
      await analyse(jobs.map((j) => j.f), jobs.map((j) => j.rects));
      if (stream) { video.play().catch(() => { tapPlay.hidden = false; }); setHint('Vise une autre carte', 'info'); }
    }

    camBtn.addEventListener('click', () => (stream ? closeCamera() : openCamera()));
    $('cam-retry').addEventListener('click', () => openCamera());
    shootBtn.addEventListener('click', () => shoot());
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { resumeOnShow = !!stream; closeCamera(); }
      else if (resumeOnShow) { resumeOnShow = false; openCamera(); }
    });

    /* ---------- Photo ---------- */

    const onFile = async (input: HTMLInputElement) => {
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      closeCamera();
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(file);
      preview.src = previewUrl;
      preview.hidden = false;
      idle.hidden = true;
      try {
        const img = await loadImage(file);
        await analyse(img as ImageBitmap | HTMLImageElement);
      } catch {
        candState.replaceChildren(status("Impossible d'ouvrir cette image.", false));
      }
    };
    photo.addEventListener('change', () => onFile(photo));
    $<HTMLInputElement>('snap').addEventListener('change', (e) => onFile(e.currentTarget as HTMLInputElement));

    manual.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = nameIn.value.trim();
      if (name.length < 2 && !numIn.value.trim()) return;
      search(name, numIn.value);
    });

    window.addEventListener('pagehide', closeCamera);
  </script>

