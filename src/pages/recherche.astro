---
import Base from '../layouts/Base.astro';
import SearchPanel from '../components/SearchPanel.astro';
---
<Base title="Recherche" description="Cherche une carte par son nom, même avec une faute : rareté, cote et fiche détaillée.">
  <section class="s-hero">
    <h1>Trouve n'importe<br />quelle carte.</h1>
    <p class="lead">Même avec une faute. Tape « Dracofeu », « Pikatchu » ou « Raykaza » : HoloCote comprend.</p>
  </section>
  <SearchPanel />
  <style>
    .s-hero { padding: clamp(28px, 6vw, 64px) 0 26px; }
    .s-hero h1 { font-size: clamp(2.6rem, 8vw, 5.6rem); line-height: 0.98; letter-spacing: -0.035em; font-weight: 800; margin-bottom: 18px; }
    .lead { color: var(--muted); font-size: clamp(1.05rem, 2.2vw, 1.25rem); max-width: 620px; margin: 0; }
  </style>
</Base>
