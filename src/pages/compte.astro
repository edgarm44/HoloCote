---
import Base from '../layouts/Base.astro';
import { avatarSvg } from '../lib/avatar';
const DEF = { palette: 'holo', acc: 'none', aura: 'none', pose: 'wave', bg: 'none', pet: 'none' };
---
<Base title="Mon compte" active="account" description="Ton personnage, ton niveau, tes quêtes du jour et tes succès HoloDex. Sans e-mail, sans mot de passe : tout reste dans ton navigateur.">
  <section class="ac-hero">
    <div class="ac-stage">
      <div class="ac-avatar" id="ac-avatar" set:html={avatarSvg(DEF, 'happy', 170)} />
      <span class="ac-lvl" id="ac-lvl" aria-hidden="true">1</span>
    </div>
    <div class="ac-id">
      <p class="eyebrow" id="ac-title">Dresseur débutant</p>
      <h1><span id="ac-name">Dresseur</span></h1>
      <div class="xp" aria-live="polite">
        <div class="xp-top"><strong id="xp-level">Niveau 1</strong><span class="muted" id="xp-num">0 / 100 XP</span></div>
        <div class="xp-bar" role="progressbar" aria-label="Progression vers le niveau suivant" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="xp-bar"><i id="xp-fill"></i></div>
        <p class="muted small" id="xp-next">Prochain objet à débloquer : la couleur Océan au niveau 2.</p>
      </div>
      <div class="chips">
        <a class="chip coin" href="../boutique/" id="chip-coins">0 Éclat</a>
        <a class="chip" href="#quetes" id="chip-rewards" hidden></a>
        <a class="chip gold" href="../defi/#booster" id="chip-rerolls" hidden></a>
      </div>
    </div>
  </section>

  <section class="panel ac-edit" aria-labelledby="edit-h">
    <div class="ed-head">
      <h2 id="edit-h">Ton personnage</h2>
      <p class="muted small">Monte de niveau pour débloquer de nouvelles couleurs, des accessoires et des auras.</p>
    </div>
    <form id="ac-form" class="ac-form" autocomplete="off">
      <div class="field">
        <label for="ac-pseudo">Pseudo</label>
        <input id="ac-pseudo" type="text" maxlength="20" placeholder="Ex. : Dresseur du Bourg" />
        <p class="muted small">20 caractères maximum. Choisis un surnom, pas ton vrai nom. Il s'affiche sur le site (classement compris) et n'est jamais envoyé.</p>
      </div>
      <div class="wr-tabs" id="wr-tabs" role="tablist" aria-label="Catégories du personnage"></div>
      <div id="wr-slots" class="wr-slots"></div>
      <div class="ed-actions">
        <button class="btn btn-primary" type="submit">Enregistrer</button>
        <span class="muted small" id="ed-dirty" hidden>Modifications non enregistrées</span>
      </div>
    </form>
  </section>

  <section class="panel ac-theme" aria-labelledby="th-h">
    <h2 id="th-h">Thème de couleur</h2>
    <p class="muted small">Change l’ambiance de tout le site. Ton choix reste sur cet appareil.</p>
    <div class="th-grid" id="th-grid" role="radiogroup" aria-label="Thème de couleur"></div>
  </section>

  <section class="ac-stats" aria-label="Résumé">
    <a class="tile" href="../collection/"><span class="t-v" id="t-cards">0</span><span class="t-l">cartes au classeur</span></a>
    <a class="tile" href="#succes"><span class="t-v" id="t-badges">0</span><span class="t-l">succès (+25 XP et des Éclats)</span></a>
    <a class="tile" href="../defi/#semaine"><span class="t-v" id="t-streak">0</span><span class="t-l">jours d'affilée au Défi</span></a>
    <a class="tile" href="#quetes"><span class="t-v" id="t-quests">0</span><span class="t-l">jours de quêtes terminées</span></a>
  </section>

  <section class="quests" id="quetes" aria-labelledby="q-h">
    <div class="q-head">
      <div>
        <h2 id="q-h">Quêtes du jour</h2>
        <p class="muted">Trois missions, les mêmes pour tout le monde, renouvelées à minuit. Nouvelles quêtes dans <strong id="q-next">--:--:--</strong>.</p>
      </div>
      <div class="q-score"><strong id="q-done">0</strong>/3</div>
    </div>
    <ol class="q-list" id="q-list"></ol>
    <div class="chest" id="chest">
      <button type="button" class="chest-box" id="chest-box" aria-label="Coffre du jour"><svg viewBox="0 0 120 100" aria-hidden="true"><defs><linearGradient id="chW" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a8692a"/><stop offset="1" stop-color="#5a3412"/></linearGradient><linearGradient id="chG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff3b0"/><stop offset="1" stop-color="#d99a1e"/></linearGradient></defs>
        <g class="ch-body"><rect x="12" y="46" width="96" height="46" rx="8" fill="url(#chW)" stroke="#ffd25a" stroke-width="3"/><rect x="12" y="60" width="96" height="6" fill="url(#chG)"/><rect x="52" y="54" width="16" height="20" rx="4" fill="url(#chG)" stroke="#5a3412" stroke-width="2"/><circle cx="60" cy="63" r="2.5" fill="#5a3412"/></g>
        <g class="ch-glow"><path d="M60 46 L30 0 L50 0 Z M60 46 L70 0 L90 0 Z M60 46 L104 10 L112 22 Z M60 46 L8 22 L16 10 Z" fill="#fff3b0" opacity=".55"/></g>
        <g class="ch-lid"><path d="M12 48 q0 -36 48 -36 q48 0 48 36 z" fill="url(#chW)" stroke="#ffd25a" stroke-width="3"/><path d="M14 40 h92" stroke="url(#chG)" stroke-width="5"/><rect x="52" y="34" width="16" height="12" rx="3" fill="url(#chG)"/></g></svg></button>
      <div class="chest-tx">
        <strong id="chest-title">Coffre du jour</strong>
        <span class="muted small" id="chest-t">Récupère les récompenses des 3 quêtes pour l'ouvrir.</span>
        <span class="chest-steps" id="chest-steps" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <button type="button" class="btn btn-primary" id="chest-btn" disabled>Ouvrir le coffre</button>
    </div>
    <div class="chest-fx" id="chest-fx" hidden role="dialog" aria-modal="true" aria-labelledby="fx-title">
      <div class="fx-card">
        <div class="fx-rays" aria-hidden="true"></div>
        <div class="fx-chest" id="fx-chest"><svg viewBox="0 0 120 100" aria-hidden="true"><defs><linearGradient id="chW2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a8692a"/><stop offset="1" stop-color="#5a3412"/></linearGradient><linearGradient id="chG2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff3b0"/><stop offset="1" stop-color="#d99a1e"/></linearGradient></defs>
        <g class="ch-body"><rect x="12" y="46" width="96" height="46" rx="8" fill="url(#chW2)" stroke="#ffd25a" stroke-width="3"/><rect x="12" y="60" width="96" height="6" fill="url(#chG2)"/><rect x="52" y="54" width="16" height="20" rx="4" fill="url(#chG2)" stroke="#5a3412" stroke-width="2"/><circle cx="60" cy="63" r="2.5" fill="#5a3412"/></g>
        <g class="ch-glow"><path d="M60 46 L30 0 L50 0 Z M60 46 L70 0 L90 0 Z M60 46 L104 10 L112 22 Z M60 46 L8 22 L16 10 Z" fill="#fff3b0" opacity=".55"/></g>
        <g class="ch-lid"><path d="M12 48 q0 -36 48 -36 q48 0 48 36 z" fill="url(#chW2)" stroke="#ffd25a" stroke-width="3"/><path d="M14 40 h92" stroke="url(#chG2)" stroke-width="5"/><rect x="52" y="34" width="16" height="12" rx="3" fill="url(#chG2)"/></g></svg></div>
        <h2 id="fx-title">Coffre du jour</h2>
        <div class="fx-rewards" id="fx-rewards"></div>
        <button type="button" class="btn btn-primary" id="fx-close">Super !</button>
      </div>
    </div>
    <p class="muted small q-note" id="q-note">Chaque quête réussie donne une récompense à récupérer : de l'XP, ou une relance du booster du jour pour la quête de jeu. Rien n'est vendu ni gagné en vrai.</p>
  </section>

  <section class="badges" id="succes" aria-labelledby="succes-h">
    <div class="bd-head">
      <h2 id="succes-h">Succès</h2>
      <p class="muted"><strong id="bd-count">0</strong> débloqués sur <span id="bd-total">0</span>. Remplis ton classeur, joue au Défi et fais tes quêtes pour les obtenir.</p>
    </div>
    <div class="bd-claim" id="bd-claim" hidden><span id="bd-claim-t"></span><button type="button" class="btn btn-primary" id="bd-claim-all">Tout récupérer</button></div>
    <div id="bd-groups"></div>
  </section>

  <section class="panel save" id="sauvegarde" aria-labelledby="save-h">
    <div class="sv-head">
      <div>
        <h2 id="save-h">Sauvegarder ma progression</h2>
        <p class="muted">Classeur, favoris, Défi, quêtes, succès, pseudo : tout tient dans un fichier ou un code. Garde-le précieusement, il te permet de tout retrouver sur un autre ordinateur ou après avoir effacé les données du navigateur.</p>
      </div>
      <p class="sv-last" id="sv-last" role="status">Jamais sauvegardé</p>
    </div>
    <div class="sv-cols">
      <div class="sv-col">
        <h3>Sauvegarder</h3>
        <div class="sv-actions">
          <button type="button" class="btn btn-primary" id="sv-file">Télécharger le fichier</button>
          <button type="button" class="btn" id="sv-code">Afficher mon code</button>
        </div>
        <div class="sv-out" id="sv-out" hidden>
          <label for="sv-code-out" class="muted small">Ton code de sauvegarde (copie-le dans un endroit sûr, par exemple un e-mail à toi-même ou une note) :</label>
          <textarea id="sv-code-out" rows="4" readonly spellcheck="false"></textarea>
          <button type="button" class="btn" id="sv-copy">Copier le code</button>
        </div>
      </div>
      <div class="sv-col">
        <h3>Restaurer</h3>
        <div class="sv-actions">
          <label class="btn" for="sv-in-file">Choisir un fichier</label>
          <input type="file" id="sv-in-file" accept=".json,application/json" class="sr-only" />
        </div>
        <label for="sv-in-code" class="muted small">Ou colle ton code ici :</label>
        <textarea id="sv-in-code" rows="3" spellcheck="false" placeholder="HC1-..."></textarea>
        <button type="button" class="btn" id="sv-check">Vérifier le code</button>
        <div class="sv-confirm" id="sv-confirm" hidden role="alert">
          <p id="sv-confirm-t"></p>
          <div class="sv-actions">
            <button type="button" class="btn btn-primary" id="sv-go">Remplacer par cette sauvegarde</button>
            <button type="button" class="btn" id="sv-cancel">Annuler</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <p class="notice">Ton pseudo, ton avatar, tes quêtes et tes succès sont gardés uniquement dans ce navigateur, jamais envoyés. Si tu effaces les données du site sans sauvegarde, ils disparaissent.</p>

  <script>
    import { computeBadges, claimBadge, claimAllBadges } from '../lib/badges';
    import { CHEST_XP, CHEST_COINS, todayQuests, questDays, claimQuest, chestState, openChest, rewardText, pendingRewards, rerolls, MAX_REROLLS } from '../lib/quests';
    import { streak } from '../lib/progress';
    import { countCards } from '../lib/collection';
    import { getPseudo, setPseudo } from '../lib/leaderboard';
    import { avatarSvg, getLook, setLook, getMood, SLOTS, MOODS, nextUnlock, isUnlocked, type Look } from '../lib/avatar';
    import { levelInfo } from '../lib/level';
    import { coins, fmtCoins, skins, potionActive } from '../lib/wallet';
    import type { Mood } from '../lib/mascot';
    import { msToMidnight } from '../lib/mystery';
    import { el, url, toast } from '../lib/ui';
    import { downloadBackup, backupCode, previewBackup, restoreBackup, lastBackup } from '../lib/backup';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const AV = 'holocote.avatar.v1';
    const MOOD_NAMES: Record<Mood, string> = { happy: 'Content', wink: 'Clin d’œil', wow: 'Épaté', think: 'Pensif', sad: 'Triste' };

    let lv = levelInfo();
    let draft: Look & { mood: Mood } = { ...getLook(lv.level), mood: getMood() };
    let saved = JSON.stringify(draft);

    /* ---------- Héros : personnage, niveau, XP ---------- */
    function renderHero() {
      lv = levelInfo();
      $('ac-avatar').innerHTML = avatarSvg(draft, draft.mood, 170, 'Ton personnage');
      $('ac-lvl').textContent = String(lv.level);
      $('ac-title').textContent = lv.title;
      $('xp-level').textContent = `Niveau ${lv.level}`;
      $('xp-num').textContent = lv.max ? `${lv.xp} XP · niveau maximum` : `${lv.into} / ${lv.need} XP`;
      $('xp-fill').style.width = `${Math.round(lv.pct * 100)}%`;
      $('xp-bar').setAttribute('aria-valuenow', String(Math.round(lv.pct * 100)));
      const nu = nextUnlock(lv.level);
      $('xp-next').textContent = lv.max ? 'Tu as tout débloqué. Respect.' : `${lv.need - lv.into} XP avant le niveau ${lv.level + 1}.${nu ? ` Prochain objet : ${nu.label} au niveau ${nu.lvl}.` : ''}`;
      $('chip-coins').textContent = `◆ ${fmtCoins(coins())} · Boutique`;
      const sk = skins();
      document.querySelector('.ac-hero')?.setAttribute('data-banner', sk.banner || '');
      const p = pendingRewards();
      $('chip-rewards').hidden = p === 0;
      $('chip-rewards').textContent = `${p} récompense${p > 1 ? 's' : ''} à récupérer`;
      const r = rerolls();
      $('chip-rerolls').hidden = r === 0;
      $('chip-rerolls').textContent = `${r} relance${r > 1 ? 's' : ''} du booster`;
      const p0 = getPseudo();
      $('ac-name').textContent = p0 === 'Toi' ? 'Dresseur sans nom' : p0;
    }

    /* ---------- Garde-robe ---------- */
    function option(group: string, value: string, label: string, lvl: number, preview: string, checked: boolean, shop?: number, free = true): HTMLElement {
      const locked = !free;
      const lockTxt = shop ? `${shop} ◆` : `Niv. ${lvl}`;
      const input = el('input', { type: 'radio', name: group, value, 'aria-label': locked ? (shop ? `${label}, à acheter dans la boutique` : `${label}, débloqué au niveau ${lvl}`) : label }) as HTMLInputElement;
      input.checked = checked;
      input.disabled = locked;
      const card = el('label', { class: `wr-opt ${locked ? 'locked' : ''}`, title: locked ? `Niveau ${lvl}` : label }, [
        input,
        el('span', { class: 'wr-pv' }, []),
        locked ? el('span', { class: 'wr-padlock', 'aria-hidden': 'true' }, []) : null,
        el('span', { class: 'wr-name' }, [label]),
        locked ? el('span', { class: `wr-lock ${shop ? 'shop' : ''}` }, [lockTxt]) : shop ? el('span', { class: 'wr-lock shop own' }, ['Exclusif']) : null,
      ]);
      (card.querySelector('.wr-pv') as HTMLElement).innerHTML = preview;
      const pad = card.querySelector('.wr-padlock') as HTMLElement | null;
      if (pad) pad.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2.5" fill="currentColor" fill-opacity=".18"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><circle cx="12" cy="16" r="1.3" fill="currentColor"/></svg>';
      input.addEventListener('change', () => {
        (draft as unknown as Record<string, string>)[group] = value;
        renderHero();
        renderWardrobe();
        $('ed-dirty').hidden = JSON.stringify(draft) === saved;
      });
      return card;
    }
    let wrTab = 'mood';
    function showTab(key: string) {
      wrTab = key;
      document.querySelectorAll<HTMLElement>('#wr-tabs [role=tab]').forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; });
      document.querySelectorAll<HTMLElement>('#wr-slots > fieldset').forEach((f) => { f.hidden = f.dataset.tab !== key; });
    }
    function renderWardrobe() {
      const base: Look = { palette: draft.palette, acc: draft.acc, aura: draft.aura, pose: draft.pose, bg: draft.bg, pet: draft.pet };
      const groups: { key: string; label: string; count: string; row: HTMLElement[] }[] = [
        { key: 'mood', label: 'Expression', count: '', row: MOODS.map((m) => option('mood', m, MOOD_NAMES[m], 1, avatarSvg(base, m, 48, ''), draft.mood === m)) },
        ...SLOTS.map((sl) => ({
          key: sl.key, label: sl.label,
          count: `${sl.list.filter((x) => isUnlocked(x, lv.level)).length}/${sl.list.length}`,
          row: sl.list.map((it) => option(sl.key, it.id, it.name, it.lvl, avatarSvg({ ...base, [sl.key]: it.id }, draft.mood, 48, ''), draft[sl.key] === it.id, it.shop, isUnlocked(it, lv.level))),
        })),
      ];
      if (!groups.some((g) => g.key === wrTab)) wrTab = 'mood';
      $('wr-tabs').replaceChildren(...groups.map((g) => {
        const b = el('button', { type: 'button', role: 'tab', class: 'wr-tab', 'data-tab': g.key, id: `wr-tab-${g.key}` }, [g.label, g.count ? el('span', { class: 'wr-count' }, [g.count]) : null]);
        b.addEventListener('click', () => showTab(g.key));
        b.addEventListener('keydown', (e) => {
          const i = groups.findIndex((x) => x.key === g.key);
          const n = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : -1;
          if (n < 0) return;
          e.preventDefault();
          const t = groups[(n + groups.length) % groups.length].key;
          showTab(t);
          document.getElementById(`wr-tab-${t}`)?.focus();
        });
        return b;
      }));
      $('wr-slots').replaceChildren(...groups.map((g) => el('fieldset', { class: 'wr', 'data-tab': g.key, role: 'tabpanel', 'aria-labelledby': `wr-tab-${g.key}` }, [
        el('legend', { class: 'sr-only' }, [g.label]),
        el('div', { class: 'wr-row' }, g.row),
      ])));
      showTab(wrTab);
    }

    $('ac-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = $<HTMLInputElement>('ac-pseudo').value;
      const clean = raw.replace(/[^\p{L}\p{N} _.'-]/gu, '').replace(/\s+/g, ' ').trim().slice(0, 20);
      if (raw.trim() && !clean) { toast('Utilise des lettres, des chiffres, des espaces ou - _ . \''); return; }
      setPseudo(clean);
      setLook(draft, lv.level);
      try { localStorage.setItem(AV, draft.mood); } catch { /* rien */ }
      saved = JSON.stringify(draft);
      $('ed-dirty').hidden = true;
      renderHero();
      window.dispatchEvent(new CustomEvent('holocote:progress'));
      toast(clean ? `Profil enregistré, ${clean} !` : 'Profil enregistré.');
    });

    /* ---------- Quêtes et récompenses ---------- */
    function celebrate(text: string) {
      const before = lv.level;
      toast(text);
      renderAll();
      if (lv.level > before) {
        $('ac-avatar').classList.remove('lvlup'); void $('ac-avatar').offsetWidth; $('ac-avatar').classList.add('lvlup');
        renderWardrobe();
      } else {
        $('xp-fill').classList.remove('gain'); void $('xp-fill').offsetWidth; $('xp-fill').classList.add('gain');
      }
    }

    const QTYPE: Record<string, string> = { myst: 'game', myst3: 'game', box: 'game', duel: 'game', play2: 'game', add: 'coll', fav: 'coll', cards3: 'look', market: 'look', deals: 'look', rank: 'look', scan: 'coll' };
    const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
    const QICON: Record<string, string> = {
      myst: svg('<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .8-1 1.5M12 17v.01"/>'),
      myst3: svg('<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>'),
      box: svg('<rect x="6" y="3" width="12" height="18" rx="2"/><path d="M6 7h12M9 3v4M15 3v4"/>'),
      duel: svg('<path d="M5 19l6-14M19 19l-6-14M4 11h16"/>'),
      play2: svg('<rect x="3" y="7" width="18" height="11" rx="3"/><path d="M8 12v3M6.5 13.5h3M16 12.5v.01M18 14.5v.01"/>'),
      add: svg('<rect x="5" y="3" width="12" height="17" rx="2"/><path d="M19 8v13H9M11 8v6M8 11h6"/>'),
      fav: svg('<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>'),
      cards3: svg('<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.5-4.5"/>'),
      market: svg('<path d="M3 17l6-6 4 4 8-8M15 7h6v6"/>'),
      deals: svg('<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/>'),
      rank: svg('<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3"/>'),
      scan: svg('<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16"/>'),
      star: svg('<path d="M12 3l2.5 6 6.5.5-5 4.3 1.6 6.4L12 16.8 6.4 20.2 8 13.8 3 9.5 9.5 9z"/>'),
      done: svg('<path d="M5 12.5l4.5 4.5L19 7.5"/>'),
      ok: svg('<path d="M4 12l5 5L20 6"/><path d="M12 3l1 2M19 6l-1.5 1.5" opacity=".6"/>'),
    };

    function renderQuests() {
      const q = todayQuests();
      $('q-done').textContent = String(q.filter((x) => x.done).length);
      $('q-list').replaceChildren(...q.map((x, i) => {
        let action: HTMLElement;
        if (x.claimed) action = el('span', { class: 'q-ok' }, ['Récupéré']);
        else if (x.done) {
          action = el('button', { type: 'button', class: 'btn btn-primary q-claim' }, [`Récupérer : ${rewardText(x.reward)}`]);
          action.addEventListener('click', () => {
            const r = claimQuest(x.id);
            if (!r) { renderAll(); return; }
            celebrate(`${r.reroll ? 'Relance du booster, ' : r.full ? `Réserve de relances pleine (${MAX_REROLLS}) : ` : ''}+${r.xp} XP et +${r.coins} Éclats !`);
          });
        } else action = el('a', { class: 'btn q-go', href: url(x.href) }, ['Y aller']);
        const pct = Math.round((x.value / x.goal) * 100);
        const ico = el('span', { class: `q-ico t-${QTYPE[x.id] ?? 'game'}`, 'aria-hidden': 'true' }, []);
        ico.innerHTML = x.claimed ? QICON.ok : x.done ? QICON.done : (QICON[x.id] ?? QICON.star);
        const chips = [
          el('span', { class: 'q-chip xp' }, [`+${potionActive() ? x.reward.xp * 2 : x.reward.xp} XP`]),
          el('span', { class: 'q-chip coin' }, [`+${x.reward.coins} ◆`]),
          x.reward.reroll ? el('span', { class: 'q-chip rr' }, ['Relance du booster']) : null,
        ];
        return el('li', { class: `q ${x.done ? 'done' : ''} ${x.claimed ? 'claimed' : ''}`, style: `--p:${pct}%;--i:${i}` }, [
          ico,
          el('div', { class: 'q-tx' }, [
            el('strong', {}, [x.title]),
            el('span', { class: 'muted small' }, [x.hint]),
            el('span', { class: 'q-chips' }, chips),
            el('span', { class: 'q-bar', role: 'progressbar', 'aria-valuemin': '0', 'aria-valuemax': String(x.goal), 'aria-valuenow': String(x.value), 'aria-label': `${x.title} : ${x.value} sur ${x.goal}` }, [el('i', {}, []), el('b', {}, [`${x.value}/${x.goal}`])]),
          ]),
          action,
        ]);
      }));
      const st = chestState();
      $('chest-title').textContent = `Coffre du jour : +${CHEST_XP} XP et +${CHEST_COINS} Éclats`;
      const got = q.filter((x) => x.claimed).length;
      $('chest').className = `chest ${st}`;
      const btn = $('chest-btn') as HTMLButtonElement;
      btn.disabled = st !== 'ready';
      btn.textContent = st === 'open' ? 'Coffre ouvert' : st === 'ready' ? 'Ouvrir le coffre' : `Encore ${3 - got} récompense${3 - got > 1 ? 's' : ''}`;
      $('chest-t').textContent = st === 'open'
        ? 'Ouvert ! Un nouveau coffre t’attend demain.'
        : st === 'ready' ? 'Les 3 récompenses sont récupérées : clique sur le coffre pour l’ouvrir !'
        : `Termine les 3 quêtes du jour et clique sur « Récupérer » pour chacune (${got}/3). Le coffre s’ouvre ensuite.`;
      $('chest-steps').querySelectorAll('i').forEach((d, i) => d.classList.toggle('on', i < got));
      $('quetes').classList.toggle('all', q.every((x) => x.claimed));
    }
    const sleepMs = (ms: number) => new Promise((r) => setTimeout(r, window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : ms));
    async function tryOpenChest() {
      const st = chestState();
      if (st === 'open') { toast('Le coffre du jour est déjà ouvert. Reviens demain !'); return; }
      if (st !== 'ready') { toast('Récupère d’abord les récompenses des 3 quêtes du jour, puis ouvre le coffre.'); $('q-list').scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
      const fx = $('chest-fx');
      const box = $('fx-chest');
      $('fx-rewards').replaceChildren();
      fx.hidden = false;
      fx.className = 'chest-fx';
      ($('fx-close') as HTMLButtonElement).hidden = true;
      await sleepMs(50);
      fx.classList.add('shake');
      await sleepMs(900);
      const r = openChest();
      if (!r) { fx.hidden = true; renderAll(); return; }
      fx.classList.remove('shake'); fx.classList.add('open');
      await sleepMs(500);
      const items: [string, string][] = [[`+${r.xp}`, 'XP'], [`+${r.coins}`, 'Éclats']];
      for (const [v, l] of items) {
        $('fx-rewards').append(el('div', { class: 'fx-r' }, [el('strong', {}, [v]), el('span', {}, [l])]));
        await sleepMs(350);
      }
      ($('fx-close') as HTMLButtonElement).hidden = false;
      ($('fx-close') as HTMLButtonElement).focus();
      void box;
      celebrate(`Coffre ouvert : +${r.xp} XP et +${r.coins} Éclats !`);
    }
    $('chest-btn').addEventListener('click', tryOpenChest);
    $('chest-box').addEventListener('click', tryOpenChest);
    $('fx-close').addEventListener('click', () => { $('chest-fx').hidden = true; });
    $('chest-fx').addEventListener('keydown', (e) => { if (e.key === 'Escape') $('chest-fx').hidden = true; });

    function renderBadges() {
      const all = computeBadges();
      const got = all.filter((b) => b.got).length;
      $('bd-count').textContent = String(got);
      $('bd-total').textContent = String(all.length);
      $('t-badges').textContent = `${got}/${all.length}`;
      const open = all.filter((b) => b.got && !b.claimed);
      $('bd-claim').hidden = !open.length;
      $('bd-claim-t').textContent = `${open.length} récompense${open.length > 1 ? 's' : ''} à récupérer : ${open.reduce((t, b) => t + b.reward, 0)} Éclats.`;
      const groups = [...new Set(all.map((b) => b.group))];
      $('bd-groups').replaceChildren(...groups.map((g) => el('div', { class: 'bd-group' }, [
        el('h3', {}, [g]),
        el('ul', { class: 'bd-grid' }, all.filter((b) => b.group === g).map((b) => el('li', { class: `bd ${b.got ? 'got' : ''}`, title: b.got ? 'Débloqué' : 'À débloquer' }, [
          el('span', { class: 'bd-ic', 'aria-hidden': 'true' }, [b.icon]),
          el('span', { class: 'bd-tx' }, [
            el('strong', {}, [b.name]),
            el('span', { class: 'muted small' }, [b.hint]),
            !b.got && b.progress ? el('span', { class: 'bd-bar', role: 'progressbar', 'aria-valuemin': '0', 'aria-valuemax': String(b.progress[1]), 'aria-valuenow': String(b.progress[0]), 'aria-label': `${b.name} : ${b.progress[0]} sur ${b.progress[1]}` }, [el('i', { style: `width:${(b.progress[0] / b.progress[1]) * 100}%` }), el('em', {}, [`${b.progress[0]}/${b.progress[1]}`])]) : null,
          ]),
          b.got
            ? (b.claimed
              ? el('span', { class: 'bd-ok' }, [el('span', { 'aria-hidden': 'true' }, ['✓']), el('span', { class: 'sr-only' }, ['débloqué, récompense récupérée'])])
              : (() => { const k = el('button', { type: 'button', class: 'bd-get', 'aria-label': `Récupérer ${b.reward} Éclats pour le succès ${b.name}` }, [`+${b.reward}`]); k.addEventListener('click', () => { const n = claimBadge(b.id); if (n) toast(`${b.name} : +${n} Éclats`); renderBadges(); }); return k; })())
            : el('span', { class: 'bd-rw', title: 'Récompense' }, [`+${b.reward}`, el('span', { class: 'sr-only' }, [' Éclats à gagner'])]),
        ]))),
      ])));
    }

    const THEMES_UI: { id: string; name: string; sw: string }[] = [
      { id: 'neon', name: 'Néon', sw: 'linear-gradient(115deg, #3ef0ff, #8a7bff, #ff4fd8, #ffd25a)' },
      { id: 'aurore', name: 'Aurore', sw: 'linear-gradient(115deg, #3dffa8, #3ef0ff, #3ea6ff, #e8ff6a)' },
      { id: 'braise', name: 'Braise', sw: 'linear-gradient(115deg, #ffd25a, #ff8a3d, #ff4f6d, #c04bff)' },
      { id: 'ocean', name: 'Océan', sw: 'linear-gradient(115deg, #3ef0ff, #4f7bff, #8a7bff, #7af0c6)' },
      { id: 'royal', name: 'Royal', sw: 'linear-gradient(115deg, #8a7bff, #c04bff, #ff4fd8, #ffd25a)' },
    ];
    function renderThemes() {
      let cur = 'neon';
      try { cur = localStorage.getItem('holocote.theme.v1') || 'neon'; } catch { /* rien */ }
      $('th-grid').replaceChildren(...THEMES_UI.map((t) => {
        const b = el('button', { type: 'button', class: 'th-opt', role: 'radio', 'aria-checked': String(t.id === cur) }, [el('span', { class: 'th-sw', style: `--sw:${t.sw}` }), t.name]);
        b.addEventListener('click', () => {
          try { localStorage.setItem('holocote.theme.v1', t.id); } catch { /* rien */ }
          if (t.id === 'neon') document.documentElement.removeAttribute('data-theme'); else document.documentElement.setAttribute('data-theme', t.id);
          renderThemes(); renderBadges();
          window.dispatchEvent(new CustomEvent('holocote:progress'));
        });
        return b;
      }));
    }
    renderThemes();

    $('bd-claim-all').addEventListener('click', () => { const n = claimAllBadges(); if (n) toast(`+${n} Éclats récupérés`); renderBadges(); });

    function renderAll() {
      $('t-cards').textContent = String(countCards());
      $('t-streak').textContent = String(streak().current);
      $('t-quests').textContent = String(questDays().length);
      renderQuests();
      renderBadges();
      renderHero();
    }

    /* ---------- Sauvegarde ---------- */
    function renderLast() {
      const t = lastBackup();
      const days = t ? Math.floor((Date.now() - t) / 864e5) : -1;
      const has = countCards() > 0 || questDays().length > 0 || streak().best > 0;
      $('sv-last').textContent = t ? `Dernière sauvegarde : ${days === 0 ? 'aujourd’hui' : days === 1 ? 'hier' : `il y a ${days} jours`}` : 'Jamais sauvegardé';
      $('sv-last').classList.toggle('warn', has && (days < 0 || days > 14));
    }
    $('sv-file').addEventListener('click', () => { downloadBackup(); renderLast(); toast('Fichier de sauvegarde téléchargé.'); });
    $('sv-code').addEventListener('click', async () => {
      const out = $<HTMLTextAreaElement>('sv-code-out');
      out.value = await backupCode();
      $('sv-out').hidden = false;
      out.select();
      renderLast();
    });
    $('sv-copy').addEventListener('click', async () => {
      const out = $<HTMLTextAreaElement>('sv-code-out');
      try { await navigator.clipboard.writeText(out.value); toast('Code copié.'); } catch { out.select(); toast('Sélectionne le code et copie-le (Ctrl+C).'); }
    });
    let pending = '';
    async function check(input: string) {
      $('sv-confirm').hidden = true;
      try {
        const p = await previewBackup(input);
        pending = input;
        const d = new Date(p.at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
        $('sv-confirm-t').textContent = `Sauvegarde du ${d} : ${p.cards} carte${p.cards > 1 ? 's' : ''} au classeur. Elle remplacera toute la progression actuelle de ce navigateur (${countCards()} carte${countCards() > 1 ? 's' : ''}).`;
        $('sv-confirm').hidden = false;
      } catch (e) {
        toast(e instanceof Error ? e.message : 'Code ou fichier non reconnu.');
      }
    }
    $('sv-check').addEventListener('click', () => { const v = $<HTMLTextAreaElement>('sv-in-code').value; if (v.trim()) check(v); else toast('Colle d’abord ton code.'); });
    $<HTMLInputElement>('sv-in-file').addEventListener('change', async (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      if (!f) return;
      if (f.size > 3_000_000) { toast('Fichier trop volumineux.'); return; }
      check(await f.text());
      (e.target as HTMLInputElement).value = '';
    });
    $('sv-cancel').addEventListener('click', () => { $('sv-confirm').hidden = true; pending = ''; });
    $('sv-go').addEventListener('click', async () => {
      if (!pending) return;
      try {
        await restoreBackup(pending);
        toast('Progression restaurée.');
        setTimeout(() => location.reload(), 700);
      } catch (e) {
        toast(e instanceof Error ? e.message : 'La restauration a échoué.');
      }
    });

    $<HTMLInputElement>('ac-pseudo').value = getPseudo() === 'Toi' ? '' : getPseudo();
    renderAll();
    renderWardrobe();
    renderLast();
    window.addEventListener('holocote:progress', () => setTimeout(renderAll, 800));
    window.addEventListener('holocote:collection', renderAll);
    window.addEventListener('holocote:coins', () => renderHero());
    const tick = () => {
      const ms = msToMidnight();
      $('q-next').textContent = [Math.floor(ms / 3.6e6), Math.floor((ms % 3.6e6) / 6e4), Math.floor((ms % 6e4) / 1000)].map((v) => String(v).padStart(2, '0')).join(':');
      if (ms < 1500) setTimeout(renderAll, 2000);
    };
    tick();
    setInterval(tick, 1000);
  </script>

