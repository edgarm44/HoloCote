    @keyframes evb-rise { to { transform: translateY(-110px) rotate(200deg); opacity: 0; } }
    .evb-tag { flex: 0 0 auto; padding: 5px 12px; border-radius: 999px; background: var(--c1); color: #0a0812; font-weight: 800; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
