    .day p:global(.pend) { color: var(--up); font-weight: 700; }
    .day-quests { background: linear-gradient(160deg, rgba(62, 240, 255, 0.07), transparent 60%), var(--bg-2); }
    .day { display: flex; gap: 20px; align-items: stretch; padding: 22px; border-radius: 22px; text-decoration: none; color: var(--text); border: 1px solid var(--line); background: var(--bg-2); transition: border-color 0.2s; min-width: 0; }
    .day:hover { border-color: rgba(255, 255, 255, 0.3); }
