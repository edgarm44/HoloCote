    @media (min-width: 860px) { .how-steps { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 859px) {
      .how-steps li { display: grid; grid-template-columns: 36px 1fr; column-gap: 14px; align-items: start; }
      .how-steps li::before { grid-row: span 2; margin: 0; }
    }
    .how-steps li { counter-increment: step; padding: 20px 22px; border-radius: 20px; background: var(--surface); border: 1px solid var(--line); }
    .how-steps li::before { content: counter(step); display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; margin-bottom: 14px;
      font-family: var(--font-display); font-weight: 800; color: #0a0812; background: var(--holo); }
    .how-steps h3 { font-size: 1.3rem; margin: 0 0 6px; }
    .how-steps p { margin: 0; color: var(--muted); }

    /* ---------- Fin ---------- */
    .final { text-align: center; padding: clamp(40px, 8vw, 80px) 20px; border-radius: 32px; margin-bottom: 30px;
      background: radial-gradient(circle at 50% 0%, rgba(255, 79, 216, 0.22), transparent 60%), radial-gradient(circle at 50% 100%, rgba(62, 240, 255, 0.18), transparent 60%), var(--bg-2);
      border: 1px solid var(--line); }
    .final-coti { display: flex; justify-content: center; margin-bottom: 14px; animation: bob 4s ease-in-out infinite; }
    @keyframes bob { 50% { transform: translateY(-8px); } }
    .final h2 { font-size: clamp(1.9rem, 5.5vw, 3.6rem); line-height: 1; letter-spacing: -0.04em; font-weight: 800; max-width: 18ch; margin: 0 auto 16px; text-wrap: balance; }
