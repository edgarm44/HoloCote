    .opp-line { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px; border-radius: 14px; background: rgba(61, 255, 168, 0.06); border: 1px solid rgba(61, 255, 168, 0.3); }
