    .mega .w:nth-child(5) { animation-delay: 0.3s; } .mega .w:nth-child(6) { animation-delay: 0.37s; } .mega .w:nth-child(7) { animation-delay: 0.44s; background: var(--holo); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: word-in 0.7s cubic-bezier(.2,.9,.3,1.2) 0.44s both, shimmer-t 6s linear infinite; }
