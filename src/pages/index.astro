    /* Bandeau des cours : pleine largeur sans débordement */
    .ticker-slot { margin: 0 0 clamp(48px, 8vw, 88px); min-height: 42px; border-block: 1px solid var(--line); }

    /* ---------- Titres de section ---------- */
    .sec-title { font-size: clamp(1.7rem, 4.2vw, 2.8rem); line-height: 1; letter-spacing: -0.035em; font-weight: 800; margin: 0 0 22px; }
