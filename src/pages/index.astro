---
import Base from '../layouts/Base.astro';
import { mascotSvg } from '../lib/mascot';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Index des onglets : chaque ligne dit ce qu'on y fait, en une phrase.
const TOOLS = [
  { href: '/scanner/', name: 'Scanner', text: 'Photographie ta carte, elle est reconnue et rangée dans ton classeur.', icon: '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16" />' },
  { href: '/recherche/', name: 'Recherche', text: 'Trouve n\'importe quelle carte, même avec une faute d\'orthographe.', icon: '<circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />' },
  { href: '/marche/', name: 'Marché', text: 'Les cours du jour, les plus fortes hausses et les plus fortes baisses.', icon: '<path d="M3 17l6-6 4 4 8-8M15 7h6v6" />' },
  { href: '/opportunites/', name: 'Opportunités', text: 'Les cartes qui se vendent sous leur prix habituel en ce moment.', icon: '<circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="1" />' },
  { href: '/favoris/', name: 'Favoris', text: 'Suis les cartes qui te manquent et reçois une alerte au bon prix.', icon: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />' },
  { href: '/collection/', name: 'Collection', text: 'Ton classeur : chaque carte, son état et la valeur de l\'ensemble.', icon: '<rect x="4" y="3" width="12" height="17" rx="2" /><path d="M8 7h4M19 6v13a2 2 0 0 1-2 2H9" />' },
  { href: '/classement/', name: 'Classement', text: 'Ton classeur face à quatorze rivaux, de la ligue Bronze à Légende.', icon: '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3" />' },
  { href: '/compte/', name: 'Compte', text: 'Ton pseudo, tes quêtes du jour et tes succès, sans e-mail ni mot de passe.', icon: '<circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />' },
  { href: '/defi/', name: 'Défi du jour', text: 'Carte mystère, booster et duel : chaque jour, des cartes à gagner pour ton classeur.', icon: '<rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9.8 9.6a2.3 2.3 0 1 1 3.3 2.1c-.7.4-1.1.9-1.1 1.6v.4M12 16.8v.01" />' },
];
---
<Base title="HoloCote" active="home">
  <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>

  <section class="hero">
    <div class="hero-text">
      <h1 class="mega">Sors tes cartes.<br />On s'occupe de&nbsp;la&nbsp;cote.</h1>
      <p class="lead">Scanne une carte Pokémon et découvre sa rareté et sa cote du jour. Suis le marché, guette le bon prix et range tout dans ton classeur.</p>

      <form class="hero-search" action={`${base}/recherche/`} method="get" role="search">
        <label class="sr-only" for="hq">Nom de la carte</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input id="hq" name="q" type="search" placeholder="Dracaufeu, Pikachu, Noctali…" minlength="2" required autocomplete="off" />
        <input type="hidden" name="lang" value="fr" />
        <button class="go" type="submit" aria-label="Chercher">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </form>

      <div class="cta">
        <a class="btn btn-primary btn-xl" href={`${base}/scanner/`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16" /></svg>
          Scanner ma carte
        </a>
        <a class="btn btn-ghost btn-xl" href={`${base}/marche/`}>Voir le marché</a>
      </div>

      <dl class="live" id="live" hidden>
        <div><dt>Indice HoloCote</dt><dd id="ls-index">—</dd></div>
        <div><dt id="ls-top-name">Plus forte hausse</dt><dd id="ls-top">—</dd></div>
        <div><dt>Cartes suivies</dt><dd id="ls-n">—</dd></div>
      </dl>
    </div>

    <div class="showcase" aria-hidden="true">
      <div class="halo"></div>
      <div class="fan">
        <div class="fan-card c1"><div class="ph"></div></div>
        <div class="fan-card c2"><div class="ph"></div></div>
        <div class="fan-card c3"><div class="ph"></div></div>
      </div>
      <div class="float-tag t1" id="tag1" hidden></div>
      <div class="float-tag t2" id="tag2" hidden></div>
    </div>
  </section>

  <div class="ticker-slot" id="ticker-slot"></div>

  <section class="today" aria-labelledby="today-h">
    <h2 id="today-h" class="sec-title">Aujourd'hui</h2>
    <div class="today-grid">
      <a class="day day-defi" href={`${base}/defi/`}>
        <span class="mini-card" aria-hidden="true"><span>?</span></span>
        <div class="day-body">
          <h3>Défi du jour <span class="muted" id="defi-n"></span></h3>
          <p id="defi-text">Une carte mystère, un booster et un duel : des cartes à gagner chaque jour.</p>
          <ul class="games" id="games">
            <li data-g="m"><i aria-hidden="true"></i><span>Carte mystère</span><b>à jouer</b></li>
            <li data-g="b"><i aria-hidden="true"></i><span>Booster</span><b>à ouvrir</b></li>
            <li data-g="d"><i aria-hidden="true"></i><span>Duel</span><b>à jouer</b></li>
          </ul>
          <span class="day-cta" id="defi-cta">Jouer</span>
        </div>
      </a>
      <a class="day day-quests" href={`${base}/compte/#quetes`}>
        <div class="day-body">
          <h3>Mes quêtes <span class="muted" id="q-count">0/3</span></h3>
          <p id="q-streak">Trois missions du jour, renouvelées à minuit.</p>
          <ul class="q-mini" id="q-mini"></ul>
          <span class="day-cta">Voir mes quêtes et mes succès</span>
        </div>
      </a>
      <a class="day day-opp" href={`${base}/opportunites/`}>
        <div class="day-body">
          <h3>Sous son prix habituel</h3>
          <p id="opp-text">Les cartes qui se vendent moins cher que d'habitude, repérées chaque jour.</p>
          <div class="opp-line" id="opp-line" hidden>
            <span class="opp-thumb" id="opp-thumb"></span>
            <span class="opp-info"><strong id="opp-name"></strong><span id="opp-price"></span></span>
            <span class="opp-gap" id="opp-gap"></span>
          </div>
          <span class="day-cta">Toutes les opportunités</span>
        </div>
      </a>
      <a class="day day-rank" href={`${base}/classement/`}>
        <div class="day-body">
          <h3>Ton classement</h3>
          <p class="rank-big" id="rank-big">?</p>
          <p id="rank-text">Ton classeur affronte quatorze rivaux. Où te places-tu ?</p>
          <span class="day-cta">Voir le classement</span>
        </div>
      </a>
    </div>
  </section>

  <section class="risers" id="risers" hidden aria-labelledby="risers-h">
    <div class="sec-head">
      <h2 id="risers-h" class="sec-title">Ça grimpe cette semaine</h2>
      <a class="text-link" href={`${base}/marche/`}>Tout le marché</a>
    </div>
    <div class="riser-grid" id="riser-grid"></div>
  </section>

  <section class="tools" aria-labelledby="tools-h">
    <h2 id="tools-h" class="sec-title">Tout HoloCote</h2>
    <ul class="tool-list">
      {TOOLS.map((t) => (
        <li>
          <a href={`${base}${t.href}`}>
            <span class="tool-ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} /></span>
            <span class="tool-name">{t.name}</span>
            <span class="tool-text">{t.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="how" aria-labelledby="how-h">
    <h2 id="how-h" class="sec-title">Ta première carte en trois gestes</h2>
    <ol class="how-steps">
      <li><h3>Vise</h3><p>Ouvre le scanner et pose ta carte bien à plat dans le cadre.</p></li>
      <li><h3>Découvre</h3><p>HoloCote reconnaît la carte et affiche sa rareté et sa cote du jour.</p></li>
      <li><h3>Range</h3><p>Ajoute-la à ton classeur, ou mets une étoile sur celles qui te manquent.</p></li>
    </ol>
  </section>

  <section class="final">
    <div class="final-coti" set:html={mascotSvg('happy', 120, 'Coti, la mascotte de HoloCote, te salue')} />
    <h2>Zéro compte. Zéro pub.<br />Tes cartes restent chez toi.</h2>
    <p>Ton classeur, tes favoris et tes scans sont gardés dans ton navigateur. Personne d'autre ne les voit.</p>
    <a class="btn btn-primary btn-xl" href={`${base}/scanner/`}>Scanner ma première carte</a>
  </section>

  <script>
    import { loadMarket, ticker, formatChange, changeClass, type Quote } from '../lib/market';
    import { analyse } from '../lib/opportunity';
    import { formatPrice } from '../lib/tcgdex';
    import { countCards } from '../lib/collection';
    import { todayNumber, getDay } from '../lib/mystery';
    import { getLog, streak } from '../lib/progress';
    import { getBooster } from '../lib/booster';
    import { todayQuests, questBonusToday } from '../lib/quests';
    import { holoCard, attachTilt, el, url } from '../lib/ui';

    const $ = (id: string) => document.getElementById(id)!;
    const href = (q: Quote) => url(`/carte/?id=${encodeURIComponent(q.id)}&lang=${q.lang}`);
    const eur = (v: number) => formatPrice(v, 'EUR');
    document.querySelectorAll<HTMLElement>('.fan-card').forEach(attachTilt);

    /* Défi du jour : état des trois jeux, sans rien dévoiler de la carte. */
    const n = todayNumber();
    const day = getDay(n);
    $('defi-n').textContent = `n° ${n}`;
    function renderToday() {
      const log = getLog()[n] ?? {};
      const st = streak();
      const set = (g: string, done: boolean, label: string) => {
        const li = document.querySelector<HTMLElement>(`#games [data-g="${g}"]`)!;
        li.classList.toggle('ok', done);
        li.querySelector('b')!.textContent = label;
      };
      set('m', !!day.done, day.done ? (day.won ? `trouvée en ${day.guesses.length}` : 'ratée') : day.guesses.length ? `${6 - day.guesses.length} essais restants` : 'à jouer');
      const b = getBooster();
      set('b', !!b?.opened, b?.claimed ? 'carte gagnée' : b?.opened ? 'ouvert' : 'à ouvrir');
      set('d', !!log.d, log.d === 'ok' ? 'gagné' : log.d === 'ko' ? 'perdu' : 'à jouer');
      const left = [!day.done, !b?.opened, !log.d].filter(Boolean).length;
      $('defi-text').textContent = left === 0
        ? 'Tout est joué pour aujourd’hui. Nouveau défi à minuit.'
        : st.current > 0 && !st.playedToday
          ? `Ta série de ${st.current} jour${st.current > 1 ? 's' : ''} t’attend : joue un jeu pour la garder.`
          : `${left} jeu${left > 1 ? 'x' : ''} à jouer aujourd’hui${st.current > 1 ? ` · série de ${st.current} jours` : ''}.`;
      $('defi-cta').textContent = left === 0 ? 'Voir mes résultats' : left === 3 ? 'Jouer' : 'Continuer';

      const q = todayQuests();
      const done = q.filter((x) => x.done).length;
      $('q-count').textContent = `${done}/3`;
      $('q-mini').replaceChildren(...q.map((x) => el('li', { class: x.done ? 'ok' : '' }, [el('i', { 'aria-hidden': 'true' }), el('span', {}, [x.title]), x.goal > 1 && !x.done ? el('b', {}, [`${x.value}/${x.goal}`]) : null])));
      $('q-streak').textContent = done === 3
        ? 'Bravo, quêtes terminées ! Demain, ton booster du jour sera boosté.'
        : questBonusToday() ? 'Bonus actif : ton booster du jour est boosté grâce aux quêtes d’hier.' : 'Termine les trois pour un booster boosté demain.';
    }
    renderToday();
    window.addEventListener('holocote:progress', () => setTimeout(renderToday, 300));

    /* Classement : dernier rang connu (calculé sur la page Classement). */
    let rank = 0;
    try { rank = Number(localStorage.getItem('holocote.rank.v1')) || 0; } catch { /* rien */ }
    if (rank) {
      $('rank-big').textContent = `${rank}${rank === 1 ? 'er' : 'e'}`;
      $('rank-text').textContent = `sur 15 à ta dernière visite. ${countCards() ? 'Chaque carte scannée peut te faire grimper.' : 'Scanne tes cartes pour grimper.'}`;
    } else if (!countCards()) {
      $('rank-text').textContent = 'Scanne tes premières cartes et découvre ta place face aux quatorze rivaux.';
    }

    loadMarket().then((m) => {
      const qs = m.quotes;
      if (!qs.length) return;
      $('ticker-slot').replaceChildren(ticker(qs.filter((q) => q.change7 !== undefined), href, eur));

      // Les trois cartes flottantes : les plus chères du marché.
      const top = [...qs].filter((q) => q.image).sort((a, b) => b.price - a.price).slice(0, 3);
      const slots = [...document.querySelectorAll<HTMLElement>('.fan-card')];
      top.forEach((q, i) => {
        const img = el('img', { src: `${q.image}/high.webp`, alt: '', decoding: 'async', referrerpolicy: 'no-referrer' });
        img.addEventListener('load', () => slots[i].classList.add('loaded'));
        slots[i].replaceChildren(img);
      });
      const tag = (id: string, q?: Quote) => {
        if (!q) return;
        const t = $(id);
        t.replaceChildren(el('span', { class: 'ft-name' }, [q.name]), el('span', { class: 'ft-price' }, [eur(q.price)]), el('span', { class: `ft-chg ${changeClass(q.change7)}` }, [formatChange(q.change7)]));
        t.hidden = false;
      };
      tag('tag1', top[0]);
      tag('tag2', top[1]);

      // Chiffres du jour
      const topUp = [...qs].filter((q) => q.change7 !== undefined).sort((a, b) => b.change7! - a.change7!)[0];
      $('ls-n').textContent = String(qs.length);
      if (m.index) $('ls-index').textContent = m.index.value.toFixed(1).replace('.', ',');
      if (topUp) {
        $('ls-top').textContent = formatChange(topUp.change7);
        $('ls-top').className = changeClass(topUp.change7);
        $('ls-top-name').textContent = topUp.name;
      }
      $('live').hidden = false;

      // Meilleure opportunité du jour
      const best = qs.map(analyse).filter((a) => a.q.price >= 1 && !a.q.unsure && (a.verdict === 'window' || a.verdict === 'rebound')).sort((a, b) => b.score - a.score)[0];
      if (best) {
        const th = $('opp-thumb');
        if (best.q.image) th.replaceChildren(el('img', { src: `${best.q.image}/low.webp`, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' }));
        $('opp-name').textContent = best.q.name;
        $('opp-price').textContent = eur(best.q.price);
        $('opp-gap').textContent = best.vsMonth !== undefined && best.vsMonth < 0 ? `${formatChange(best.vsMonth)} vs son mois` : 'repart';
        $('opp-text').textContent = 'La meilleure du jour :';
        $('opp-line').hidden = false;
      }

      // Plus fortes hausses
      const up = qs.filter((q) => (q.change7 ?? 0) > 0 && q.image).sort((a, b) => b.change7! - a.change7!).slice(0, 6);
      if (up.length) {
        $('riser-grid').replaceChildren(...up.map((q) =>
          el('a', { class: 'riser', href: href(q) }, [
            holoCard(q.image, q.name),
            el('span', { class: 'riser-chg' }, [`▲ ${formatChange(q.change7)}`]),
            el('span', { class: 'riser-name' }, [q.name]),
            el('span', { class: 'riser-price' }, [eur(q.price)]),
          ]),
        ));
        $('risers').hidden = false;
      }
    }).catch(() => { /* la page reste utilisable sans les cours */ });
  </script>

  <style>
    .aurora { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
    .aurora span { position: absolute; width: 60vmax; height: 60vmax; border-radius: 50%; filter: blur(90px); opacity: 0.18; animation: drift 26s ease-in-out infinite alternate; }
    .aurora span:nth-child(1) { background: #3ef0ff; top: -30vmax; left: -20vmax; }
    .aurora span:nth-child(2) { background: #ff4fd8; top: -10vmax; right: -30vmax; animation-delay: -9s; }
    .aurora span:nth-child(3) { background: #8a7bff; bottom: -40vmax; left: 20vmax; animation-delay: -17s; opacity: 0.12; }
    @keyframes drift { to { transform: translate(8vmax, 6vmax) scale(1.15); } }

    /* ---------- Hero ---------- */
    .hero { display: grid; gap: 28px; grid-template-columns: 1fr; align-items: center; padding: clamp(20px, 5vw, 56px) 0 clamp(28px, 5vw, 48px); min-height: min(80vh, 760px); }
    @media (min-width: 980px) { .hero { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); } }
    .hero-text { min-width: 0; }
    .mega { font-size: clamp(2.3rem, 9.5vw, 4.6rem); line-height: 0.95; letter-spacing: -0.045em; font-weight: 800; margin: 0 0 22px; text-wrap: balance; }
    .lead { font-size: clamp(1.05rem, 2.1vw, 1.25rem); color: var(--muted); max-width: 34em; margin-bottom: 26px; }

    .hero-search {
      display: flex; align-items: center; gap: 10px; max-width: 540px; margin-bottom: 16px;
      padding: 7px 7px 7px 18px; border-radius: 999px;
      background: rgba(14, 12, 26, 0.88); border: 1px solid rgba(255, 255, 255, 0.14);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .hero-search:focus-within { border-color: var(--cyan); box-shadow: 0 0 0 4px rgba(62, 240, 255, 0.15); }
    .hero-search > svg { width: 20px; height: 20px; flex: 0 0 20px; fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; }
    .hero-search input[type='search'] { border: 0; background: transparent; box-shadow: none; padding: 10px 2px; min-height: 46px; font-size: 1.05rem; min-width: 0; }
    .hero-search input:focus-visible { box-shadow: none; }
    .go { width: 48px; height: 48px; flex: 0 0 48px; border: 0; border-radius: 50%; cursor: pointer; display: grid; place-items: center; background: var(--holo); background-size: 200% 100%; }
    .go svg { width: 22px; height: 22px; fill: none; stroke: #0a0812; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
    .go:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }
    .cta { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-xl { min-height: 56px; padding: 0 26px; font-size: 1.02rem; border-radius: 999px; }
    .btn-xl svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .btn-ghost { background: transparent; border: 1px solid rgba(255, 255, 255, 0.22); }
    .btn-ghost:hover { border-color: var(--text); }

    .live { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 28px 0 0; }
    .live div { display: flex; flex-direction: column-reverse; min-width: 0; }
    .live dt { font-size: 0.8rem; color: var(--muted); max-width: 16ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .live dd { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(1.3rem, 3vw, 1.7rem); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
    .live dd.up { color: var(--up); }
    .live dd.down { color: var(--down); }

    /* Les trois cartes flottantes (inchangées) */
    .showcase { position: relative; height: clamp(340px, 54vw, 580px); }
    .halo { position: absolute; inset: 12%; border-radius: 50%; background: conic-gradient(from 90deg, #3ef0ff, #8a7bff, #ff4fd8, #ffd25a, #3ef0ff); filter: blur(70px); opacity: 0.35; animation: spin 18s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .fan { position: absolute; inset: 0; display: grid; place-items: center; }
    .fan-card {
      position: absolute; width: clamp(160px, 16vw, 210px); aspect-ratio: 245 / 342; border-radius: 4.5% / 3.2%;
      overflow: hidden; box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55);
      animation: float 7s ease-in-out infinite;
      background: var(--holo); background-size: 200% 200%;
      --base: translateX(0);
      transform: var(--base) perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
      transition: transform 0.3s ease-out;
    }
    .fan-card::after {
      content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.25s; mix-blend-mode: color-dodge;
      background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.4), transparent 45%),
        linear-gradient(115deg, transparent 20%, rgba(62, 240, 255, 0.3) 40%, rgba(255, 79, 216, 0.3) 55%, rgba(255, 210, 90, 0.25) 70%, transparent 85%);
    }
    .fan-card.is-active::after, .fan-card:hover::after { opacity: 1; }
    .fan-card img { width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s; }
    .fan-card.loaded img { opacity: 1; }
    .fan-card .ph { position: absolute; inset: 6%; border-radius: 6px; background: rgba(7, 6, 13, 0.55); }
    .fan-card.c1 { --base: translateX(-40%) rotate(-13deg); z-index: 1; animation-delay: -2s; }
    .fan-card.c2 { z-index: 3; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6), 0 0 70px rgba(255, 79, 216, 0.35); }
    .fan-card.c3 { --base: translateX(40%) rotate(13deg); z-index: 2; animation-delay: -4s; }
    @keyframes float { 50% { translate: 0 -16px; } }
    .float-tag {
      position: absolute; z-index: 4; display: grid; grid-template-columns: auto auto; gap: 0 10px; align-items: baseline;
      padding: 12px 16px; border-radius: 16px; background: rgba(14, 12, 26, 0.88); border: 1px solid var(--line);
