    .mini-card { flex: 0 0 auto; width: 84px; aspect-ratio: 245 / 342; border-radius: 8px; display: grid; place-items: center; align-self: center;
      background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 6px, transparent 6px 12px), linear-gradient(160deg, #241d4a, #120f26);
      border: 2px solid rgba(255, 210, 90, 0.6); transform: rotate(-6deg); }
