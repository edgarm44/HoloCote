    .tool-list a:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; border-radius: 8px; }
    .tool-ic { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--surface-2); }
