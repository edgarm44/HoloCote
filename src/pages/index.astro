    .rank-big { font-family: var(--font-display); font-weight: 800; font-size: 3.2rem !important; line-height: 1; color: var(--text) !important; letter-spacing: -0.04em; }

    /* ---------- Ça grimpe ---------- */
    .riser-grid { display: grid; gap: 18px; grid-template-columns: repeat(6, minmax(0, 1fr)); }
