---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="HoloCote" active="home">
  <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>

  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow"><span class="dot"></span>La bourse de tes cartes</p>
      <h1>Ta collection a de la valeur.<br /><span class="holo-text">Découvre combien.</span></h1>
      <p class="lead">Scanne tes cartes, suis leur cote comme en bourse et construis ton classeur. Gratuit, sans compte, en français.</p>

      <form class="hero-search" action={`${base}/recherche/`} method="get" role="search">
        <label class="sr-only" for="hq">Nom de la carte</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input id="hq" name="q" type="search" placeholder="Dracaufeu, Pikachu, Noctali…" minlength="2" required autocomplete="off" />
        <input type="hidden" name="lang" value="fr" />
        <button class="btn btn-primary" type="submit">Chercher</button>
      </form>

      <div class="cta">
        <a class="btn btn-primary btn-lg" href={`${base}/scanner/`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16" /></svg>
          Scanner une carte
        </a>
        <a class="btn btn-lg" href={`${base}/marche/`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8M15 7h6v6" /></svg>
          Voir le marché
        </a>
      </div>
    </div>

    <div class="showcase" id="showcase" aria-hidden="true">
      <div class="fan">
        <div class="fan-card c1"><div class="ph"></div></div>
        <div class="fan-card c2"><div class="ph"></div></div>
        <div class="fan-card c3"><div class="ph"></div></div>
      </div>
      <div class="float-tag t1" id="tag1" hidden></div>
      <div class="float-tag t2" id="tag2" hidden></div>
    </div>
  </section>

  <div class="ticker-slot" id="ticker-slot"></div>

  <section class="stats-band">
    <div><strong>FR &amp; EN</strong><span>des milliers de cartes</span></div>
    <div><strong>Cardmarket</strong><span>cotes mises à jour chaque jour</span></div>
    <div><strong>0 compte</strong><span>ta collection reste chez toi</span></div>
    <div><strong>100 % gratuit</strong><span>sans publicité</span></div>
  </section>

  <section class="features">
    <a class="feature f-scan" href={`${base}/scanner/`}>
      <span class="f-icon"><svg viewBox="0 0 24 24"><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16" /></svg></span>
      <h2>Scanner</h2>
      <p>Vise ta carte avec ton téléphone : nom, PV, numéro et illustration sont analysés pour la reconnaître.</p>
      <span class="f-link">Essayer →</span>
    </a>
    <a class="feature f-market" href={`${base}/marche/`}>
      <span class="f-icon"><svg viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8M15 7h6v6" /></svg></span>
      <h2>Marché</h2>
      <p>Hausses, baisses, indice HoloCote : le cours des cartes les plus recherchées, comme à la bourse.</p>
      <span class="f-link">Voir les cours →</span>
    </a>
    <a class="feature f-coll" href={`${base}/collection/`}>
      <span class="f-icon"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="12" height="17" rx="2" /><path d="M8 7h4M19 6v13a2 2 0 0 1-2 2H9" /></svg></span>
      <h2>Collection</h2>
      <p>Un classeur stylé avec la valeur totale de tes cartes, ta pépite et des filtres par rareté.</p>
      <span class="f-link">Ouvrir mon classeur →</span>
    </a>
  </section>

  <section class="trends" id="trends" hidden>
    <div class="section-head">
      <div>
        <p class="eyebrow">En ce moment</p>
        <h2>Les cartes qui <span class="holo-text">montent</span></h2>
      </div>
      <a class="btn" href={`${base}/marche/`}>Tout le marché</a>
    </div>
    <div class="trend-grid" id="trend-grid"></div>
  </section>

  <section class="steps">
    <p class="eyebrow">Comment ça marche</p>
    <h2>Trois gestes, et ta carte est cotée</h2>
    <ol>
      <li><span class="step-n">1</span><div><h3>Vise</h3><p>Place ta carte dans le cadre de la caméra, à plat et bien éclairée.</p></div></li>
      <li><span class="step-n">2</span><div><h3>Vérifie</h3><p>HoloCote te montre la carte reconnue, sa rareté et sa cote du jour.</p></div></li>
      <li><span class="step-n">3</span><div><h3>Range</h3><p>Ajoute-la à ton classeur et suis la valeur de ta collection.</p></div></li>
    </ol>
  </section>

  <section class="final-cta">
    <h2>Prêt à découvrir ce que valent tes cartes ?</h2>
    <a class="btn btn-primary btn-lg" href={`${base}/scanner/`}>Scanner ma première carte</a>
  </section>

  <script>
    import { loadMarket, ticker, formatChange, changeClass, type Quote } from '../lib/market';
    import { formatPrice } from '../lib/tcgdex';
    import { holoCard, attachTilt, el, url } from '../lib/ui';

    const href = (q: Quote) => url(`/carte/?id=${encodeURIComponent(q.id)}&lang=${q.lang}`);
    const eur = (v: number) => formatPrice(v, 'EUR');
    document.querySelectorAll<HTMLElement>('.fan-card').forEach(attachTilt);

    loadMarket().then((m) => {
      const qs = m.quotes;
      if (!qs.length) return;
      document.getElementById('ticker-slot')!.replaceChildren(ticker(qs.filter((q) => q.change7 !== undefined), href, eur));

      // Vitrine : les trois cartes les plus chères qui ont une image.
      const top = [...qs].filter((q) => q.image).sort((a, b) => b.price - a.price).slice(0, 3);
      const slots = [...document.querySelectorAll<HTMLElement>('.fan-card')];
      top.forEach((q, i) => {
        const img = el('img', { src: `${q.image}/high.webp`, alt: '', decoding: 'async', referrerpolicy: 'no-referrer' });
        img.addEventListener('load', () => slots[i].classList.add('loaded'));
        slots[i].replaceChildren(img);
      });
      const tag = (id: string, q?: Quote) => {
        const t = document.getElementById(id)!;
        if (!q) return;
        t.replaceChildren(el('span', { class: 'ft-name' }, [q.name]), el('span', { class: `ft-chg ${changeClass(q.change7)}` }, [`${eur(q.price)} · ${formatChange(q.change7)}`]));
        t.hidden = false;
      };
      tag('tag1', top[0]);
      tag('tag2', top[1]);

      // Tendances : plus fortes hausses sur 7 jours.
      const up = qs.filter((q) => (q.change7 ?? 0) > 0 && q.image).sort((a, b) => b.change7! - a.change7!).slice(0, 4);
      if (up.length) {
        document.getElementById('trend-grid')!.replaceChildren(...up.map((q) =>
          el('a', { class: 'trend', href: href(q) }, [
            holoCard(q.image, q.name),
            el('span', { class: 'trend-chg up' }, [`▲ ${formatChange(q.change7)}`]),
            el('span', { class: 'tile-name' }, [q.name]),
            el('span', { class: 'tile-meta' }, [`${eur(q.price)} · ${q.setName ?? ''}`]),
          ]),
        ));
        document.getElementById('trends')!.hidden = false;
      }
    }).catch(() => { /* la page reste utilisable sans les cours */ });
  </script>

  <style>
    .aurora { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
    .aurora span { position: absolute; width: 60vmax; height: 60vmax; border-radius: 50%; filter: blur(90px); opacity: 0.22; animation: drift 24s ease-in-out infinite alternate; }
    .aurora span:nth-child(1) { background: #3ef0ff; top: -30vmax; left: -20vmax; }
    .aurora span:nth-child(2) { background: #ff4fd8; top: -10vmax; right: -30vmax; animation-delay: -8s; }
    .aurora span:nth-child(3) { background: #8a7bff; bottom: -40vmax; left: 20vmax; animation-delay: -16s; opacity: 0.16; }
    @keyframes drift { to { transform: translate(8vmax, 6vmax) scale(1.15); } }

    .eyebrow { display: inline-flex; align-items: center; gap: 8px; text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.75rem; color: var(--cyan); margin: 0 0 14px; font-weight: 700; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--up); box-shadow: 0 0 12px var(--up); }

    .hero { display: grid; gap: 32px; grid-template-columns: 1fr; align-items: center; padding: 28px 0 40px; min-height: min(78vh, 720px); }
    @media (min-width: 960px) { .hero { grid-template-columns: 1.1fr 0.9fr; } }
    .hero h1 { font-size: clamp(2.3rem, 6.2vw, 4.4rem); line-height: 1.04; letter-spacing: -0.02em; margin-bottom: 18px; }
    .lead { font-size: clamp(1.05rem, 2.2vw, 1.25rem); color: var(--muted); max-width: 560px; }

    .hero-search {
      display: flex; align-items: center; gap: 8px; max-width: 560px; margin: 24px 0 18px;
      padding: 6px 6px 6px 16px; border-radius: 16px;
      background: rgba(14, 12, 26, 0.85); border: 1px solid var(--line);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .hero-search:focus-within { border-color: var(--cyan); box-shadow: 0 0 0 4px rgba(62, 240, 255, 0.15), 0 10px 40px rgba(0, 0, 0, 0.35); }
    .hero-search svg { width: 20px; height: 20px; flex: 0 0 20px; fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; }
    .hero-search input[type='search'] { border: 0; background: transparent; box-shadow: none; padding: 10px 4px; min-height: 44px; font-size: 1.05rem; }
    .hero-search input:focus-visible { box-shadow: none; }
    .cta { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-lg { min-height: 52px; padding: 0 24px; font-size: 1.02rem; border-radius: 14px; }
    .btn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    .showcase { position: relative; height: clamp(320px, 52vw, 520px); }
    .fan { position: absolute; inset: 0; display: grid; place-items: center; }
    .fan-card {
      position: absolute; width: clamp(150px, 24vw, 250px); aspect-ratio: 245 / 342; border-radius: 4.5% / 3.2%;
      overflow: hidden; box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55);
      animation: float 7s ease-in-out infinite;
      background: var(--holo); background-size: 200% 200%;
      --base: translateX(0);
      transform: var(--base) perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
      transition: transform 0.3s ease-out;
    }
    .fan-card img { width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s; }
    .fan-card.loaded img { opacity: 1; }
    .fan-card .ph { position: absolute; inset: 6%; border-radius: 6px; background: rgba(7, 6, 13, 0.55); }
    .fan-card.c1 { --base: translateX(-42%) rotate(-12deg); z-index: 1; animation-delay: -2s; filter: saturate(0.9); }
    .fan-card.c2 { z-index: 3; animation-delay: 0s; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6), 0 0 60px rgba(255, 79, 216, 0.35); }
    .fan-card.c3 { --base: translateX(42%) rotate(12deg); z-index: 2; animation-delay: -4s; filter: saturate(0.9); }
    @keyframes float { 50% { translate: 0 -14px; } }
    .float-tag {
      position: absolute; z-index: 4; display: flex; flex-direction: column; gap: 2px;
      padding: 10px 14px; border-radius: 14px; background: rgba(14, 12, 26, 0.85); border: 1px solid var(--line);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      animation: float 6s ease-in-out infinite;
    }
    .float-tag.t1 { top: 8%; right: 2%; }
    .float-tag.t2 { bottom: 10%; left: 0; animation-delay: -3s; }
    .ft-name { font-weight: 700; font-size: 0.9rem; }
    .ft-chg { font-size: 0.8rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    @media (max-width: 959px) { .showcase { order: -1; height: 300px; } .float-tag { display: none !important; } }

    .ticker-slot { margin: 0 -16px 36px; min-height: 42px; }

    .stats-band {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin-bottom: 48px;
      border-radius: 20px; overflow: hidden; background: var(--line); border: 1px solid var(--line);
    }
    @media (min-width: 820px) { .stats-band { grid-template-columns: repeat(4, 1fr); } }
    .stats-band div { background: var(--bg-2); padding: 18px; display: flex; flex-direction: column; gap: 2px; }
    .stats-band strong { font-family: var(--font-display); font-size: 1.15rem; }
    .stats-band span { color: var(--muted); font-size: 0.85rem; }

    .features { display: grid; gap: 16px; grid-template-columns: 1fr; margin-bottom: 56px; }
    @media (min-width: 820px) { .features { grid-template-columns: repeat(3, 1fr); } }
    .feature {
      position: relative; display: flex; flex-direction: column; gap: 10px; padding: 26px; border-radius: 22px;
      text-decoration: none; color: var(--text); overflow: hidden;
      background: var(--surface); border: 1px solid var(--line);
      transition: transform 0.25s, border-color 0.25s;
    }
    .feature::before {
      content: ''; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; opacity: 0; transition: opacity 0.3s;
      background: var(--holo); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
    }
    .feature:hover { transform: translateY(-4px); }
    .feature:hover::before { opacity: 1; }
    .feature h2 { margin: 6px 0 0; font-size: 1.35rem; }
    .feature p { color: var(--muted); margin: 0; flex: 1; }
    .f-icon { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; }
    .f-icon svg { width: 26px; height: 26px; fill: none; stroke: #0a0812; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .f-scan .f-icon { background: linear-gradient(135deg, var(--cyan), #8a7bff); }
    .f-market .f-icon { background: linear-gradient(135deg, var(--up), var(--cyan)); }
    .f-coll .f-icon { background: linear-gradient(135deg, var(--magenta), var(--gold)); }
    .f-link { font-weight: 700; color: var(--cyan); }

    .section-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
    .section-head h2 { margin: 0; font-size: clamp(1.6rem, 4vw, 2.2rem); }
    .trends { margin-bottom: 56px; }
    .trend-grid { display: grid; gap: 18px; grid-template-columns: repeat(2, 1fr); }
    @media (min-width: 820px) { .trend-grid { grid-template-columns: repeat(4, 1fr); } }
    .trend-grid :global(.trend) { position: relative; display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--text); }
    .trend-grid :global(.trend-chg) {
      position: absolute; top: 10px; right: 10px; z-index: 2; padding: 4px 10px; border-radius: 999px;
      background: rgba(7, 6, 13, 0.8); border: 1px solid rgba(61, 255, 168, 0.4); font-weight: 700; font-size: 0.85rem;
      backdrop-filter: blur(6px);
    }

    .steps { margin-bottom: 56px; }
    .steps h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin-bottom: 22px; }
    .steps ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: 1fr; }
    @media (min-width: 820px) { .steps ol { grid-template-columns: repeat(3, 1fr); } }
    .steps li { display: flex; gap: 16px; padding: 20px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); }
    .steps h3 { margin: 2px 0 4px; }
    .steps p { margin: 0; color: var(--muted); }
    .step-n {
      flex: 0 0 44px; height: 44px; border-radius: 12px; display: grid; place-items: center;
      font-family: var(--font-display); font-weight: 700; color: #0a0812; background: var(--holo);
    }

    .final-cta {
      text-align: center; padding: 48px 20px; border-radius: 28px; margin-bottom: 24px;
      background: radial-gradient(circle at 50% 0%, rgba(255, 79, 216, 0.22), transparent 60%), radial-gradient(circle at 50% 100%, rgba(62, 240, 255, 0.18), transparent 60%), var(--bg-2);
      border: 1px solid var(--line);
    }
    .final-cta h2 { font-size: clamp(1.5rem, 4vw, 2.3rem); max-width: 640px; margin: 0 auto 22px; }
  </style>
</Base>
