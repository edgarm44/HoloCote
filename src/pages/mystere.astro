---
// Ancienne adresse de l'onglet (renommé « Défi du jour ») : redirection.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${base}/defi/`} />
    <link rel="canonical" href={`${base}/defi/`} />
    <title>Défi du jour · HoloDex</title>
  </head>
  <body><p><a href={`${base}/defi/`}>Le Défi du jour a déménagé : clique ici.</a></p></body>
</html>
