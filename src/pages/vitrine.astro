---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Vitrine" active="showcase" description="Crée une image de tes plus belles cartes avec leur cote, à partager où tu veux.">
  <section class="vt-hero">
    <h1>Ta <span class="holo-text">vitrine.</span></h1>
    <p class="vt-slogan">Tes plus belles cartes. Une image. Prête à frimer.</p>
    <p class="muted vt-lead">Choisis tes cartes, un thème et une mise en page : HoloCote compose une affiche avec leurs cotes du jour. L'image est fabriquée sur ton appareil, rien n'est envoyé.</p>
  </section>

  <div id="vt-state" aria-live="polite">
    <div class="status" role="status"><div class="spinner"></div>On sort tes cartes du classeur…</div>
  </div>

  <section class="vt-empty" id="vt-empty" hidden>
    <div class="ghosts" aria-hidden="true"><span></span><span></span><span></span></div>
    <h2>Ton classeur est vide… pour l'instant.</h2>
    <p class="muted">Scanne tes cartes pour les ajouter à ta collection, puis reviens ici composer ta vitrine.</p>
    <div class="empty-actions">
      <a class="btn btn-primary" href={`${base}/scanner/`}>Scanner une carte</a>
      <button type="button" class="btn" id="demo">Voir un exemple</button>
    </div>
  </section>

  <section class="studio" id="studio" hidden>
    <div class="preview-col">
      <div class="preview-frame">
        <canvas id="poster" width="1080" height="1350" aria-label="Aperçu de ta vitrine"></canvas>
        <div class="rendering" id="rendering" hidden><div class="spinner"></div></div>
      </div>
      <p class="demo-note" id="demo-note" hidden>Exemple composé avec le classeur de KaiShiny, un rival fictif du Classement.</p>
      <div class="export">
        <button type="button" class="btn btn-primary big" id="download">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14" /></svg>
          Télécharger l'image
        </button>
        <button type="button" class="btn big" id="share" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.5" /><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="19" r="2.5" /><path d="m8.2 10.8 7.6-4.4M8.2 13.2l7.6 4.4" /></svg>
          Partager
        </button>
      </div>
      <p class="muted small export-note" id="export-note"></p>
    </div>

    <div class="controls">
      <div class="ctl">
        <label class="ctl-l" for="title">Titre</label>
        <input id="title" type="text" maxlength="32" />
      </div>

      <div class="ctl">
        <span class="ctl-l">Thème</span>
        <div class="themes" role="radiogroup" aria-label="Thème">
          <button type="button" role="radio" data-theme="holo" aria-checked="true"><i class="sw holo"></i>Holo</button>
          <button type="button" role="radio" data-theme="neon" aria-checked="false"><i class="sw neon"></i>Néon</button>
          <button type="button" role="radio" data-theme="gold" aria-checked="false"><i class="sw gold"></i>Or</button>
          <button type="button" role="radio" data-theme="night" aria-checked="false"><i class="sw night"></i>Minuit</button>
        </div>
      </div>

      <div class="ctl">
        <span class="ctl-l">Mise en page</span>
        <div class="layouts" role="radiogroup" aria-label="Mise en page">
          <button type="button" role="radio" data-layout="grid9" aria-checked="true"><span class="lt lt9" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>Top 9</button>
          <button type="button" role="radio" data-layout="star" aria-checked="false"><span class="lt lts" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>Star + 4</button>
          <button type="button" role="radio" data-layout="grid4" aria-checked="false"><span class="lt lt4" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Top 4</button>
        </div>
      </div>

      <div class="ctl toggles">
        <label class="tg"><input type="checkbox" id="show-prices" checked /><span class="tg-ui"></span>Afficher les cotes</label>
        <label class="tg"><input type="checkbox" id="show-total" checked /><span class="tg-ui"></span>Afficher la valeur totale</label>
      </div>

      <div class="ctl">
        <div class="pick-head">
          <span class="ctl-l">Tes cartes <span class="muted" id="pick-count"></span></span>
          <button type="button" class="link-btn" id="auto">Choisir les plus chères</button>
        </div>
        <div class="picks" id="picks"></div>
      </div>
    </div>
  </section>

  <p class="notice">
    Image créée dans ton navigateur pour ton usage personnel. Les cotes sont des estimations indicatives du jour (Cardmarket via TCGdex), multipliées par l'état de chaque carte.
    Illustrations des cartes : leurs détenteurs respectifs ; HoloCote est un site de fan non officiel.
  </p>

  <script>
    import { getItems } from '../lib/collection';
    import { priced, getPseudo, RIVALS, type EntryCard } from '../lib/leaderboard';
    import { conditionLabel } from '../lib/condition';
    import { formatPrice, type Lang } from '../lib/tcgdex';
    import { el, toast } from '../lib/ui';

    type Theme = 'holo' | 'neon' | 'gold' | 'night';
    type Layout = 'grid9' | 'star' | 'grid4';
    interface Pick extends EntryCard { key: string }

    const $ = (id: string) => document.getElementById(id)!;
    const canvas = $('poster') as HTMLCanvasElement;
    const W = 1080, H = 1350;
    const eur = (v: number) => formatPrice(v, 'EUR');
    const PREF = 'holocote.showcase.v1';

    let cards: Pick[] = [];
    let selected: string[] = [];
    let theme: Theme = 'holo';
    let layout: Layout = 'grid9';
    let demo = false;
    const maxOf = (l: Layout) => (l === 'grid9' ? 9 : l === 'star' ? 5 : 4);

    try {
      const p = JSON.parse(localStorage.getItem(PREF) || '{}');
      if (['holo', 'neon', 'gold', 'night'].includes(p.theme)) theme = p.theme;
      if (['grid9', 'star', 'grid4'].includes(p.layout)) layout = p.layout;
    } catch { /* rien */ }
    const savePref = () => { try { localStorage.setItem(PREF, JSON.stringify({ theme, layout })); } catch { /* rien */ } };

    /* ---------- Images (chargées une fois) ---------- */
    const imgCache = new Map<string, Promise<{ img: HTMLImageElement | null; clean: boolean }>>();
    function loadImg(src: string, cors: boolean): Promise<HTMLImageElement | null> {
      return new Promise((resolve) => {
        const i = new Image();
        if (cors) i.crossOrigin = 'anonymous';
        i.referrerPolicy = 'no-referrer';
        i.onload = () => resolve(i);
        i.onerror = () => resolve(null);
        i.src = src;
      });
    }
    function cardImage(base?: string) {
      if (!base) return Promise.resolve({ img: null, clean: true });
      if (!imgCache.has(base)) {
        imgCache.set(base, (async () => {
          // Image française parfois absente chez TCGdex : repli sur l'anglaise.
          for (const src of [`${base}/high.webp`, `${base.replace('/fr/', '/en/')}/high.webp`].filter((x, i, arr) => arr.indexOf(x) === i)) {
            const a = await loadImg(src, true);
            if (a) return { img: a, clean: true };
            // Sans autorisation CORS, l'image s'affiche mais ne peut pas être exportée.
            const b = await loadImg(src, false);
            if (b) return { img: b, clean: false };
          }
          return { img: null, clean: true };
        })());
      }
      return imgCache.get(base)!;
    }

    /* ---------- Dessin ---------- */
    const THEMES: Record<Theme, { bg: (c: CanvasRenderingContext2D) => void; title: string[]; accent: string; text: string; sub: string; pill: string }> = {
      holo: {
        bg: (c) => {
          c.fillStyle = '#07060d'; c.fillRect(0, 0, W, H);
          glow(c, 900, 120, 700, 'rgba(255,79,216,0.38)'); glow(c, 120, 520, 650, 'rgba(62,240,255,0.30)'); glow(c, 700, 1250, 700, 'rgba(138,123,255,0.30)');
        },
        title: ['#3ef0ff', '#8a7bff', '#ff4fd8', '#ffd25a'], accent: '#ffd25a', text: '#f1effa', sub: '#b9b4d6', pill: 'rgba(7,6,13,0.78)',
      },
      neon: {
        bg: (c) => {
          c.fillStyle = '#030308'; c.fillRect(0, 0, W, H);
          c.strokeStyle = 'rgba(62,240,255,0.10)'; c.lineWidth = 2;
          for (let x = 0; x <= W; x += 54) { c.beginPath(); c.moveTo(x, 0); c.lineTo(x, H); c.stroke(); }
          for (let y = 0; y <= H; y += 54) { c.beginPath(); c.moveTo(0, y); c.lineTo(W, y); c.stroke(); }
          glow(c, W / 2, -100, 800, 'rgba(198,255,74,0.22)'); glow(c, W / 2, H + 100, 800, 'rgba(62,240,255,0.28)');
        },
        title: ['#c6ff4a', '#3ef0ff'], accent: '#c6ff4a', text: '#ecfff6', sub: '#9fd8cf', pill: 'rgba(3,3,8,0.82)',
      },
      gold: {
        bg: (c) => {
          const g = c.createLinearGradient(0, 0, W, H); g.addColorStop(0, '#1a1206'); g.addColorStop(0.5, '#0b0804'); g.addColorStop(1, '#1f1508');
          c.fillStyle = g; c.fillRect(0, 0, W, H);
          glow(c, W / 2, 200, 760, 'rgba(255,210,90,0.25)');
          c.strokeStyle = 'rgba(255,210,90,0.55)'; c.lineWidth = 3; rr(c, 28, 28, W - 56, H - 56, 30); c.stroke();
          c.strokeStyle = 'rgba(255,210,90,0.2)'; c.lineWidth = 1.5; rr(c, 44, 44, W - 88, H - 88, 22); c.stroke();
        },
        title: ['#fff3c4', '#ffd25a', '#c8902a'], accent: '#ffd25a', text: '#fff8e6', sub: '#d9c08a', pill: 'rgba(20,13,4,0.82)',
      },
      night: {
        bg: (c) => {
          const g = c.createLinearGradient(0, 0, 0, H); g.addColorStop(0, '#0b1030'); g.addColorStop(1, '#04050f');
          c.fillStyle = g; c.fillRect(0, 0, W, H);
          let s = 7;
          const r = () => ((s = (s * 16807) % 2147483647) / 2147483647);
          for (let i = 0; i < 160; i++) { c.fillStyle = `rgba(255,255,255,${0.15 + r() * 0.6})`; c.beginPath(); c.arc(r() * W, r() * H, r() * 1.8 + 0.3, 0, Math.PI * 2); c.fill(); }
          glow(c, 860, 160, 260, 'rgba(200,210,255,0.35)');
        },
        title: ['#ffffff', '#a9b8ff'], accent: '#a9b8ff', text: '#eef1ff', sub: '#9aa3cf', pill: 'rgba(4,5,15,0.8)',
      },
    };
    function glow(c: CanvasRenderingContext2D, x: number, y: number, r: number, col: string) {
      const g = c.createRadialGradient(x, y, 0, x, y, r); g.addColorStop(0, col); g.addColorStop(1, 'rgba(0,0,0,0)');
      c.fillStyle = g; c.fillRect(0, 0, W, H);
    }
    function rr(c: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
      c.beginPath(); c.moveTo(x + r, y); c.arcTo(x + w, y, x + w, y + h, r); c.arcTo(x + w, y + h, x, y + h, r); c.arcTo(x, y + h, x, y, r); c.arcTo(x, y, x + w, y, r); c.closePath();
    }
    function fit(c: CanvasRenderingContext2D, text: string, max: number): string {
      if (c.measureText(text).width <= max) return text;
      let t = text;
      while (t.length > 1 && c.measureText(`${t}…`).width > max) t = t.slice(0, -1);
      return `${t}…`;
    }

    function slots(l: Layout, n: number): { x: number; y: number; w: number; h: number }[] {
      const top = 262, bottom = 1186, R = 342 / 245;
      const area = bottom - top;
      if (l === 'grid4') {
        const h = (area - 34) / 2, w = h / R, gx = 40;
        const x0 = (W - (2 * w + gx)) / 2;
        return [0, 1, 2, 3].map((i) => ({ x: x0 + (i % 2) * (w + gx), y: top + Math.floor(i / 2) * (h + 34), w, h })).slice(0, n);
      }
      if (l === 'star') {
        const bh = 640, bw = bh / R, sh = 300, sw = sh / R, g = 24;
        const total = bw + 36 + 2 * sw + g;
        const x0 = (W - total) / 2, y0 = top + (area - bh) / 2 - 4;
        const big = { x: x0, y: y0, w: bw, h: bh };
        const sx = x0 + bw + 36, sy = y0 + (bh - (2 * sh + 40)) / 2;
        const small = [0, 1, 2, 3].map((i) => ({ x: sx + (i % 2) * (sw + g), y: sy + Math.floor(i / 2) * (sh + 40), w: sw, h: sh }));
        return [big, ...small].slice(0, n);
      }
      const h = (area - 2 * 24) / 3, w = h / R, gx = 30;
      const x0 = (W - (3 * w + 2 * gx)) / 2;
      return Array.from({ length: 9 }, (_, i) => ({ x: x0 + (i % 3) * (w + gx), y: top + Math.floor(i / 3) * (h + 24), w, h })).slice(0, n);
    }

    let tainted = false;
    let drawSeq = 0;
    async function draw(forExport = false): Promise<HTMLCanvasElement | null> {
      const my = forExport ? drawSeq : ++drawSeq;
      // L'export se fait sur une toile neuve : une toile qui a reçu une image sans autorisation CORS ne peut plus être exportée.
      const cv = forExport ? Object.assign(document.createElement('canvas'), { width: W, height: H }) : canvas;
      const ctx = cv.getContext('2d')!;
      const T = THEMES[theme];
      const chosen = selected.map((k) => cards.find((c) => c.key === k)).filter((c): c is Pick => !!c);
      if (!forExport) $('rendering').hidden = false;
      await Promise.all([
        document.fonts?.load('800 60px "Unbounded Variable"').catch(() => {}),
        document.fonts?.load('700 30px "Space Grotesk Variable"').catch(() => {}),
      ]);
      const imgs = await Promise.all(chosen.map((c) => cardImage(c.image)));
      if (!forExport && my !== drawSeq) return null;
      if (!forExport) tainted = imgs.some((r) => r.img && !r.clean);

      T.bg(ctx);
      // Titre
      const title = ($('title') as HTMLInputElement).value.trim() || 'Ma vitrine';
      ctx.textBaseline = 'alphabetic';
      let fs = 66;
      do { ctx.font = `800 ${fs}px "Unbounded Variable", system-ui, sans-serif`; fs -= 2; } while (fs > 38 && ctx.measureText(title).width > W - 140);
      const tt = fit(ctx, title, W - 140);
      const tw = ctx.measureText(tt).width;
      const grad = ctx.createLinearGradient((W - tw) / 2, 0, (W + tw) / 2, 0);
      T.title.forEach((col, i) => grad.addColorStop(T.title.length === 1 ? 0 : i / (T.title.length - 1), col));
      ctx.fillStyle = grad; ctx.textAlign = 'center';
      ctx.fillText(tt, W / 2, 150);
      const total = chosen.reduce((s, c) => s + (c.value ?? 0), 0);
      ctx.font = '700 30px "Space Grotesk Variable", system-ui, sans-serif';
      ctx.fillStyle = T.sub;
      const subtitle = ($('show-total') as HTMLInputElement).checked && total > 0
        ? `${chosen.length} carte${chosen.length > 1 ? 's' : ''} · valeur estimée ${eur(total)}`
        : `${chosen.length} carte${chosen.length > 1 ? 's' : ''} de ma collection`;
      ctx.fillText(subtitle, W / 2, 205);

      // Cartes
      const showPrices = ($('show-prices') as HTMLInputElement).checked;
      slots(layout, chosen.length).forEach((s, i) => {
        const c = chosen[i];
        const r = imgs[i];
        const radius = s.w * 0.045;
        ctx.save();
        ctx.shadowColor = 'rgba(0,0,0,0.6)'; ctx.shadowBlur = 30; ctx.shadowOffsetY = 14;
        rr(ctx, s.x, s.y, s.w, s.h, radius); ctx.fillStyle = '#15122a'; ctx.fill();
        ctx.restore();
        ctx.save();
        rr(ctx, s.x, s.y, s.w, s.h, radius); ctx.clip();
        if (r.img && (!forExport || r.clean)) {
          ctx.drawImage(r.img, s.x, s.y, s.w, s.h);
        } else {
          const g = ctx.createLinearGradient(s.x, s.y, s.x + s.w, s.y + s.h);
          g.addColorStop(0, '#3ef0ff'); g.addColorStop(0.35, '#8a7bff'); g.addColorStop(0.7, '#ff4fd8'); g.addColorStop(1, '#ffd25a');
          ctx.fillStyle = g; ctx.fillRect(s.x, s.y, s.w, s.h);
          ctx.fillStyle = 'rgba(7,6,13,0.72)'; ctx.fillRect(s.x + 8, s.y + 8, s.w - 16, s.h - 16);
          ctx.fillStyle = '#fff'; ctx.textAlign = 'center';
          ctx.font = `800 ${Math.round(s.w * 0.1)}px "Unbounded Variable", system-ui`;
          ctx.fillText(fit(ctx, c.name, s.w - 30), s.x + s.w / 2, s.y + s.h * 0.48);
        }
        // reflet holographique discret
        const sh = ctx.createLinearGradient(s.x, s.y, s.x + s.w, s.y + s.h);
        sh.addColorStop(0, 'rgba(255,255,255,0)'); sh.addColorStop(0.45, 'rgba(255,255,255,0.10)'); sh.addColorStop(0.55, 'rgba(255,255,255,0)');
        ctx.fillStyle = sh; ctx.fillRect(s.x, s.y, s.w, s.h);
        ctx.restore();
        if (i === 0 && chosen.length > 1) {
          ctx.save();
          ctx.strokeStyle = T.accent; ctx.lineWidth = 4; ctx.shadowColor = T.accent; ctx.shadowBlur = 24;
          rr(ctx, s.x - 2, s.y - 2, s.w + 4, s.h + 4, radius + 2); ctx.stroke();
          ctx.restore();
        }
        if (showPrices && c.value) {
          const fs = Math.max(20, Math.round(s.w * 0.1));
          ctx.font = `800 ${fs}px "Space Grotesk Variable", system-ui`;
          const label = eur(c.value);
          const pw = ctx.measureText(label).width + fs * 1.1, ph = fs * 1.55;
          const px = s.x + (s.w - pw) / 2, py = s.y + s.h - ph * 0.62;
          ctx.fillStyle = T.pill; rr(ctx, px, py, pw, ph, ph / 2); ctx.fill();
          ctx.strokeStyle = T.accent; ctx.lineWidth = 2; ctx.stroke();
          ctx.fillStyle = T.accent; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
          ctx.fillText(label, s.x + s.w / 2, py + ph / 2 + 1);
          ctx.textBaseline = 'alphabetic';
        }
      });

      // Pied de page
      ctx.textAlign = 'left';
      ctx.font = '800 34px "Unbounded Variable", system-ui';
      const hg = ctx.createLinearGradient(70, 0, 330, 0);
      hg.addColorStop(0, '#3ef0ff'); hg.addColorStop(0.5, '#ff4fd8'); hg.addColorStop(1, '#ffd25a');
      ctx.fillStyle = hg; ctx.fillText('HoloCote', 70, 1282);
      ctx.font = '600 21px "Space Grotesk Variable", system-ui';
      ctx.fillStyle = T.sub; ctx.textAlign = 'right';
      const d = new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
      ctx.fillText(`Cotes indicatives du ${d}`, W - 70, 1266);
      ctx.fillText('Site de fan non officiel', W - 70, 1296);
      if (forExport) return cv;
      $('rendering').hidden = true;
      $('export-note').textContent = tainted
        ? "Certaines illustrations ne peuvent pas être copiées dans l'image téléchargée : elles y seront remplacées par une carte holo avec leur nom."
        : '';
      return cv;
    }

    /* ---------- Sélection ---------- */
    function renderPicks() {
      const max = maxOf(layout);
      $('pick-count').textContent = `${Math.min(selected.length, max)} / ${max}`;
      $('picks').replaceChildren(...cards.map((c) => {
        const pos = selected.indexOf(c.key);
        const on = pos >= 0 && pos < max;
        const b = el('button', { type: 'button', class: `pick ${on ? 'on' : ''}`, 'aria-pressed': String(on), title: c.name }, [
          c.image ? el('img', { src: `${c.image}/low.webp`, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' }) : el('span', { class: 'pk-ph' }, [c.name]),
          on ? el('span', { class: 'pk-n' }, [String(pos + 1)]) : null,
          el('span', { class: 'pk-v' }, [c.value ? eur(c.value) : '—']),
          el('span', { class: 'pk-c' }, [conditionLabel(c.cond)]),
        ]);
        b.addEventListener('click', () => {
          const i = selected.indexOf(c.key);
          if (i >= 0) selected.splice(i, 1);
          else if (selected.length >= max) { toast(`Maximum ${max} cartes pour cette mise en page.`); return; }
          else selected.push(c.key);
          renderPicks();
          draw();
        });
        return b;
      }));
    }
    function autoPick() {
      selected = cards.slice(0, maxOf(layout)).map((c) => c.key);
    }

    function setRadio(attr: string, value: string) {
      document.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((b) => b.setAttribute('aria-checked', String(b.getAttribute(attr) === value)));
    }
    document.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach((b) => b.addEventListener('click', () => {
      theme = b.dataset.theme as Theme; setRadio('data-theme', theme); savePref(); draw();
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-layout]').forEach((b) => b.addEventListener('click', () => {
      layout = b.dataset.layout as Layout; setRadio('data-layout', layout); savePref();
      selected = selected.slice(0, maxOf(layout));
      for (const c of cards) { if (selected.length >= maxOf(layout)) break; if (!selected.includes(c.key)) selected.push(c.key); }
      renderPicks(); draw();
    }));
    let tTimer: number | undefined;
    $('title').addEventListener('input', () => { clearTimeout(tTimer); tTimer = window.setTimeout(() => draw(), 150); });
    $('show-prices').addEventListener('change', () => draw());
    $('show-total').addEventListener('change', () => draw());
    $('auto').addEventListener('click', () => { autoPick(); renderPicks(); draw(); });

    /* ---------- Export ---------- */
    async function blob(): Promise<Blob | null> {
      const cv = tainted ? await draw(true) : canvas;
      if (!cv) return null;
      return new Promise<Blob | null>((res) => { try { cv.toBlob(res, 'image/png'); } catch { res(null); } });
    }
    const fileName = () => `holocote-vitrine-${new Date().toISOString().slice(0, 10)}.png`;
    $('download').addEventListener('click', async () => {
      const b = await blob();
      if (!b) { toast("Impossible de créer l'image sur ce navigateur."); return; }
      const a = el('a', { href: URL.createObjectURL(b), download: fileName() });
      document.body.append(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      toast('Image enregistrée.');
    });
    const canShareFiles = (() => {
      try { return !!navigator.canShare && navigator.canShare({ files: [new File([''], 'x.png', { type: 'image/png' })] }); } catch { return false; }
    })();
    $('share').hidden = !canShareFiles;
    $('share').addEventListener('click', async () => {
      const b = await blob();
      if (!b) return;
      try { await navigator.share({ files: [new File([b], fileName(), { type: 'image/png' })], title: 'Ma vitrine HoloCote' }); } catch { /* annulé */ }
    });

    /* ---------- Démarrage ---------- */
    async function open(list: { id: string; lang: Lang; cond: EntryCard['cond']; qty: number; finish?: 'normal' | 'reverse' }[], isDemo: boolean) {
      demo = isDemo;
      $('vt-empty').hidden = true;
      $('vt-state').hidden = false;
      const res = await priced(list);
      cards = res.map((c, i) => ({ ...c, key: `${c.id}|${list[i].finish ?? 'normal'}|${c.cond}|${i}` }))
        .sort((a, b) => (b.value ?? -1) - (a.value ?? -1));
      $('vt-state').hidden = true;
      $('studio').hidden = false;
      $('demo-note').hidden = !demo;
      ($('title') as HTMLInputElement).value = demo ? 'Le classeur de KaiShiny' : (getPseudo() === 'Toi' ? 'Ma vitrine HoloCote' : `Le classeur de ${getPseudo()}`).slice(0, 32);
      setRadio('data-theme', theme); setRadio('data-layout', layout);
      autoPick(); renderPicks(); draw();
    }
    $('demo').addEventListener('click', () => {
      const kai = RIVALS[0];
      open(kai.cards.map((c) => ({ id: c.id, lang: 'fr' as Lang, cond: c.cond, qty: c.qty ?? 1 })), true);
    });
    const items = getItems();
    if (items.length) open(items.map((i) => ({ id: i.cardId, lang: i.lang, cond: i.condition, qty: i.quantity, finish: i.finish })), false);
    else { $('vt-state').hidden = true; $('vt-empty').hidden = false; }
  </script>

  <style>
    .vt-hero { padding: clamp(24px, 5vw, 56px) 0 24px; }
