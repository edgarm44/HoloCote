    .vt-lead { max-width: 680px; margin: 0; }

    .vt-empty { text-align: center; padding: clamp(28px, 6vw, 60px) 16px; border-radius: 26px; border: 1px dashed rgba(255, 255, 255, 0.18); background: var(--surface); margin-bottom: 28px; }
    .ghosts { position: relative; height: 150px; margin-bottom: 18px; }
    .ghosts span { position: absolute; left: 50%; top: 0; width: 96px; height: 134px; border-radius: 10px; border: 2px dashed rgba(255, 255, 255, 0.22);
      background: linear-gradient(140deg, rgba(62, 240, 255, 0.08), rgba(255, 79, 216, 0.08)); }
    .ghosts span:nth-child(1) { transform: translateX(-130%) rotate(-12deg); }
    .ghosts span:nth-child(2) { transform: translateX(-50%) translateY(-6px); border-color: rgba(255, 210, 90, 0.5); }
    .ghosts span:nth-child(3) { transform: translateX(30%) rotate(12deg); }
    .empty-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

    .studio { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(20px, 4vw, 44px); align-items: start; margin-bottom: 32px; }
    .preview-col { position: sticky; top: 84px; }
    .preview-frame { position: relative; border-radius: 22px; padding: 10px; background: linear-gradient(var(--bg-2), var(--bg-2)) padding-box, var(--holo) border-box; border: 2px solid transparent;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55), 0 0 60px rgba(138, 123, 255, 0.18); }
    .preview-frame canvas { display: block; width: 100%; height: auto; border-radius: 14px; }
    .rendering { position: absolute; inset: 10px; border-radius: 14px; display: grid; place-items: center; background: rgba(7, 6, 13, 0.35); }
    .demo-note { margin: 12px 0 0; font-size: 0.85rem; color: var(--muted); text-align: center; }
    .export { display: flex; gap: 10px; margin-top: 16px; }
    .export .big { flex: 1; min-height: 54px; font-size: 1rem; gap: 10px; }
    .export svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .export-note { margin: 10px 0 0; }

    .controls { display: grid; gap: 22px; }
    .ctl-l { display: block; font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; margin-bottom: 10px; }
    .ctl input[type='text'] { width: 100%; min-height: 50px; font-size: 1.05rem; }
    .themes, .layouts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .layouts { grid-template-columns: repeat(3, 1fr); }
    .themes button, .layouts button { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 12px 8px; border-radius: 16px; cursor: pointer;
      border: 1px solid var(--line); background: var(--surface); color: var(--muted); font-weight: 700; font-size: 0.85rem; transition: border-color 0.2s, transform 0.15s; }
    .themes button:hover, .layouts button:hover { transform: translateY(-2px); }
    .themes button[aria-checked='true'], .layouts button[aria-checked='true'] { color: var(--text); border-color: transparent;
      background: linear-gradient(var(--bg-2), var(--bg-2)) padding-box, var(--holo) border-box; border: 1px solid transparent; }
    .sw { width: 100%; height: 38px; border-radius: 10px; display: block; }
    .sw.holo { background: radial-gradient(circle at 80% 10%, rgba(255, 79, 216, 0.8), transparent 60%), radial-gradient(circle at 10% 80%, rgba(62, 240, 255, 0.7), transparent 60%), #07060d; }
    .sw.neon { background: linear-gradient(rgba(62, 240, 255, 0.25) 1px, transparent 1px) 0 0 / 8px 8px, linear-gradient(90deg, rgba(62, 240, 255, 0.25) 1px, transparent 1px) 0 0 / 8px 8px, radial-gradient(circle at 50% 0, rgba(198, 255, 74, 0.6), transparent 70%), #030308; }
    .sw.gold { background: linear-gradient(135deg, #1a1206, #3a2a0c); box-shadow: inset 0 0 0 2px rgba(255, 210, 90, 0.7); }
    .sw.night { background: radial-gradient(circle at 80% 25%, rgba(220, 225, 255, 0.9) 0 4px, transparent 6px), radial-gradient(1px 1px at 20% 30%, #fff, transparent), radial-gradient(1px 1px at 50% 70%, #fff, transparent), linear-gradient(#0b1030, #04050f); }
    .lt { display: grid; gap: 3px; width: 46px; height: 40px; }
    .lt i { background: currentColor; border-radius: 2px; opacity: 0.75; }
    .lt9 { grid-template-columns: repeat(3, 1fr); }
    .lt4 { grid-template-columns: repeat(2, 1fr); width: 34px; }
    .lts { grid-template-columns: 1.4fr 1fr 1fr; grid-template-rows: 1fr 1fr; }
    .lts i:first-child { grid-row: span 2; }

    .toggles { display: flex; gap: 18px; flex-wrap: wrap; }
    .tg { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 600; }
    .tg input { position: absolute; opacity: 0; width: 1px; height: 1px; }
    .tg-ui { width: 44px; height: 26px; border-radius: 99px; background: var(--surface-2); border: 1px solid var(--line); position: relative; transition: background 0.2s; flex: 0 0 44px; }
    .tg-ui::after { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: var(--muted); transition: transform 0.2s, background 0.2s; }
    .tg input:checked + .tg-ui { background: rgba(62, 240, 255, 0.25); border-color: rgba(62, 240, 255, 0.6); }
    .tg input:checked + .tg-ui::after { transform: translateX(18px); background: var(--cyan); }
    .tg input:focus-visible + .tg-ui { outline: 2px solid var(--cyan); outline-offset: 2px; }

    .pick-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
    .link-btn { background: none; border: 0; padding: 0; color: var(--cyan); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; font-size: 0.88rem; }
    .picks { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 10px; max-height: 560px; overflow: auto; padding: 4px; margin: -4px; }
    .picks :global(.pick) { position: relative; padding: 0; border: 2px solid transparent; border-radius: 12px; background: var(--bg-2); cursor: pointer; aspect-ratio: 245 / 342;
      overflow: hidden; opacity: 0.55; transition: opacity 0.2s, transform 0.15s, border-color 0.2s; }
    .picks :global(.pick:hover) { opacity: 0.85; transform: translateY(-2px); }
    .picks :global(.pick.on) { opacity: 1; border-color: var(--cyan); box-shadow: 0 0 18px rgba(62, 240, 255, 0.35); }
    .picks :global(.pick img) { width: 100%; height: 100%; object-fit: cover; }
    .picks :global(.pk-ph) { display: grid; place-items: center; height: 100%; padding: 6px; font-size: 0.75rem; font-weight: 700; }
    .picks :global(.pk-n) { position: absolute; top: 5px; left: 5px; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center;
      background: var(--cyan); color: #0a0812; font-weight: 800; font-size: 0.78rem; }
    .picks :global(.pk-v) { position: absolute; left: 4px; right: 4px; bottom: 4px; padding: 2px 4px; border-radius: 8px; background: rgba(7, 6, 13, 0.85);
      font-size: 0.72rem; font-weight: 800; color: var(--gold); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .picks :global(.pk-c) { position: absolute; top: 5px; right: 5px; padding: 1px 6px; border-radius: 6px; background: rgba(7, 6, 13, 0.8); font-size: 0.62rem; font-weight: 700; }

    @media (max-width: 900px) {
      .studio { grid-template-columns: 1fr; }
      .preview-col { position: static; }
    }
    @media (max-width: 520px) {
      .themes { grid-template-columns: repeat(2, 1fr); }
      .export { flex-direction: column; }
    }
  </style>
</Base>
