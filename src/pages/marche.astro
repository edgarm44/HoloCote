---
import Base from '../layouts/Base.astro';
---
<Base title="Marché" active="market" description="Le cours des cartes à collectionner, façon bourse : hausses, baisses, indice HoloCote.">
  <section class="mk-head">
    <div>
      <p class="eyebrow">Bourse des cartes</p>
      <h1>Le <span class="holo-text">Marché</span></h1>
      <p class="muted">Les cartes les plus recherchées et les nouveautés, avec leur cours et leurs variations, comme en bourse.</p>
    </div>
    <div class="panel index-card" id="index-card">
      <div class="index-top">
        <span class="index-label">Indice HoloCote</span>
        <span class="live"><span class="pulse"></span>Cotes Cardmarket</span>
      </div>
      <div class="index-row">
        <span class="index-value" id="index-value">—</span>
        <div class="index-chg">
          <span id="index-7">—</span>
          <span class="muted small">sur 7 jours</span>
        </div>
      </div>
      <div id="index-chart" class="index-chart"></div>
      <p class="muted small">Base 100 = valeur moyenne des cartes suivies sur 30 jours.</p>
    </div>
  </section>

  <div id="ticker-slot" class="ticker-slot"></div>

  <div id="state" aria-live="polite">
    <div class="status" role="status"><div class="spinner"></div>Chargement des cours…</div>
  </div>

  <section class="movers" id="movers" hidden>
    <div class="panel mover">
      <h2><span class="up">▲</span> Plus fortes hausses</h2>
      <ol id="gainers"></ol>
    </div>
    <div class="panel mover">
      <h2><span class="down">▼</span> Plus fortes baisses</h2>
      <ol id="losers"></ol>
    </div>
    <div class="panel mover">
      <h2><span class="gold">◆</span> Les plus chères</h2>
      <ol id="top"></ol>
    </div>
  </section>

  <section class="panel portfolio" id="portfolio" hidden>
    <div>
      <p class="eyebrow">Mon portefeuille</p>
      <h2 id="pf-value">—</h2>
      <p class="muted small" id="pf-detail"></p>
    </div>
    <div class="pf-chg">
      <span id="pf-chg">—</span>
      <span class="muted small">vs moyenne 30 jours</span>
    </div>
  </section>

  <section class="board" id="board" hidden>
    <div class="board-bar">
      <div class="chips" role="group" aria-label="Filtrer">
        <button type="button" data-group="all" aria-pressed="true">Toutes</button>
        <button type="button" data-group="legend" aria-pressed="false">Légendaires</button>
        <button type="button" data-group="new" aria-pressed="false">Nouveautés</button>
      </div>
      <label class="sr-only" for="sort">Trier</label>
      <select id="sort">
        <option value="change7">Variation 7 j</option>
        <option value="price">Cours</option>
        <option value="name">Nom</option>
      </select>
    </div>
    <div class="table" role="table" aria-label="Cours des cartes">
      <div class="tr th" role="row">
        <span role="columnheader">Carte</span>
        <span role="columnheader" class="num">Cours</span>
        <span role="columnheader" class="num">Moy. 30 j</span>
        <span role="columnheader" class="num">7 j</span>
        <span role="columnheader" class="chart-col">Tendance</span>
      </div>
      <div id="rows"></div>
    </div>
  </section>

  <p class="notice">
    Cours = cote HoloCote, identique à la fiche carte : médiane de la tendance, du prix moyen de vente et des moyennes 7 et 30 jours de Cardmarket
    (en euros, version normale, toutes langues et tous états confondus). Variation 7 j = moyenne des 7 derniers jours comparée à celle des 30 jours.
    Les mini-graphiques relient ces repères (moyenne 30 j, moyenne 7 j, cours) : ce n'est pas un historique jour par jour.
    Ce n'est pas un conseil d'investissement.
  </p>

  <script>
    import { loadMarket, sparkline, ticker, formatChange, changeClass, toQuote, type Quote } from '../lib/market';
    import { formatPrice, formatDate, getCard, type Card } from '../lib/tcgdex';
    import { getItems } from '../lib/collection';
    import { conditionFactor } from '../lib/condition';
    import { el, url, favForBrief } from '../lib/ui';

    const $ = (id: string) => document.getElementById(id)!;
    const href = (q: Quote) => url(`/carte/?id=${encodeURIComponent(q.id)}&lang=${q.lang}`);
    const eur = (v: number) => formatPrice(v, 'EUR');
    const thumb = (q: Quote) => {
      const box = el('span', { class: 'thumb' });
      if (q.image) box.append(el('img', { src: `${q.image}/low.webp`, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' }));
      return box;
    };
    const chg = (v?: number) => el('span', { class: `chg ${changeClass(v)}` }, [formatChange(v)]);

    let quotes: Quote[] = [];
    let group: 'all' | 'legend' | 'new' = 'all';

    function moverList(target: HTMLElement, list: Quote[], value: (q: Quote) => Node) {
      target.replaceChildren(...list.map((q) =>
        el('li', {}, [el('a', { href: href(q) }, [thumb(q), el('span', { class: 'mv-name' }, [q.name, el('small', {}, [q.setName ?? ''])]), value(q)])]),
      ));
    }

    function renderBoard() {
      const sort = ($('sort') as HTMLSelectElement).value;
      const list = quotes
        .filter((q) => group === 'all' || q.group === group)
        .sort((a, b) =>
          sort === 'name' ? a.name.localeCompare(b.name, 'fr')
          : sort === 'price' ? b.price - a.price
          : ((b.change7 ?? -1e9) - (a.change7 ?? -1e9)));
      $('rows').replaceChildren(...list.map((q, i) => el('div', { class: 'row-wrap' }, [
        el('a', { class: 'tr', role: 'row', href: href(q) }, [
          el('span', { class: 'card-cell', role: 'cell' }, [
            el('span', { class: 'rank' }, [String(i + 1)]),
            thumb(q),
            el('span', { class: 'mv-name' }, [q.name, el('small', {}, [[q.setName, q.group === 'new' ? 'Nouveauté' : ''].filter(Boolean).join(' · ')])]),
          ]),
          el('span', { class: 'num price', role: 'cell' }, [eur(q.price)]),
          el('span', { class: 'num muted', role: 'cell' }, [q.avg30 ? eur(q.avg30) : '—']),
          el('span', { class: 'num', role: 'cell' }, [chg(q.change7)]),
          el('span', { class: 'chart-col', role: 'cell' }, [sparkline(q.points, 110, 34)]),
        ]),
        favForBrief({ id: q.id, localId: '', name: q.name, image: q.image }, q.lang, 'row-fav'),
      ])));
    }

    async function renderPortfolio() {
      const items = getItems().filter((i) => i.finish === 'normal');
      if (!items.length) return;
      let now = 0, then = 0, counted = 0;
      const cards = await Promise.all(items.map((i) => getCard(i.cardId, i.lang).catch(() => null as Card | null)));
      items.forEach((it, idx) => {
        const c = cards[idx];
        const q = c && toQuote(c, it.lang, 'legend');
        if (!q || !q.avg30) return;
        const f = conditionFactor(it.condition) * it.quantity;
        now += q.price * f;
        then += q.avg30 * f;
        counted += it.quantity;
      });
      if (!counted) return;
      const p = ((now - then) / then) * 100;
      $('pf-value').textContent = eur(now);
      $('pf-detail').textContent = `${counted} carte${counted > 1 ? 's' : ''} de ta collection avec une cote Cardmarket (versions normales).`;
      const c = $('pf-chg');
      c.textContent = formatChange(p);
      c.className = `big-chg ${changeClass(p)}`;
      $('portfolio').hidden = false;
    }

    async function main() {
      let market;
      try {
        market = await loadMarket();
      } catch {
        market = null;
      }
      if (!market || !market.quotes.length) {
        $('state').replaceChildren(el('div', { class: 'status' }, ['Impossible de charger les cours pour le moment. Réessaie dans un instant.']));
        return;
      }
      quotes = market.quotes;
      $('state').replaceChildren();
      if (market.index) {
        $('index-value').textContent = market.index.value.toFixed(1).replace('.', ',');
        const i7 = $('index-7');
        i7.textContent = formatChange(market.index.change7);
        i7.className = `big-chg ${changeClass(market.index.change7)}`;
        const withHist = quotes.filter((q) => q.avg30);
        const s = (f: (q: Quote) => number | undefined) => withHist.reduce((t, q) => t + (f(q) ?? q.price), 0);
        const base = s((q) => q.avg30);
        const pts = [base, s((q) => q.avg7), s((q) => q.price)].map((v) => (v / base) * 100);
        $('index-chart').replaceChildren(sparkline(pts, 320, 70));
      }
      const updated = quotes.map((q) => q.updated).filter(Boolean).sort().pop();
      if (updated) $('index-card').querySelector('.live')!.lastChild!.textContent = `Cotes du ${formatDate(updated)}`;

      $('ticker-slot').replaceChildren(ticker(quotes.filter((q) => q.change7 !== undefined), href, eur));

      const byChg = quotes.filter((q) => q.change7 !== undefined).sort((a, b) => b.change7! - a.change7!);
      moverList($('gainers'), byChg.filter((q) => q.change7! > 0).slice(0, 5), (q) => chg(q.change7));
      moverList($('losers'), byChg.filter((q) => q.change7! < 0).reverse().slice(0, 5), (q) => chg(q.change7));
      moverList($('top'), [...quotes].sort((a, b) => b.price - a.price).slice(0, 5), (q) => el('span', { class: 'mv-price' }, [eur(q.price)]));
      for (const id of ['gainers', 'losers']) {
        if (!$(id).children.length) $(id).replaceChildren(el('li', { class: 'muted small' }, ['Rien à signaler cette semaine.']));
      }
      $('movers').hidden = false;
      $('board').hidden = false;
      renderBoard();
      renderPortfolio();
    }

    document.querySelectorAll<HTMLButtonElement>('[data-group]').forEach((b) =>
      b.addEventListener('click', () => {
        group = b.dataset.group as typeof group;
        document.querySelectorAll('[data-group]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        renderBoard();
      }),
    );
    $('sort').addEventListener('change', renderBoard);
    main();
  </script>

  <style>
    .eyebrow { text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.75rem; color: var(--cyan); margin: 0 0 6px; font-weight: 700; }
    .mk-head { display: grid; gap: 24px; grid-template-columns: 1fr; padding: 20px 0 24px; align-items: end; }
    @media (min-width: 900px) { .mk-head { grid-template-columns: 1fr 400px; } }
    .index-card {
      background: linear-gradient(160deg, rgba(62, 240, 255, 0.07), rgba(255, 79, 216, 0.06)), var(--surface);
      border-color: rgba(138, 123, 255, 0.35);
    }
    .index-card p { margin: 6px 0 0; }
    .index-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .index-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 700; }
    .live { display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; color: var(--muted); }
    .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--up); box-shadow: 0 0 0 0 rgba(61, 255, 168, 0.6); animation: pulse 2s infinite; }
    @keyframes pulse { 70% { box-shadow: 0 0 0 8px rgba(61, 255, 168, 0); } 100% { box-shadow: 0 0 0 0 rgba(61, 255, 168, 0); } }
    .index-row { display: flex; align-items: baseline; gap: 16px; margin: 6px 0 4px; flex-wrap: wrap; }
    .index-value { font-family: var(--font-display); font-size: clamp(2.4rem, 7vw, 3.2rem); font-weight: 700; font-variant-numeric: tabular-nums; }
    .index-chg { display: flex; flex-direction: column; }
    .big-chg { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; }
    .index-chart { width: 100%; }
    .index-chart :global(svg) { width: 100%; height: 70px; }
    .ticker-slot { margin: 0 -16px 24px; }
    .gold { color: var(--gold); }

    .movers { display: grid; gap: 16px; grid-template-columns: 1fr; margin-bottom: 24px; }
    @media (min-width: 900px) { .movers { grid-template-columns: repeat(3, 1fr); } }
    .mover h2 { font-size: 1rem; margin-bottom: 12px; }
    .mover ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
    .mover :global(li a) {
      display: grid; grid-template-columns: 36px 1fr auto; gap: 10px; align-items: center;
      text-decoration: none; color: var(--text); padding: 6px; border-radius: 10px;
    }
    .mover :global(li a:hover) { background: var(--surface-2); }

    .portfolio {
      display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 24px;
      border-color: rgba(255, 210, 90, 0.3);
      background: radial-gradient(circle at 90% 50%, rgba(255, 210, 90, 0.1), transparent 60%), var(--surface);
    }
    .portfolio h2 { margin: 0; font-size: 1.8rem; }
    .portfolio p { margin: 4px 0 0; }
    .pf-chg { display: flex; flex-direction: column; align-items: flex-end; }

    .board-bar { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
    .board-bar select { width: auto; }
    .chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .chips button {
      border: 1px solid var(--line); background: var(--surface); color: var(--muted);
      padding: 8px 14px; border-radius: 999px; cursor: pointer; font-weight: 600; font-size: 0.85rem;
    }
    .chips button[aria-pressed='true'] { color: #0a0812; background: var(--holo); border-color: transparent; }
    .table { border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: var(--bg-2); margin-bottom: 20px; }
    .table :global(.tr) {
      display: grid; grid-template-columns: 1fr 90px 86px 74px 120px; gap: 10px; align-items: center;
      padding: 10px 14px; border-top: 1px solid var(--line); text-decoration: none; color: var(--text);
    }
    .table :global(.row-wrap) { position: relative; }
    .table :global(.row-wrap .tr), .table .th { padding-right: 58px; }
    .table :global(.row-fav) { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); }
    .table .th { border-top: 0; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 700; background: var(--surface); }
    .table :global(a.tr:hover) { background: var(--surface); }
    .table :global(.num) { text-align: right; font-variant-numeric: tabular-nums; }
    .table :global(.price) { font-weight: 700; }
    .table :global(.chart-col) { display: flex; justify-content: flex-end; }
    @media (max-width: 640px) {
      .table :global(.tr) { grid-template-columns: 1fr 76px 64px; padding: 10px 52px 10px 10px; }
      .table :global(.tr > :nth-child(3)), .table :global(.chart-col) { display: none; }
    }
    :global(.card-cell) { display: flex; align-items: center; gap: 10px; min-width: 0; }
    :global(.rank) { width: 20px; color: var(--muted); font-size: 0.8rem; text-align: right; flex: 0 0 20px; }
    :global(.thumb) { width: 36px; aspect-ratio: 245 / 342; border-radius: 3px; overflow: hidden; background: var(--surface-2); flex: 0 0 36px; display: block; }
    :global(.thumb img) { width: 100%; height: 100%; object-fit: cover; }
    :global(.mv-name) { display: flex; flex-direction: column; min-width: 0; font-weight: 600; font-size: 0.92rem; line-height: 1.25; }
    :global(.mv-name small) { font-weight: 400; color: var(--muted); font-size: 0.75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    :global(.chg) { font-weight: 700; font-variant-numeric: tabular-nums; font-size: 0.9rem; }
    :global(.mv-price) { font-weight: 700; font-variant-numeric: tabular-nums; }
  </style>
</Base>
