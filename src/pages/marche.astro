---
import Base from '../layouts/Base.astro';
---
<Base title="Marché" active="market" description="Le cours des cartes à collectionner, façon bourse : hausses, baisses, indice HoloCote.">
  <section class="mk-head">
    <div>
      <h1 class="mk-title">Le Marché.</h1>
      <p class="mk-slogan">Ce qui monte, ce qui chute, ce qui vaut le plus.</p>
      <p class="muted">Les cartes les plus recherchées et les nouveautés, avec leur cours et leurs variations, comme en bourse.</p>
    </div>
    <div class="panel index-card" id="index-card">
      <div class="index-top">
        <span class="index-label">Indice HoloCote</span>
        <span class="live"><span class="pulse"></span><span id="live-text">Cotes Cardmarket</span></span>
      </div>
      <div class="index-row">
        <span class="index-value" id="index-value">—</span>
        <div class="index-chg">
          <span id="index-7">—</span>
          <span class="muted small">sur 7 jours</span>
        </div>
      </div>
      <div id="index-chart" class="index-chart"></div>
      <p class="muted small">Base 100 = valeur moyenne des cartes suivies sur 30 jours.</p>
    </div>
  </section>

  <div class="control-bar" id="control-bar">
    <div class="cb-info">
      <span class="cb-live"><span class="pulse"></span><span id="cb-date">Cotes Cardmarket</span></span>
      <span class="cb-ago" id="cb-ago">Chargement…</span>
    </div>
    <button type="button" class="refresh-btn" id="refresh">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 0 0-14.3-4.9L4 8M4 4v4h4M4 13a8 8 0 0 0 14.3 4.9L20 16M20 20v-4h-4" /></svg>
      <span class="rb-label">Actualiser les cours</span>
    </button>
  </div>

  <div id="ticker-slot" class="ticker-slot"></div>

  <section class="stats" id="stats" hidden>
    <div class="stat-box"><span class="sb-label">Cartes suivies</span><span class="sb-value" id="st-n">—</span></div>
    <div class="stat-box breadth">
      <span class="sb-label">Hausse / baisse</span>
      <span class="sb-value"><span class="up" id="st-up">0</span> <span class="muted">/</span> <span class="down" id="st-down">0</span></span>
      <span class="breadth-bar"><span id="st-bar"></span></span>
    </div>
    <div class="stat-box"><span class="sb-label">Variation moyenne 7 j</span><span class="sb-value" id="st-avg">—</span></div>
    <div class="stat-box"><span class="sb-label">Valeur cumulée</span><span class="sb-value" id="st-sum">—</span></div>
  </section>

  <section class="panel chart-panel" id="chart-panel" hidden>
    <div class="cp-head">
      <div>
        <h2 id="cp-title">Indice HoloCote</h2>
        <p class="muted small" id="cp-sub">Toutes les cartes suivies, base 100 = moyenne 30 jours.</p>
      </div>
      <div class="cp-actions">
        <button type="button" class="btn" id="cp-index" hidden>Revenir à l'indice</button>
        <a class="btn" id="cp-open" hidden>Voir la fiche</a>
      </div>
    </div>
    <div class="cp-chart" id="cp-chart"></div>
    <div class="cp-facts" id="cp-facts"></div>
    <p class="muted small">Touche l'icône graphique d'une carte dans le tableau pour afficher sa courbe ici.</p>
  </section>

  <div id="state" aria-live="polite">
    <div class="status" role="status"><div class="spinner"></div>Chargement des cours…</div>
  </div>

  <section class="movers" id="movers" hidden>
    <div class="panel mover">
      <h2><span class="up">▲</span> Plus fortes hausses</h2>
      <ol id="gainers"></ol>
    </div>
    <div class="panel mover">
      <h2><span class="down">▼</span> Plus fortes baisses</h2>
      <ol id="losers"></ol>
    </div>
    <div class="panel mover">
      <h2><span class="gold">◆</span> Les plus chères</h2>
      <ol id="top"></ol>
    </div>
  </section>

  <section class="heat" id="heat" hidden>
    <h2 class="sec-title">La carte thermique</h2>
    <p class="muted">Vert : ça monte. Rouge : ça baisse. Plus la couleur est forte, plus ça bouge. Les plus grosses cases sont les cartes les plus chères.</p>
    <div class="heat-grid" id="heat-grid"></div>
  </section>

  <section class="panel portfolio" id="portfolio" hidden>
    <div>
      <p class="eyebrow">Mon portefeuille</p>
      <h2 id="pf-value">—</h2>
      <p class="muted small" id="pf-detail"></p>
    </div>
    <div class="pf-chg">
      <span id="pf-chg">—</span>
      <span class="muted small">vs moyenne 30 jours</span>
    </div>
  </section>

  <section class="board" id="board" hidden>
    <div class="board-bar">
      <div class="chips" role="group" aria-label="Filtrer par époque">
        <button type="button" data-group="all" aria-pressed="true">Toutes <b class="chip-n" data-n="all"></b></button>
        <button type="button" data-group="classic" aria-pressed="false">Classiques <b class="chip-n" data-n="classic"></b></button>
        <button type="button" data-group="swsh" aria-pressed="false">Épée et Bouclier <b class="chip-n" data-n="swsh"></b></button>
        <button type="button" data-group="sv" aria-pressed="false">Écarlate et Violet <b class="chip-n" data-n="sv"></b></button>
        <button type="button" data-group="mega" aria-pressed="false">Méga-Évolution <b class="chip-n" data-n="mega"></b></button>
        <button type="button" data-group="new" aria-pressed="false">Nouveautés <b class="chip-n" data-n="new"></b></button>
      </div>
      <div class="board-tools">
      <label class="sr-only" for="board-q">Filtrer par nom</label>
      <input id="board-q" type="search" placeholder="Filtrer : Dracaufeu, Mew…" autocomplete="off" />
      <label class="sr-only" for="sort">Trier</label>
      <select id="sort">
        <option value="change7">Variation 7 j</option>
        <option value="price">Cours</option>
        <option value="name">Nom</option>
      </select>
      </div>
    </div>
    <div class="table" role="region" aria-label="Cours des cartes">
      <div class="tr th" aria-hidden="true">
        <span>Carte</span>
        <span class="num">Cours</span>
        <span class="num">Moy. 30 j</span>
        <span class="num">7 j</span>
        <span class="chart-col">Tendance</span>
      </div>
      <div id="rows" role="list"></div>
      <p class="rows-empty muted" id="rows-empty" hidden>Aucune carte ne correspond à ce filtre.</p>
    </div>
    <button type="button" class="btn more-rows" id="more-rows" hidden></button>
  </section>

  <p class="notice">
    Cours = cote HoloCote, identique à la fiche carte : médiane de la tendance, du prix moyen de vente et des moyennes 7 et 30 jours de Cardmarket
    (en euros, version normale, toutes langues et tous états confondus). Variation 7 j = moyenne des 7 derniers jours comparée à celle des 30 jours.
    Les mini-graphiques relient ces repères (moyenne 30 j, moyenne 7 j, cours) : ce n'est pas un historique jour par jour.
    Un « ? » signale une cote incertaine (repères Cardmarket très écartés) : ces cartes sont exclues du Duel et des Opportunités. Ce n'est pas un conseil d'investissement.
  </p>

  <script>
    import { loadMarket, sparkline, bigChart, ticker, formatChange, changeClass, toQuote, eraOf, type Quote, type Era } from '../lib/market';
    import { normalize } from '../lib/cardindex';
    import { formatPrice, formatDate, priceAgeText, getCard, type Card } from '../lib/tcgdex';
    import { indexSeries } from '../lib/history';
    import { getItems } from '../lib/collection';
    import { conditionFactor } from '../lib/condition';
    import { el, url, favForBrief } from '../lib/ui';

    const $ = (id: string) => document.getElementById(id)!;
    const href = (q: Quote) => url(`/carte/?id=${encodeURIComponent(q.id)}&lang=${q.lang}`);
    const eur = (v: number) => formatPrice(v, 'EUR');
    const thumb = (q: Quote) => {
      const box = el('span', { class: 'thumb' });
      if (q.image) box.append(el('img', { src: `${q.image}/low.webp`, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' }));
      return box;
    };
    const chg = (v?: number) => el('span', { class: `chg ${changeClass(v)}` }, [formatChange(v)]);

    let quotes: Quote[] = [];
    let group: 'all' | 'new' | Era = 'all';
    const PAGE = 20;
    let shown = PAGE;
    const inGroup = (q: Quote, g: typeof group) => g === 'all' || (g === 'new' ? q.group === 'new' : eraOf(q.id) === g);

    function moverList(target: HTMLElement, list: Quote[], value: (q: Quote) => Node) {
      target.replaceChildren(...list.map((q) =>
        el('li', {}, [el('a', { href: href(q) }, [thumb(q), el('span', { class: 'mv-name' }, [q.name, el('small', {}, [q.setName ?? ''])]), value(q)])]),
      ));
    }

    function renderBoard() {
      const sort = ($('sort') as HTMLSelectElement).value;
      const nq = normalize(($('board-q') as HTMLInputElement).value);
      document.querySelectorAll<HTMLElement>('[data-n]').forEach((b) => { b.textContent = String(quotes.filter((q) => inGroup(q, b.dataset.n as typeof group)).length); });
      const all = quotes
        .filter((q) => inGroup(q, group) && (!nq || normalize(q.name).includes(nq) || normalize(q.setName ?? '').includes(nq)))
        .sort((a, b) =>
          sort === 'name' ? a.name.localeCompare(b.name, 'fr')
          : sort === 'price' ? b.price - a.price
          : ((b.change7 ?? -1e9) - (a.change7 ?? -1e9)));
      const list = all.slice(0, shown);
      const more = $('more-rows') as HTMLButtonElement;
      more.hidden = all.length <= shown;
      more.textContent = `Voir ${Math.min(PAGE, all.length - shown)} cartes de plus (${all.length - shown} restantes)`;
      $('rows-empty').hidden = all.length > 0;
      $('rows').replaceChildren(...list.map((q, i) => el('div', { class: 'row-wrap', role: 'listitem' }, [
        el('a', { class: 'tr', href: href(q) }, [
          el('span', { class: 'card-cell' }, [
            el('span', { class: 'rank' }, [String(i + 1)]),
            thumb(q),
            el('span', { class: 'mv-name' }, [q.name, el('small', {}, [[q.setName, q.group === 'new' ? 'Nouveauté' : ''].filter(Boolean).join(' · ')])]),
          ]),
          el('span', { class: 'num price', title: q.unsure ? 'Cote incertaine : ventes récentes très variables' : '' }, [eur(q.price), q.unsure ? el('sup', { class: 'unsure' }, ['?']) : null]),
          el('span', { class: 'num muted' }, [q.avg30 ? eur(q.avg30) : '—']),
          el('span', { class: 'num' }, [chg(q.change7)]),
          el('span', { class: 'chart-col' }, [sparkline(q.points, 110, 34)]),
        ]),
        graphBtn(q),
        favForBrief({ id: q.id, localId: '', name: q.name, image: q.image }, q.lang, 'row-fav'),
      ])));
    }


    /* ---------- Grand graphique ---------- */
    let chartState: { kind: 'index' } | { kind: 'card'; q: Quote } = { kind: 'index' };
    function indexPoints() {
      const withHist = quotes.filter((q) => q.avg30);
      const s = (f: (q: Quote) => number | undefined) => withHist.reduce((t, q) => t + (f(q) ?? q.price), 0);
      const base = s((q) => q.avg30);
      return base ? [base, s((q) => q.avg7), s((q) => q.price)].map((v) => (v / base) * 100) : null;
    }
    function fact(label: string, value: string, cls = '') {
      return el('div', { class: 'fact' }, [el('span', { class: 'f-label' }, [label]), el('span', { class: `f-value ${cls}` }, [value])]);
    }
    function renderChart() {
      const box = $('cp-chart');
      const w = Math.max(300, Math.min(1100, box.clientWidth || 700));
      const h = w < 520 ? 220 : 280;
      if (chartState.kind === 'index') {
        const pts = indexPoints();
        if (!pts) return;
        $('cp-title').textContent = 'Indice HoloCote';
        $('cp-sub').textContent = 'Toutes les cartes suivies, base 100 = moyenne 30 jours.';
        $('cp-index').hidden = true;
        ($('cp-open') as HTMLAnchorElement).hidden = true;
        box.replaceChildren(bigChart(pts, ['Moyenne 30 j', 'Moyenne 7 j', "Aujourd'hui"], (v) => v.toFixed(1).replace('.', ','), w, h));
        const up = quotes.filter((q) => (q.change7 ?? 0) > 0).length;
        $('cp-facts').replaceChildren(
          fact('Indice', pts[2].toFixed(1).replace('.', ',')),
          fact('Sur 7 jours', formatChange(((pts[1] - pts[0]) / pts[0]) * 100), changeClass(((pts[1] - pts[0]) / pts[0]) * 100)),
          fact('Cartes en hausse', `${up} sur ${quotes.length}`),
        );
      } else {
        const q = chartState.q;
        const pts = [q.avg30, q.avg7, q.price].filter((x): x is number => x !== undefined);
        const labels = [q.avg30 ? 'Moyenne 30 j' : '', q.avg7 ? 'Moyenne 7 j' : '', "Aujourd'hui"].filter(Boolean);
        $('cp-title').textContent = q.name;
        $('cp-sub').textContent = [q.setName, q.group === 'new' ? 'Nouveauté' : 'Légendaire'].filter(Boolean).join(', ');
        $('cp-index').hidden = false;
        const open = $('cp-open') as HTMLAnchorElement;
        open.hidden = false;
        open.href = href(q);
        box.replaceChildren(pts.length >= 2 ? bigChart(pts, labels, eur, w, h) : el('p', { class: 'muted' }, ['Pas assez de repères pour tracer une courbe.']));
        const spread = q.avg30 ? ((q.price - q.avg30) / q.avg30) * 100 : undefined;
        $('cp-facts').replaceChildren(
          fact('Cours', eur(q.price)),
          fact('Moyenne 30 j', q.avg30 ? eur(q.avg30) : '—'),
          fact('Sources', q.sources ? `${q.sources} sources recoupées` : 'Cardmarket'),
          fact('Variation 7 j', formatChange(q.change7), changeClass(q.change7)),
          fact('Écart au mois', formatChange(spread), changeClass(spread)),
        );
      }
    }
    function graphBtn(q: Quote) {
      const b = el('button', { type: 'button', class: 'row-graph', 'aria-label': `Afficher la courbe de ${q.name}`, title: 'Afficher la courbe' });
      b.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8M15 7h6v6" /></svg>';
      b.addEventListener('click', (e) => {
        e.preventDefault();
        chartState = { kind: 'card', q };
        renderChart();
        $('chart-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      return b;
    }
    window.addEventListener('resize', () => { if (!$('chart-panel').hidden) renderChart(); });

    /* ---------- Statistiques et carte thermique ---------- */
    function renderStats() {
      const withChg = quotes.filter((q) => q.change7 !== undefined);
      const up = withChg.filter((q) => q.change7! > 0.5).length;
      const down = withChg.filter((q) => q.change7! < -0.5).length;
      $('st-n').textContent = String(quotes.length);
      $('st-up').textContent = String(up);
      $('st-down').textContent = String(down);
      ($('st-bar') as HTMLElement).style.width = `${up + down ? (up / (up + down)) * 100 : 50}%`;
      const avg = withChg.length ? withChg.reduce((s, q) => s + q.change7!, 0) / withChg.length : undefined;
      const a = $('st-avg'); a.textContent = formatChange(avg); a.className = `sb-value ${changeClass(avg)}`;
      $('st-sum').textContent = eur(quotes.reduce((s, q) => s + q.price, 0));
      $('stats').hidden = false;
    }
    function renderHeat() {
      const list = [...quotes].sort((a, b) => b.price - a.price).slice(0, 30);
      $('heat-grid').replaceChildren(...list.map((q, i) => {
        const c = q.change7 ?? 0;
        const k = Math.min(1, Math.abs(c) / 25);
        const bg = c > 0.5 ? `rgba(61, 255, 168, ${0.12 + k * 0.5})` : c < -0.5 ? `rgba(255, 90, 122, ${0.12 + k * 0.5})` : 'rgba(255, 255, 255, 0.06)';
        const a = el('a', { class: `heat-cell ${i < 2 ? 'xl' : i < 6 ? 'l' : ''}`, href: href(q), title: `${q.name} : ${formatChange(q.change7)}` }, [
          el('span', { class: 'hc-name' }, [q.name]),
          el('span', { class: 'hc-chg' }, [formatChange(q.change7)]),
          el('span', { class: 'hc-price' }, [eur(q.price)]),
        ]);
        a.style.background = bg;
        return a;
      }));
      $('heat').hidden = false;
    }

    async function renderPortfolio() {
      const items = getItems().filter((i) => i.finish === 'normal');
      if (!items.length) return;
      let now = 0, then = 0, counted = 0;
      const cards = await Promise.all(items.map((i) => getCard(i.cardId, i.lang).catch(() => null as Card | null)));
      items.forEach((it, idx) => {
        const c = cards[idx];
        const q = c && toQuote(c, it.lang, 'legend');
        if (!q || !q.avg30) return;
        const f = conditionFactor(it.condition) * it.quantity;
        now += q.price * f;
        then += q.avg30 * f;
        counted += it.quantity;
      });
      if (!counted) return;
      const p = ((now - then) / then) * 100;
      $('pf-value').textContent = eur(now);
      $('pf-detail').textContent = `${counted} carte${counted > 1 ? 's' : ''} de ta collection avec une cote Cardmarket (versions normales).`;
      const c = $('pf-chg');
      c.textContent = formatChange(p);
      c.className = `big-chg ${changeClass(p)}`;
      $('portfolio').hidden = false;
    }

    let loadedAt = 0;
    const agoText = () => {
      if (!loadedAt) return 'Chargement…';
      const m = Math.round((Date.now() - loadedAt) / 60000);
      return m < 1 ? 'Mis à jour à l\'instant' : m === 1 ? 'Mis à jour il y a 1 minute' : `Mis à jour il y a ${m} minutes`;
    };
    setInterval(() => { $('cb-ago').textContent = agoText(); }, 30000);
    $('refresh').addEventListener('click', async () => {
      const b = $('refresh') as HTMLButtonElement;
      if (b.classList.contains('loading')) return;
      b.classList.add('loading');
      b.querySelector('.rb-label')!.textContent = 'Actualisation…';
      await main(true);
      b.classList.remove('loading');
      b.querySelector('.rb-label')!.textContent = 'Actualiser les cours';
      b.classList.add('done');
      setTimeout(() => b.classList.remove('done'), 1600);
    });
    $('cp-index').addEventListener('click', () => { chartState = { kind: 'index' }; renderChart(); });

    async function main(force = false) {
      let market;
      try {
        market = await loadMarket(force);
      } catch {
        market = null;
      }
      if (!market || !market.quotes.length) {
        $('state').replaceChildren(el('div', { class: 'status' }, ['Impossible de charger les cours pour le moment. Réessaie dans un instant.']));
        return;
      }
      quotes = market.quotes;
      $('state').replaceChildren();
      if (market.index) {
        $('index-value').textContent = market.index.value.toFixed(1).replace('.', ',');
        const i7 = $('index-7');
        i7.textContent = formatChange(market.index.change7);
        i7.className = `big-chg ${changeClass(market.index.change7)}`;
        const withHist = quotes.filter((q) => q.avg30);
        const s = (f: (q: Quote) => number | undefined) => withHist.reduce((t, q) => t + (f(q) ?? q.price), 0);
        const base = s((q) => q.avg30);
        const pts = [base, s((q) => q.avg7), s((q) => q.price)].map((v) => (v / base) * 100);
        $('index-chart').replaceChildren(sparkline(pts, 320, 70));
        // Relevé quotidien de l'indice : remplace les trois repères dès qu'il y a assez de jours.
        indexSeries().then((hs) => { if (hs.length >= 4) { $('index-chart').replaceChildren(sparkline(hs.slice(-90).map((p) => p.price), 320, 70)); $('index-chart').title = `Indice relevé chaque matin depuis ${hs.length} jours`; } });
      }
      const updated = quotes.map((q) => q.updated).filter(Boolean).sort().pop();
      const multi = quotes.filter((q) => q.sources).length;
      const age = updated ? priceAgeText(updated) : null;
      if (updated) $('live-text').textContent = `Cotes du ${formatDate(updated)}`;
      if (multi) $('cb-date').textContent = `Cotes multi-sources (Cardmarket et TCGplayer) pour ${multi} cartes${market.daily ? ' · relevé du jour' : ''}${age ? ` · ${age.text}` : ''}`;
      else if (updated && age) $('cb-date').textContent = `Cotes Cardmarket du ${formatDate(updated)} · ${age.text}`;
      loadedAt = market.loadedAt;
      $('cb-ago').textContent = agoText();

      $('ticker-slot').replaceChildren(ticker(quotes.filter((q) => q.change7 !== undefined), href, eur));

      const byChg = quotes.filter((q) => q.change7 !== undefined).sort((a, b) => b.change7! - a.change7!);
      moverList($('gainers'), byChg.filter((q) => q.change7! > 0).slice(0, 5), (q) => chg(q.change7));
      moverList($('losers'), byChg.filter((q) => q.change7! < 0).reverse().slice(0, 5), (q) => chg(q.change7));
      moverList($('top'), [...quotes].sort((a, b) => b.price - a.price).slice(0, 5), (q) => el('span', { class: 'mv-price' }, [eur(q.price)]));
      for (const id of ['gainers', 'losers']) {
        if (!$(id).children.length) $(id).replaceChildren(el('li', { class: 'muted small' }, ['Rien à signaler cette semaine.']));
      }
      $('movers').hidden = false;
      renderStats();
      $('chart-panel').hidden = false;
      renderChart();
      renderHeat();
      $('board').hidden = false;
      renderBoard();
      renderPortfolio();
    }

    document.querySelectorAll<HTMLButtonElement>('[data-group]').forEach((b) =>
      b.addEventListener('click', () => {
        group = b.dataset.group as typeof group;
        document.querySelectorAll('[data-group]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        shown = PAGE;
        renderBoard();
      }),
    );
    $('sort').addEventListener('change', () => { shown = PAGE; renderBoard(); });
    $('board-q').addEventListener('input', () => { shown = PAGE; renderBoard(); });
    $('more-rows').addEventListener('click', () => { shown += PAGE; renderBoard(); });
    main();
  </script>

  <style>

    /* Barre de contrôle (toujours visible) */
    .control-bar {
      position: sticky; top: 64px; z-index: 12;
      display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap;
      margin: 0 0 18px; padding: 10px 10px 10px 18px; border-radius: 999px;
      background: rgba(14, 12, 26, 0.88); border: 1px solid rgba(62, 240, 255, 0.28);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    }
    @media (max-width: 720px) { .control-bar { top: 54px; border-radius: 20px; padding: 10px; } }
    .cb-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .cb-live { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 0.92rem; }
    .cb-ago { color: var(--muted); font-size: 0.8rem; padding-left: 16px; }
    .refresh-btn {
