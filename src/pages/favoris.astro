---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Mes favoris" active="favorites" description="Les cartes que tu suis : cours, hausse ou baisse, performance depuis que tu les as ajoutées.">
  <section class="fv-head">
    <div>
      <p class="eyebrow">Ma liste de suivi</p>
      <h1>Mes <span class="holo-text">favoris</span></h1>
      <p class="muted">Les cartes que tu surveilles : leur cours, si elles montent ou descendent, et leur évolution depuis que tu les as ajoutées.</p>
    </div>
    <div class="fv-stats" id="stats" hidden>
      <div class="stat">
        <span class="stat-label">Cartes suivies</span>
        <span class="stat-value" id="st-count">0</span>
      </div>
      <div class="stat">
        <span class="stat-label">Valeur (1 de chaque)</span>
        <span class="stat-value" id="st-value">—</span>
      </div>
      <div class="stat">
        <span class="stat-label">Depuis l'ajout</span>
        <span class="stat-value" id="st-since">—</span>
      </div>
      <div class="stat">
        <span class="stat-label">Tendance 7 j</span>
        <span class="stat-value" id="st-7">—</span>
      </div>
    </div>
  </section>

  <div class="fv-bar" id="bar" hidden>
    <div class="chips" role="group" aria-label="Filtrer">
      <button type="button" data-f="all" aria-pressed="true">Toutes</button>
      <button type="button" data-f="up" aria-pressed="false">▲ En hausse</button>
      <button type="button" data-f="down" aria-pressed="false">▼ En baisse</button>
    </div>
    <label class="sr-only" for="sort">Trier</label>
    <select id="sort">
      <option value="since">Depuis l'ajout</option>
      <option value="change7">Variation 7 j</option>
      <option value="price">Cours</option>
      <option value="recent">Ajout récent</option>
      <option value="name">Nom</option>
    </select>
  </div>

  <div id="list" class="fv-list" aria-live="polite"></div>
  <p id="no-match" class="muted" hidden>Aucune carte ne correspond à ce filtre.</p>

  <div id="empty" class="empty" hidden>
    <div class="empty-star" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>
    </div>
    <h2>Aucun favori pour l'instant</h2>
    <p class="muted">Touche l'étoile sur une carte (dans la recherche, sur sa fiche ou au Marché) pour suivre son cours ici.</p>
    <div class="empty-actions">
      <a class="btn btn-primary" href={`${base}/marche/`}>Parcourir le marché</a>
      <a class="btn" href={`${base}/recherche/`}>Chercher une carte</a>
    </div>
  </div>

  <p class="notice">
    Cours = cote HoloCote (médiane des repères Cardmarket, version normale, toutes langues et tous états confondus). « Depuis l'ajout » compare le cours actuel à celui du jour où tu as ajouté la carte.
    Variation 7 j = moyenne des 7 derniers jours comparée à celle des 30 jours. Ce n'est pas un conseil d'investissement.
  </p>

  <script>
    import { getFavorites, removeFavorite, onFavoritesChange, type Favorite } from '../lib/favorites';
    import { getCard, priceFor, formatPrice, formatDate } from '../lib/tcgdex';
    import { toQuote, sparkline, formatChange, changeClass, type Quote } from '../lib/market';
    import { el, url, toast } from '../lib/ui';

    interface Row {
      fav: Favorite;
      price?: number;
      unit?: 'EUR' | 'USD';
      quote?: Quote | null;
      since?: number;
      loaded: boolean;
    }

    const $ = (id: string) => document.getElementById(id)!;
    const rows = new Map<string, Row>();
    const key = (f: Pick<Favorite, 'cardId' | 'lang'>) => `${f.lang}:${f.cardId}`;
    let filter: 'all' | 'up' | 'down' = 'all';

    const fmt = (v: number, u: 'EUR' | 'USD' = 'EUR') => formatPrice(v, u);
    const chgEl = (v?: number, prefix = '') => el('span', { class: `pill ${changeClass(v)}` }, [`${prefix}${v === undefined ? '—' : (v > 0 ? '▲ ' : v < 0 ? '▼ ' : '') + formatChange(v)}`]);

    function trendOf(r: Row) { return r.quote?.change7 ?? r.since; }

    function render() {
      const favs = getFavorites();
      $('empty').hidden = favs.length > 0;
      $('stats').hidden = $('bar').hidden = favs.length === 0;
      for (const f of favs) if (!rows.has(key(f))) rows.set(key(f), { fav: f, loaded: false });
      for (const k of [...rows.keys()]) if (!favs.some((f) => key(f) === k)) rows.delete(k);

      let list = favs.map((f) => rows.get(key(f))!);
      list = list.filter((r) => filter === 'all' || (filter === 'up' ? (trendOf(r) ?? 0) > 0 : (trendOf(r) ?? 0) < 0));
      const sort = ($('sort') as HTMLSelectElement).value;
      list.sort((a, b) =>
        sort === 'name' ? a.fav.name.localeCompare(b.fav.name, 'fr')
        : sort === 'recent' ? b.fav.addedAt - a.fav.addedAt
        : sort === 'price' ? (b.price ?? -1) - (a.price ?? -1)
        : sort === 'change7' ? (b.quote?.change7 ?? -1e9) - (a.quote?.change7 ?? -1e9)
        : (b.since ?? -1e9) - (a.since ?? -1e9));
      $('no-match').hidden = !(favs.length && !list.length);
      $('list').replaceChildren(...list.map(rowEl));
      renderStats(favs.map((f) => rows.get(key(f))!));
    }

    function rowEl(r: Row): HTMLElement {
      const f = r.fav;
      const href = url(`/carte/?id=${encodeURIComponent(f.cardId)}&lang=${f.lang}`);
      const thumb = el('a', { class: 'fv-thumb', href, 'aria-hidden': 'true', tabindex: '-1' });
      if (f.image) thumb.append(el('img', { src: `${f.image}/low.webp`, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' }));
      const hot = (r.quote?.change7 ?? 0) >= 10;
      const remove = el('button', { type: 'button', class: 'fav-btn', 'aria-pressed': 'true', 'aria-label': `Retirer ${f.name} des favoris`, title: 'Retirer des favoris' });
      remove.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/></svg>';
      remove.addEventListener('click', () => { removeFavorite(f.cardId, f.lang); toast(`${f.name} retirée des favoris`); });
      return el('article', { class: `fv-row ${hot ? 'hot' : ''}` }, [
        thumb,
        el('div', { class: 'fv-main' }, [
          el('a', { class: 'fv-name', href }, [f.name]),
          el('span', { class: 'fv-sub' }, [[f.setName, f.lang.toUpperCase(), `suivie depuis le ${formatDate(new Date(f.addedAt).toISOString())}`].filter(Boolean).join(' · ')]),
          el('div', { class: 'fv-pills' }, [
            chgEl(r.quote?.change7, '7 j '),
            r.since !== undefined ? chgEl(r.since, 'Depuis l\'ajout ') : null,
            hot ? el('span', { class: 'pill hot-pill' }, ['En forte hausse']) : null,
          ]),
        ]),
        el('div', { class: 'fv-chart' }, [r.quote ? sparkline(r.quote.points, 120, 40) : null]),
        el('div', { class: 'fv-price' }, [
          el('span', { class: 'fv-now' }, [!r.loaded ? '…' : r.price !== undefined ? fmt(r.price, r.unit) : 'Sans cote']),
          f.priceAtAdd ? el('span', { class: 'fv-was' }, [`ajoutée à ${fmt(f.priceAtAdd, f.unit)}`]) : null,
        ]),
        remove,
      ]);
    }

    function renderStats(all: Row[]) {
      $('st-count').textContent = String(all.length);
      const eur = all.filter((r) => r.unit === 'EUR' && r.price !== undefined);
      const total = eur.reduce((s, r) => s + r.price!, 0);
      $('st-value').textContent = eur.length ? fmt(total) : '—';
      const withAdd = eur.filter((r) => r.fav.priceAtAdd && r.fav.unit === 'EUR');
      const nowA = withAdd.reduce((s, r) => s + r.price!, 0), thenA = withAdd.reduce((s, r) => s + r.fav.priceAtAdd!, 0);
      const since = thenA ? ((nowA - thenA) / thenA) * 100 : undefined;
      const sEl = $('st-since'); sEl.textContent = formatChange(since); sEl.className = `stat-value ${changeClass(since)}`;
      const q = all.map((r) => r.quote).filter((x): x is Quote => !!x && !!x.avg7 && !!x.avg30);
      const s7 = q.reduce((s, x) => s + x.avg7!, 0), s30 = q.reduce((s, x) => s + x.avg30!, 0);
      const c7 = s30 ? ((s7 - s30) / s30) * 100 : undefined;
      const cEl = $('st-7'); cEl.textContent = formatChange(c7); cEl.className = `stat-value ${changeClass(c7)}`;
    }

    async function loadPrices() {
      const todo = [...rows.values()].filter((r) => !r.loaded);
      let i = 0;
      await Promise.all(Array.from({ length: 6 }, async () => {
        while (i < todo.length) {
          const r = todo[i++];
          const card = await getCard(r.fav.cardId, r.fav.lang).catch(() => null);
          if (card) {
            r.quote = toQuote(card, r.fav.lang, 'legend');
            const p = priceFor(card, 'normal');
            if (p) { r.price = p.value; r.unit = p.unit; }
            if (r.price !== undefined && r.fav.priceAtAdd && r.fav.unit === r.unit) {
              r.since = ((r.price - r.fav.priceAtAdd) / r.fav.priceAtAdd) * 100;
            }
          }
          r.loaded = true;
        }
      }));
      render();
    }

    document.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b) => b.addEventListener('click', () => {
      filter = b.dataset.f as typeof filter;
      document.querySelectorAll('[data-f]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }));
    $('sort').addEventListener('change', render);
    onFavoritesChange(() => { render(); loadPrices(); });

    render();
    loadPrices();
  </script>

  <style>
    .eyebrow { text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.75rem; color: var(--gold); margin: 0 0 6px; font-weight: 700; }
    .fv-head { display: grid; gap: 22px; grid-template-columns: 1fr; padding: 20px 0 22px; align-items: end; }
    @media (min-width: 960px) { .fv-head { grid-template-columns: 1fr 520px; } }
    .fv-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
    @media (min-width: 640px) { .fv-stats { grid-template-columns: repeat(4, 1fr); } }
    .stat { display: flex; flex-direction: column; gap: 2px; padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; min-width: 0; }
    .stat-label { font-size: 0.68rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
    .stat-value { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .fv-bar { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
    .fv-bar select { width: auto; }
    .chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .chips button { border: 1px solid var(--line); background: var(--surface); color: var(--muted); padding: 8px 14px; border-radius: 999px; cursor: pointer; font-weight: 600; font-size: 0.85rem; }
    .chips button[aria-pressed='true'] { color: #0a0812; background: var(--holo); border-color: transparent; }

    .fv-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
    .fv-list :global(.fv-row) {
      display: grid; grid-template-columns: 56px 1fr auto auto; gap: 14px; align-items: center;
      padding: 12px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line);
      transition: border-color 0.2s;
    }
    .fv-list :global(.fv-row:hover) { border-color: rgba(255, 255, 255, 0.2); }
    .fv-list :global(.fv-row.hot) { border-color: rgba(61, 255, 168, 0.4); box-shadow: 0 0 24px rgba(61, 255, 168, 0.08); }
    @media (min-width: 760px) { .fv-list :global(.fv-row) { grid-template-columns: 64px 1fr 130px 130px auto; } }
    .fv-list :global(.fv-thumb) { width: 100%; aspect-ratio: 245 / 342; border-radius: 4px; overflow: hidden; background: var(--bg-2); display: block; }
    .fv-list :global(.fv-thumb img) { width: 100%; height: 100%; object-fit: cover; }
    .fv-list :global(.fv-main) { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .fv-list :global(.fv-name) { font-weight: 700; color: var(--text); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fv-list :global(.fv-name:hover) { text-decoration: underline; }
    .fv-list :global(.fv-sub) { font-size: 0.75rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fv-list :global(.fv-pills) { display: flex; gap: 6px; flex-wrap: wrap; }
    .fv-list :global(.pill) { font-size: 0.75rem; font-weight: 700; padding: 3px 8px; border-radius: 999px; background: var(--bg-2); border: 1px solid var(--line); font-variant-numeric: tabular-nums; }
    .fv-list :global(.hot-pill) { color: #0a0812; background: var(--up); border-color: transparent; }
    .fv-list :global(.fv-chart) { display: none; }
    @media (min-width: 760px) { .fv-list :global(.fv-chart) { display: flex; justify-content: center; } }
    .fv-list :global(.fv-price) { display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
    .fv-list :global(.fv-now) { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; font-variant-numeric: tabular-nums; }
    .fv-list :global(.fv-was) { font-size: 0.72rem; color: var(--muted); }
    @media (max-width: 759px) {
      .fv-list :global(.fv-row) { grid-template-columns: 52px 1fr auto; }
      .fv-list :global(.fv-row > .fav-btn) { grid-column: 3; grid-row: 1; align-self: start; }
      .fv-list :global(.fv-price) { grid-column: 2 / 4; flex-direction: row; justify-content: space-between; align-items: baseline; }
    }

    .empty { text-align: center; padding: 48px 20px; border: 1px dashed rgba(255, 255, 255, 0.15); border-radius: 22px; margin-bottom: 24px; }
    .empty-star { width: 84px; height: 84px; margin: 0 auto 16px; border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle, rgba(255, 210, 90, 0.25), transparent 70%); }
    .empty-star svg { width: 48px; height: 48px; fill: var(--gold); filter: drop-shadow(0 0 16px rgba(255, 210, 90, 0.6)); animation: twinkle 3s ease-in-out infinite; }
    @keyframes twinkle { 50% { transform: scale(1.12) rotate(8deg); } }
    .empty-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  </style>
</Base>
