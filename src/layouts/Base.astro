---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'search' | 'market' | 'scanner' | 'favorites' | 'collection' | 'legal';
}
const { title, description = 'Cote et rareté de tes cartes à collectionner, scanner gratuit et collection privée.', active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title === 'HoloCote' ? 'HoloCote — la cote de tes cartes' : `${title} · HoloCote`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07060d" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <a class="sr-only" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="bar">
        <a class="logo" href={`${base}/`} aria-label="HoloCote, accueil">
          <span class="logo-mark" aria-hidden="true"></span>
          <span class="holo-text">HoloCote</span>
        </a>
        <nav aria-label="Navigation principale">
          <a href={`${base}/`} aria-current={active === 'home' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-7 9 7M5 10v10h5v-6h4v6h5V10" /></svg><span class="lbl">Accueil</span>
          </a>
          <a href={`${base}/recherche/`} aria-current={active === 'search' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg><span class="lbl">Recherche</span>
          </a>
          <a href={`${base}/marche/`} aria-current={active === 'market' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8M15 7h6v6" /></svg><span class="lbl">Marché</span>
          </a>
          <a href={`${base}/scanner/`} aria-current={active === 'scanner' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16" /></svg><span class="lbl">Scanner</span>
          </a>
          <a href={`${base}/favoris/`} aria-current={active === 'favorites' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg><span class="lbl">Favoris</span>
            <span class="count fav-count" id="fav-count" hidden></span>
            <span class="alert-dot" id="alert-dot" hidden title="Alerte de prix"></span>
          </a>
          <a href={`${base}/collection/`} aria-current={active === 'collection' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="12" height="17" rx="2" /><path d="M8 7h4M19 6v13a2 2 0 0 1-2 2H9" /></svg><span class="lbl">Collection</span>
            <span class="count" id="nav-count" hidden></span>
          </a>
        </nav>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <aside class="alert-banner" id="alert-banner" hidden aria-live="polite">
      <span class="ab-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21h4" /></svg></span>
      <span class="ab-text" id="alert-text"></span>
      <a class="btn btn-primary ab-go" href={`${base}/favoris/#alertes`}>Voir</a>
      <button type="button" class="ab-close" id="alert-close" aria-label="Masquer l'alerte">✕</button>
    </aside>

    <footer class="site-footer">
      <p>
        HoloCote est un site de fan indépendant et non officiel. Il n'est ni affilié, ni approuvé, ni sponsorisé par
        Nintendo, Creatures Inc., GAME FREAK inc. ou The Pokémon Company. Pokémon et les noms associés sont des marques de
        leurs détenteurs respectifs. Les cotes sont des estimations indicatives : ni offre d'achat, ni garantie de valeur,
        ni conseil d'investissement.
      </p>
      <p class="links">
        <a href={`${base}/mentions-legales/`}>Mentions légales</a>
        <a href={`${base}/confidentialite/`}>Confidentialité</a>
        <span>Données : <a href="https://tcgdex.dev" rel="noopener">TCGdex</a></span>
      </p>
    </footer>

    <script>
      import { countCards } from '../lib/collection';
      import { countFavorites, onFavoritesChange } from '../lib/favorites';
      import { checkAlerts, currentAlerts, onAlertsChange } from '../lib/alerts';
      const favBadge = document.getElementById('fav-count');
      const refreshFav = () => {
        const n = countFavorites();
        if (favBadge) { favBadge.hidden = n === 0; favBadge.textContent = String(n); }
      };
      refreshFav();
      onFavoritesChange(refreshFav);

      // Alertes de prix des favoris (vérifiées au plus toutes les 3 h, sur le site uniquement).
      const banner = document.getElementById('alert-banner')!;
      const dot = document.getElementById('alert-dot')!;
      const onFavPage = location.pathname.replace(/\/$/, '').endsWith('/favoris');
      const showAlerts = () => {
        const alerts = currentAlerts();
        dot.hidden = alerts.length === 0;
        let dismissed = false;
        try { dismissed = sessionStorage.getItem('holocote.alerts.dismissed') === '1'; } catch { /* rien */ }
        if (!alerts.length || onFavPage || dismissed) { banner.hidden = true; return; }
        const a = alerts[0];
        const sign = a.pct > 0 ? '▲ +' : '▼ ';
        const more = alerts.length > 1 ? ` et ${alerts.length - 1} autre${alerts.length > 2 ? 's' : ''}` : '';
        document.getElementById('alert-text')!.textContent = `${a.name} : ${sign}${a.pct.toFixed(0)} %${more} depuis ta dernière alerte`;
        banner.dataset.dir = a.pct > 0 ? 'up' : 'down';
        banner.hidden = false;
      };
      document.getElementById('alert-close')!.addEventListener('click', () => {
        try { sessionStorage.setItem('holocote.alerts.dismissed', '1'); } catch { /* rien */ }
        banner.hidden = true;
      });
      onAlertsChange(showAlerts);
      onFavoritesChange(showAlerts);
      showAlerts();
      const idle = (window as unknown as { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1500));
      if (countFavorites()) idle(() => { checkAlerts().catch(() => {}); });
      const badge = document.getElementById('nav-count');
      const refresh = () => {
        const n = countCards();
        if (badge) {
          badge.hidden = n === 0;
          badge.textContent = String(n);
        }
      };
      refresh();
      window.addEventListener('holocote:collection', refresh);
      window.addEventListener('storage', refresh);
    </script>

    <style>
      .site-header {
        position: sticky; top: 0; z-index: 20;
        background: rgba(7, 6, 13, 0.75);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
      }
      .bar {
        max-width: 1180px; margin: 0 auto; padding: 10px 16px;
        display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
      }
      .logo {
        display: inline-flex; align-items: center; gap: 10px; text-decoration: none;
        font-family: var(--font-display); font-weight: 700; font-size: 1.25rem;
      }
      .logo-mark {
        width: 22px; height: 30px; border-radius: 4px; background: var(--holo); background-size: 200% 100%;
        animation: shimmer 6s linear infinite; transform: rotate(-8deg);
        box-shadow: 0 0 16px rgba(255, 79, 216, 0.5);
      }
      nav { display: flex; gap: 2px; }
      nav a {
        position: relative;
        color: var(--muted); text-decoration: none; padding: 8px 11px; border-radius: 10px; font-weight: 600; font-size: 0.92rem;
        display: inline-flex; align-items: center; gap: 6px;
      }
      nav svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 18px; }
      @media (min-width: 721px) and (max-width: 1080px) { nav svg { display: none; } nav a { padding: 8px 9px; } }
      nav a:hover { color: var(--text); background: var(--surface); }
      nav a[aria-current='page'] { color: var(--text); background: var(--surface-2); }
      .count {
        min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; font-size: 0.75rem;
        display: inline-grid; place-items: center; background: var(--magenta); color: #0a0812;
      }
      .site-footer {
        border-top: 1px solid var(--line);
        padding: 24px 16px 32px; color: var(--muted); font-size: 0.8rem;
      }
      .site-footer p { max-width: 1180px; margin: 0 auto 10px; }
      .links { display: flex; gap: 18px; flex-wrap: wrap; }
      .links a { color: var(--muted); }
      .fav-count { background: var(--gold); }
      .alert-dot {
        width: 9px; height: 9px; border-radius: 50%; background: var(--down);
        box-shadow: 0 0 0 2px var(--bg), 0 0 10px var(--down);
      }
      .alert-banner {
        position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); z-index: 40;
        display: flex; align-items: center; gap: 12px; width: min(560px, calc(100vw - 24px));
        padding: 10px 10px 10px 14px; border-radius: 16px;
        background: rgba(14, 12, 26, 0.95); border: 1px solid var(--line);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        animation: rise 0.35s ease-out;
      }
      .alert-banner[data-dir='up'] { border-color: rgba(61, 255, 168, 0.5); }
      .alert-banner[data-dir='down'] { border-color: rgba(255, 90, 122, 0.5); }
      @keyframes rise { from { transform: translate(-50%, 20px); opacity: 0; } }
      .ab-icon { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: var(--gold); flex: 0 0 34px; }
      .ab-icon svg { width: 18px; height: 18px; fill: none; stroke: #0a0812; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .ab-text { flex: 1; font-weight: 600; font-size: 0.9rem; line-height: 1.3; }
      .ab-go { min-height: 38px; padding: 0 14px; }
      .ab-close { width: 34px; height: 34px; border: 0; background: none; color: var(--muted); cursor: pointer; font-size: 1rem; }

      /* Téléphone : barre d'onglets en bas de l'écran, comme une appli */
      @media (max-width: 720px) {
        /* backdrop-filter sur l'en-tête piégerait la barre « fixed » : on le retire sur téléphone */
        .site-header { backdrop-filter: none; -webkit-backdrop-filter: none; background: rgba(7, 6, 13, 0.96); }
        .bar { justify-content: center; padding: 8px; }
        nav {
          position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
          display: grid; grid-template-columns: repeat(6, 1fr); gap: 0;
          padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
          background: rgba(10, 9, 18, 0.94); border-top: 1px solid var(--line);
          backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        nav a { flex-direction: column; gap: 3px; padding: 6px 2px; font-size: 0.66rem; border-radius: 10px; }
        nav svg { width: 22px; height: 22px; }
        nav a[aria-current='page'] { color: var(--cyan); background: transparent; }
        nav .count { position: absolute; top: 0; left: calc(50% + 6px); min-width: 16px; height: 16px; font-size: 0.62rem; padding: 0 4px; }
        nav .alert-dot { position: absolute; top: 4px; right: calc(50% + 8px); }
        :global(body) { padding-bottom: calc(68px + env(safe-area-inset-bottom)); }
        .alert-banner { bottom: calc(80px + env(safe-area-inset-bottom)); }
        :global(.toast) { bottom: calc(84px + env(safe-area-inset-bottom)) !important; }
      }
    </style>
  </body>
</html>
