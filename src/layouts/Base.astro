---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  active?: 'home' | 'search' | 'market' | 'scanner' | 'favorites' | 'ranking' | 'collection' | 'mystery' | 'deals' | 'account' | 'legal';
}
const { title, description = 'Cote et rareté de tes cartes Pokémon, scanner gratuit, marché du jour et collection privée. Site de fan non officiel.', active, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Onglets. « extra » : rangés dans le menu « Plus » de la barre du bas sur téléphone.
const NAV = [
  { key: 'home', href: '/', label: 'Accueil', icon: '<path d="M3 11l9-7 9 7M5 10v10h5v-6h4v6h5V10" />' },
  { key: 'search', href: '/recherche/', label: 'Recherche', icon: '<circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />' },
  { key: 'market', href: '/marche/', label: 'Marché', icon: '<path d="M3 17l6-6 4 4 8-8M15 7h6v6" />' },
  { key: 'deals', href: '/opportunites/', label: 'Opportunités', icon: '<circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="1" />', extra: true },
  { key: 'scanner', href: '/scanner/', label: 'Scanner', icon: '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16" />' },
  { key: 'collection', href: '/collection/', label: 'Collection', icon: '<rect x="4" y="3" width="12" height="17" rx="2" /><path d="M8 7h4M19 6v13a2 2 0 0 1-2 2H9" />', badge: 'nav-count' },
  { key: 'favorites', href: '/favoris/', label: 'Favoris', icon: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />', badge: 'fav-count', extra: true },
  { key: 'ranking', href: '/classement/', label: 'Classement', icon: '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3" />', extra: true },
  { key: 'account', href: '/compte/', label: 'Compte', icon: '<circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />', badge: 'acc-count', extra: true },
  { key: 'mystery', href: '/defi/', label: 'Défi', icon: '<rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9.8 9.6a2.3 2.3 0 1 1 3.3 2.1c-.7.4-1.1.9-1.1 1.6v.4M12 16.8v.01" />', extra: true },
] as const;
const extraActive = NAV.some((n) => 'extra' in n && n.extra && n.key === active);
const fullTitle = title === 'HoloCote' ? 'HoloCote — la cote de tes cartes Pokémon' : `${title} · HoloCote`;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/').replace(/\/index\.html\/$/, '/'), Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!/\/carte\/?$/.test(Astro.url.pathname) && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HoloCote" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HoloCote, la cote de tes cartes Pokémon" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#07060d" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <a class="sr-only skip" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="bar">
        <a class="logo" href={`${base}/`} aria-label="HoloCote, accueil">
          <Logo />
        </a>
        <nav aria-label="Navigation principale">
          {NAV.map((n) => (
            <a href={`${base}${n.href}`} class={'extra' in n && n.extra ? 'x' : undefined} aria-current={active === n.key ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={n.icon} /><span class="lbl">{n.label}</span>
              {'badge' in n && n.badge && <span class={`count ${n.badge}`} hidden></span>}
              {n.key === 'favorites' && <span class="alert-dot" hidden title="Alerte de prix"></span>}
            </a>
          ))}
          <button type="button" class="more-btn" id="more-btn" aria-expanded="false" aria-controls="more-sheet" aria-current={extraActive ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="19" cy="12" r="1.6" /></svg><span class="lbl">Plus</span>
            <span class="alert-dot" hidden></span>
          </button>
        </nav>
        <div class="more-sheet" id="more-sheet" hidden>
          <p class="ms-title">Plus d'onglets</p>
          <div class="ms-grid">
            {NAV.filter((n) => 'extra' in n && n.extra).map((n) => (
              <a href={`${base}${n.href}`} aria-current={active === n.key ? 'page' : undefined}>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={n.icon} /><span>{n.label}</span>
                {'badge' in n && n.badge && <span class={`count ${n.badge}`} hidden></span>}
                {n.key === 'favorites' && <span class="alert-dot" hidden></span>}
              </a>
            ))}
          </div>
        </div>
        <div class="more-backdrop" id="more-backdrop" hidden></div>
      </div>
    </header>

    <div class="net-banner" id="net-banner" hidden role="status">
      <span id="net-text">La base de cartes TCGdex ne répond pas pour l'instant. Tu vois les dernières données gardées par ton navigateur ; certaines cartes ou cotes peuvent manquer.</span>
      <button type="button" class="net-retry" id="net-retry">Réessayer</button>
      <button type="button" class="ab-close" id="net-close" aria-label="Masquer ce message">✕</button>
    </div>

    <main id="contenu">
      <slot />
    </main>

    <aside class="alert-banner" id="alert-banner" hidden aria-live="polite">
      <span class="ab-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21h4" /></svg></span>
      <span class="ab-text" id="alert-text"></span>
      <a class="btn btn-primary ab-go" href={`${base}/favoris/#alertes`}>Voir</a>
      <button type="button" class="ab-close" id="alert-close" aria-label="Masquer l'alerte">✕</button>
    </aside>

    <footer class="site-footer">
      <p>
        HoloCote est un site de fan indépendant et non officiel. Il n'est ni affilié, ni approuvé, ni sponsorisé par
        Nintendo, Creatures Inc., GAME FREAK inc. ou The Pokémon Company. Pokémon et les noms associés sont des marques de
        leurs détenteurs respectifs. Les cotes sont des estimations indicatives : ni offre d'achat, ni garantie de valeur,
        ni conseil d'investissement.
      </p>
      <p class="links">
        <a href={`${base}/mentions-legales/`}>Mentions légales</a>
        <a href={`${base}/confidentialite/`}>Confidentialité</a>
        <span>Données : <a href="https://tcgdex.dev" rel="noopener">TCGdex</a></span>
      </p>
    </footer>

    <script>
      import { countCards } from '../lib/collection';
      import { countFavorites, onFavoritesChange } from '../lib/favorites';
      import { checkAlerts, currentAlerts, onAlertsChange, alertText } from '../lib/alerts';
      import { newlyUnlocked } from '../lib/badges';
      import { recordVisit, checkQuestsDone, todayQuests, rewardText, pendingRewards } from '../lib/quests';
      import { levelInfo } from '../lib/level';
      import { unlocksAt } from '../lib/avatar';
      import { todayNumber } from '../lib/mystery';
      // TCGdex n'a pas toutes les images en français : si une image FR manque, on essaie la version anglaise.
      document.addEventListener('error', (e) => {
        const img = e.target as HTMLImageElement;
        if (!(img instanceof HTMLImageElement) || img.dataset.fbk) return;
        if (/assets\.tcgdex\.net\/fr\//.test(img.src)) { img.dataset.fbk = '1'; img.src = img.src.replace('/fr/', '/en/'); }
      }, true);
      // Base de cartes injoignable : bandeau discret au lieu de pages vides.
      const net = document.getElementById('net-banner')!;
      const showNet = (offline: boolean) => {
        document.getElementById('net-text')!.textContent = offline
          ? 'Pas de connexion Internet. Tu vois les dernières données gardées par ton navigateur ; ton classeur, tes quêtes et tes succès restent disponibles.'
          : 'La base de cartes TCGdex ne répond pas pour l’instant. Tu vois les dernières données gardées par ton navigateur ; certaines cartes ou cotes peuvent manquer.';
        net.hidden = false;
      };
      window.addEventListener('holocote:offline', () => showNet(!navigator.onLine));
      window.addEventListener('offline', () => showNet(true));
      window.addEventListener('online', () => { net.hidden = true; });
      if (!navigator.onLine || document.documentElement.dataset.apiDown) showNet(!navigator.onLine);
      document.getElementById('net-close')!.addEventListener('click', () => { net.hidden = true; });
      document.getElementById('net-retry')!.addEventListener('click', () => location.reload());
      // Onglet actif visible quand la barre défile (tablette)
      const navEl = document.querySelector<HTMLElement>('header nav');
      const cur = navEl?.querySelector<HTMLElement>('a[aria-current="page"]');
      if (navEl && cur && navEl.scrollWidth > navEl.clientWidth) navEl.scrollLeft = cur.offsetLeft - navEl.clientWidth / 2 + cur.offsetWidth / 2;
      const markOverflow = () => navEl?.classList.toggle('overflow', innerWidth > 720 && navEl.scrollWidth > navEl.clientWidth + 2);
      markOverflow();
      window.addEventListener('resize', markOverflow);
      document.fonts?.ready.then(markOverflow);
      const setBadges = (cls: string, n: number) => document.querySelectorAll<HTMLElement>(`.${cls}`).forEach((b) => { b.hidden = n === 0; b.textContent = String(n); });
      const refreshFav = () => setBadges('fav-count', countFavorites());

      // Menu « Plus » (téléphone)
      const moreBtn = document.getElementById('more-btn')!;
      const sheet = document.getElementById('more-sheet')!;
      const backdrop = document.getElementById('more-backdrop')!;
      const setMore = (open: boolean) => { sheet.hidden = !open; backdrop.hidden = !open; moreBtn.setAttribute('aria-expanded', String(open)); };
      moreBtn.addEventListener('click', () => setMore(sheet.hidden));
      backdrop.addEventListener('click', () => setMore(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMore(false); });
      window.matchMedia('(min-width: 721px)').addEventListener('change', () => setMore(false));
      refreshFav();
      onFavoritesChange(refreshFav);

      // Alertes de prix des favoris (vérifiées au plus toutes les 3 h, sur le site uniquement).
      const banner = document.getElementById('alert-banner')!;
      const dots = document.querySelectorAll<HTMLElement>('.alert-dot');
      const onFavPage = /\/(favoris|opportunites)$/.test(location.pathname.replace(/\/$/, ''));
      const showAlerts = () => {
        const alerts = currentAlerts();
        dots.forEach((d) => { d.hidden = alerts.length === 0; });
        let dismissed = false;
        try { dismissed = sessionStorage.getItem('holocote.alerts.dismissed') === '1'; } catch { /* rien */ }
        if (!alerts.length || onFavPage || dismissed) { banner.hidden = true; return; }
        const a = alerts[0];
        const fmt = (v: number, u: 'EUR' | 'USD') => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: u, maximumFractionDigits: v < 100 ? 2 : 0 }).format(v);
        const more = alerts.length > 1 ? ` (+${alerts.length - 1} autre${alerts.length > 2 ? 's' : ''})` : '';
        document.getElementById('alert-text')!.textContent = alertText(a, fmt) + more;
        banner.dataset.dir = a.kind === 'below' ? 'down' : a.kind === 'above' ? 'up' : a.pct > 0 ? 'up' : 'down';
        banner.hidden = false;
      };
      document.getElementById('alert-close')!.addEventListener('click', () => {
        try { sessionStorage.setItem('holocote.alerts.dismissed', '1'); } catch { /* rien */ }
        banner.hidden = true;
      });
      onAlertsChange(showAlerts);
      onFavoritesChange(showAlerts);
      showAlerts();
      const idle = (window as unknown as { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1500));
      if (countFavorites()) idle(() => { checkAlerts().catch(() => {}); });
      const refresh = () => setBadges('nav-count', countCards());
      refresh();
      window.addEventListener('holocote:collection', refresh);
      window.addEventListener('storage', refresh);

      // Succès débloqués : petite carte en bas de l'écran, à côté des messages habituels.
      const base = (document.querySelector('link[rel="icon"]')?.getAttribute('href') ?? '/').replace(/[^/]*$/, '');
      let badgeTimer: number | undefined;
      const queue: { name: string; hint: string; icon: string; kicker?: string; href?: string }[] = [];
      const popNext = () => {
        const b = queue.shift();
        if (!b) return;
        let pop = document.getElementById('badge-pop') as HTMLAnchorElement | null;
        if (!pop) {
          pop = document.createElement('a');
          pop.id = 'badge-pop';
          pop.className = 'badge-pop';
          pop.setAttribute('role', 'status');
          document.body.append(pop);
        }
        pop.href = b.href ?? `${base}compte/#succes`;
        pop.innerHTML = '<span class="bp-ic"></span><span class="bp-tx"><small></small><strong></strong><em></em></span>';
        pop.querySelector('small')!.textContent = b.kicker ?? 'Succès débloqué';
        pop.querySelector('.bp-ic')!.textContent = b.icon;
        pop.querySelector('strong')!.textContent = b.name;
        pop.querySelector('em')!.textContent = b.hint;
        pop.setAttribute('aria-label', `${b.kicker ?? 'Succès débloqué'} : ${b.name}. ${b.hint}`);
        pop.removeAttribute('tabindex');
        pop.classList.remove('show'); void pop.offsetWidth; pop.classList.add('show');
        window.clearTimeout(badgeTimer);
        badgeTimer = window.setTimeout(() => { pop!.classList.remove('show'); pop!.setAttribute('tabindex', '-1'); setTimeout(popNext, 400); }, 4200);
      };
      let checkT: number | undefined;
      const QSEEN = 'holocote.qseen.v1';
      const LSEEN = 'holocote.level.v1';
      const accBadge = () => setBadges('acc-count', pendingRewards());
      const checkBadges = () => {
        window.clearTimeout(checkT);
        checkT = window.setTimeout(() => {
          const fresh: typeof queue = [];
          checkQuestsDone();
          // Quêtes réussies depuis la dernière vérification
          const day = todayNumber();
          let seen: { day: number; ids: string[] } = { day, ids: [] };
          try { const v = JSON.parse(localStorage.getItem(QSEEN) || 'null'); if (v && v.day === day && Array.isArray(v.ids)) seen = v; } catch { /* rien */ }
          const doneNow = todayQuests().filter((q) => q.done);
          for (const q of doneNow) if (!seen.ids.includes(q.id) && !q.claimed) fresh.push({ icon: 'Q', kicker: 'Quête réussie', name: q.title, hint: `Récupère ta récompense : ${rewardText(q.reward)}`, href: `${base}compte/#quetes` });
          try { localStorage.setItem(QSEEN, JSON.stringify({ day, ids: doneNow.map((q) => q.id) })); } catch { /* rien */ }
          // Passage de niveau
          const lv = levelInfo();
          let last = 0;
          try { last = Number(localStorage.getItem(LSEEN)) || 0; } catch { /* rien */ }
          if (last && lv.level > last) {
            const un = unlocksAt(lv.level);
            fresh.push({ icon: String(lv.level), kicker: 'Niveau supérieur', name: `Niveau ${lv.level} : ${lv.title}`, hint: un.length ? `Débloqué : ${un.join(', ')}` : 'Continue comme ça !', href: `${base}compte/` });
          }
          if (lv.level !== last) { try { localStorage.setItem(LSEEN, String(lv.level)); } catch { /* rien */ } }
          fresh.push(...newlyUnlocked());
          accBadge();
          if (!fresh.length) return;
          const idleNow = !queue.length && !document.querySelector('#badge-pop.show');
          queue.push(...fresh);
          if (idleNow) popNext();
        }, 700);
      };
      checkBadges();
      const cardId = /\/carte\/?$/.test(location.pathname) ? new URLSearchParams(location.search).get('id') : null;
      recordVisit(location.pathname, cardId ?? undefined);
      window.addEventListener('holocote:collection', checkBadges);
      window.addEventListener('holocote:progress', checkBadges);
      onFavoritesChange(checkBadges);
    </script>

    <style>
      .site-header {
        position: sticky; top: 0; z-index: 20;
        background: rgba(7, 6, 13, 0.75);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
      }
      .bar {
        max-width: 1180px; margin: 0 auto; padding: 10px 16px;
        display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
      }
      .logo {
        display: inline-flex; align-items: center; gap: 10px; text-decoration: none;
        font-family: var(--font-display); font-weight: 700; font-size: 1.25rem;
      }
      .logo-mark {
        width: 22px; height: 30px; border-radius: 4px; background: var(--holo); background-size: 200% 100%;
        animation: shimmer 6s linear infinite; transform: rotate(-8deg);
        box-shadow: 0 0 16px rgba(255, 79, 216, 0.5);
      }
      nav { display: flex; gap: 2px; flex-wrap: wrap; }
      .more-btn, .more-sheet, .more-backdrop { display: none; }
      nav a {
        position: relative;
        color: var(--muted); text-decoration: none; padding: 8px 11px; border-radius: 10px; font-weight: 600; font-size: 0.92rem;
        display: inline-flex; align-items: center; gap: 6px;
      }
      nav svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 18px; }
      @media (min-width: 1241px) { nav a { padding: 8px 6px; gap: 5px; font-size: 0.85rem; } nav svg { width: 15px; height: 15px; flex-basis: 15px; } }
      @media (min-width: 721px) and (max-width: 1240px) {
        nav svg { display: none; }
        nav a { padding: 8px 6px; font-size: 0.86rem; }
      }
      @media (min-width: 721px) {
        nav { gap: 0; }
        nav a { flex: 0 0 auto; }
        .bar { flex-wrap: nowrap; }
        .logo { flex: 0 0 auto; }
        /* Une seule ligne d'onglets, qui défile si la fenêtre est étroite */
        nav { flex-wrap: nowrap; overflow-x: auto; min-width: 0; scrollbar-width: none; }
        nav.overflow { -webkit-mask-image: linear-gradient(90deg, #000 90%, transparent); mask-image: linear-gradient(90deg, #000 90%, transparent); }
        nav::-webkit-scrollbar { display: none; }
      }
      nav a:hover { color: var(--text); background: var(--surface); }
      nav a[aria-current='page'] { color: var(--text); background: var(--surface-2); }
      .count {
        min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; font-size: 0.75rem;
        display: inline-grid; place-items: center; background: var(--magenta); color: #0a0812;
      }
      .site-footer {
        border-top: 1px solid var(--line);
        padding: 24px 16px 32px; color: var(--muted); font-size: 0.8rem;
      }
      .site-footer p { max-width: 1180px; margin: 0 auto 10px; }
      .links { display: flex; gap: 18px; flex-wrap: wrap; }
      .links a { color: var(--muted); }
      .fav-count { background: var(--gold); }
      .acc-count { background: var(--up); }
      .alert-dot {
        width: 9px; height: 9px; border-radius: 50%; background: var(--down);
        box-shadow: 0 0 0 2px var(--bg), 0 0 10px var(--down);
      }
      .net-banner {
        display: flex; align-items: center; gap: 12px; max-width: 1180px; margin: 12px auto 0; padding: 10px 12px 10px 16px;
        border-radius: 14px; border: 1px solid rgba(255, 210, 90, 0.5); background: rgba(255, 210, 90, 0.08); font-size: 0.9rem;
      }
      .net-banner[hidden] { display: none; }
      .net-banner span { flex: 1; }
      .net-retry { border: 1px solid var(--line); background: var(--surface); color: var(--text); border-radius: 10px; padding: 6px 12px; font-weight: 700; cursor: pointer; }
      @media (max-width: 1212px) { .net-banner { margin-inline: 16px; } }
      .alert-banner {
        position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); z-index: 40;
        display: flex; align-items: center; gap: 12px; width: min(560px, calc(100vw - 24px));
        padding: 10px 10px 10px 14px; border-radius: 16px;
        background: rgba(14, 12, 26, 0.95); border: 1px solid var(--line);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        animation: rise 0.35s ease-out;
      }
      .alert-banner[data-dir='up'] { border-color: rgba(61, 255, 168, 0.5); }
      .alert-banner[data-dir='down'] { border-color: rgba(255, 90, 122, 0.5); }
      @keyframes rise { from { transform: translate(-50%, 20px); opacity: 0; } }
      .ab-icon { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: var(--gold); flex: 0 0 34px; }
      .ab-icon svg { width: 18px; height: 18px; fill: none; stroke: #0a0812; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .ab-text { flex: 1; font-weight: 600; font-size: 0.9rem; line-height: 1.3; }
      .ab-go { min-height: 38px; padding: 0 14px; }
      .ab-close { width: 34px; height: 34px; border: 0; background: none; color: var(--muted); cursor: pointer; font-size: 1rem; }

      /* Téléphone : barre d'onglets en bas de l'écran, comme une appli */
      @media (max-width: 720px) {
        /* backdrop-filter sur l'en-tête piégerait la barre « fixed » : on le retire sur téléphone */
        .site-header { backdrop-filter: none; -webkit-backdrop-filter: none; background: rgba(7, 6, 13, 0.96); }
        .bar { justify-content: center; padding: 8px; }
        nav {
          position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
          display: grid; grid-template-columns: repeat(6, 1fr); gap: 0;
          padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
          background: rgba(10, 9, 18, 0.94); border-top: 1px solid var(--line);
          backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        nav a.x { display: none; }
